0430\u0439\u043e\u043d\u0430 \u041a\u0430\u043d\u0430\u043b \u0432 \u0427\u0430\u0441\u043e\u0432 \u042f\u0440\u0435 (\u0441) @rybar\n\u0418 \u0432 \u0427\u0430\u0441\u043e\u0432 \u042f\u0440\u0435, \u0412\u043e\u043b\u0447\u0430\u043d\u0441\u043a\u0435, \u043f\u043e\u0434 \u0422\u043e\u0440\u0435\u0446\u043a\u043e\u043c - \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0421\u0442\u0430\u043b\u0438\u043d\u0433\u0440\u0430\u0434. \u0414\u043e\u043c\u0430 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442 \u0438\u0437 \u0440\u0443\u043a \u0432 \u0440\u0443\u043a\u0438 \u043f\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437. \u0412 \u043d\u0435\u0431\u0435 \u0440\u043e\u0438 \u0434\u0440\u043e\u043d\u043e\u0432. \u0441\u043d\u0430\u0440\u044f\u0434\u043e\u0432 \u0438 \u0424\u0410\u0411\u043e\u0432. \u041e\u0433\u043e\u043d\u044c \u0438 \u0434\u044b\u043c \u0441\u0442\u043e\u044f\u0442 \u0441\u0442\u0435\u043d\u043e\u0439. \u041d\u043e \u043d\u0430\u0448\u0438 \u0432\u043e\u0438\u043d\u044b \u043f\u043e\u0431\u0435\u0436\u0434\u0430\u044e\u0442. \u0413\u0440\u043e\u043c\u044f\u0442 \u0438 \u0442\u0435\u0441\u043d\u044f\u0442 \u0432\u0440\u0430\u0433\u0430. \u0422\u0430\u043a, \u0447\u0442\u043e \u043d\u0430 \u0423\u043a\u0440\u0430\u0438\u043d\u0435 \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0430 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u0430\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0435\u0449\u0435 200.000 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0433\u043e\u0434\u0430. \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u0440\u0438\u043b\u0435\u0442\u0435\u043b \u0432 \u0410\u0441\u0442\u0430\u043d\u0443, \u043d\u0430 \u0441\u0430\u043c\u043c\u0438\u0442 \u0428\u041e\u0421. \u0421\u0430\u043c \u0441\u0430\u043c\u043c\u0438\u0442 \u043d\u0430\u0447\u043d\u0435\u0442\u0441\u044f \u0437\u0430\u0432\u0442\u0440\u0430, \u043d\u043e \u0443\u0436\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0448\u0435\u0441\u0442\u044c \u0432\u0441\u0442\u0440\u0435\u0447 \u043d\u0430 \u0432\u044b\u0441\u0448\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0441 \u0420\u0435\u0434\u0436\u0435\u043f\u043e\u043c \u042d\u0440\u0434\u043e\u0433\u0430\u043d\u043e\u043c \u0438 \u0421\u0438 \u0426\u0437\u0438\u043d\u044c\u043f\u0438\u043d\u043e\u043c. \u0418 \u0432\u0430\u0436\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u0438\u043c \u0432\u043e\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u043e\u043f\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u0440\u0430\u0437 \u043d\u0430 \u0443\u0441\u043f\u0435\u0445\u0438 \u043d\u0430\u0448\u0438\u0445 \u0440\u0435\u0431\u044f\u0442 \u043d\u0430 \u0444\u0440\u043e\u043d\u0442\u0435. \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0431\u044b \u043c\u044b \u0432\u043e\u0439\u043d\u0443 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u043b\u0438 - \u0434\u0430\u0436\u0435 \u0442\u0440\u0443\u0431\u043a\u0443 \u0431\u044b \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u043d\u044f\u043b. \u0412 \u0433\u0435\u043e\u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u043d\u0435\u0442 \u0434\u0440\u0443\u0437\u0435\u0439. \u0422\u0430\u043c \u0435\u0441\u0442\u044c \u0433\u0435\u043e\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0438 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u044b. \u0420\u043e\u0441\u0441\u0438\u044f \u0432\u044b\u0441\u0442\u043e\u044f\u043b\u0430 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0442\u044c. \u042d\u0442\u043e \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u044b. \u0418 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b, \u0441\u043e\u044e\u0437\u044b \u0438 \u043f\u0440\u043e\u0447\u0435\u0435. \u0412\u0441\u0435 \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0430\u043d\u043e. \u041f\u043e\u043c\u0438\u043c\u043e \u0440\u0430\u0439\u043e\u043d\u0430 \u041a\u0430\u043d\u0430\u043b \u0432 \u0427\u0430\u0441\u043e\u0432 \u042f\u0440\u0435, \u0433\u043e\u0440\u043b\u043e\u0432\u0441\u043a\u0438\u0435 \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u0446\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043e\u0442\u0431\u0440\u043e\u0441\u0438\u043b\u0438 \u0443\u043a\u0440\u043e\u043d\u0430\u0446\u0438\u0441\u0442\u043e\u0432 \u0434\u043e \u0434\u0432\u0443\u0445 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432 \u043d\u0430 \u0422\u043e\u0440\u0435\u0446\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041d\u0430\u0448\u0438 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0438\u043b\u0438 \u043e\u0431\u043e\u0440\u043e\u043d\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u044e\u0433\u043e-\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u0435\u0435 \u0423\u0433\u043b\u0435\u0434\u0430\u0440\u0430. \u0418 \u0442\u0443\u0442 \u0436\u0435 The Asia Times \u043f\u0438\u0448\u0435\u0442, \u0447\u0442\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u043d\u0430 \u0423\u043a\u0440\u0430\u0438\u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u0441\u044f \u043d\u0435 \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u043d\u044b\u043c \u0441\u043e\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435\u043c, \u0430 \u043a\u0430\u043f\u0438\u0442\u0443\u043b\u044f\u0446\u0438\u0435\u0439 \u0423\u043a\u0440\u0430\u0438\u043d\u044b. \u041d\u0430\u044