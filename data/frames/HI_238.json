930\u093e\u0926\u0942\u0928", "\u0915\u0940", "\u0935\u093e\u0926\u093f\u092f\u093e\u0902", "43", "\u0921\u093f\u0917\u094d\u0930\u0940", "\u0938\u0947\u0932\u094d\u0938\u093f\u092f\u0938", "\u092a\u0930", "\u0924\u092a", "\u0930\u0939\u0940", "\u0939\u0948\u0902", ".", "\u0939\u094b", "\u0938\u0915\u0924\u093e", "\u0939\u0948", "\u092f\u0947", "\u092e\u0939\u0938\u0942\u0938", "\u0939\u094b\u0928\u0947", "\u0935\u093e\u0932\u093e", "\u0939\u0940", "\u0924\u093e\u092a\u092e\u093e\u0928", "\u0939\u094b", ",", "\u0932\u0947\u0915\u093f\u0928", "\u0906\u0917\u0947", "\u0926\u0947\u0916\u0928\u0947", "\u092a\u0930", "\u0939\u093e\u0932\u093e\u0924", "\u0914\u0930", "\u0916\u0924\u0930\u0928\u093e\u0915", "\u0926\u093f\u0916\u0924\u0947", "\u0939\u0948\u0902", "."], "sentence": "'\u0926\u0947\u0916\u093f \u0926\u0941\u092a\u0939\u0930\u0940 \u091c\u0947\u0920 \u0915\u0940, \u091b\u093e\u0901\u0939\u094c\u0902 \u091a\u093e\u0939\u0924\u093f \u091b\u093e\u0901\u0939' - \u0928\u0948\u0928\u0940\u0924\u093e\u0932 \u092e\u0947\u0902 \u092c\u093f\u0915 \u0930\u0939\u0947 \u092a\u0902\u0916\u0947, \u0932\u0948\u0902\u0938\u0921\u093e\u0909\u0928 \u092e\u0947\u0902 \u092d\u0940 \u0930\u093e\u0939\u0924 \u0928\u0939\u0940\u0902\n\n\u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u091a\u0947\u0902\u091c \u0915\u094b \u0932\u0947\u0915\u0930 \u0939\u0930 \u092a\u0949\u0932\u093f\u091f\u0915\u0932 \u092b\u094b\u0930\u092e \u092a\u0930 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0940 \u091a\u0930\u094d\u091a\u093e\u090f\u0902 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0902. \u0905\u092d\u0940 \u092d\u0940 \u0906\u092e \u0906\u0926\u092e\u0940 \u0916\u0941\u0926 \u0915\u094b \u0907\u0938\u0938\u0947 \u091c\u094b\u0921\u093c \u0928\u0939\u0940\u0902 \u092a\u093e \u0930\u0939\u093e \u0939\u0948. \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u092c\u0922\u093c\u0924\u0940 \u0917\u0930\u094d\u092e\u0940 \u0914\u0930 \u092a\u093f\u0918\u0932\u0924\u0947 \u0917\u094d\u0932\u0947\u0936\u093f\u092f\u0930 \u0939\u092e\u0947\u0902 \u0916\u0924\u0930\u0928\u093e\u0915 \u0938\u0902\u0915\u0947\u0924 \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0915\u0935\u093f\u0935\u0930 \u092c\u093f\u0939\u093e\u0930\u0940 \u0932\u093e\u0932 \u0928\u0947 \u091c\u0947\u0920 \u0915\u0940 \u0924\u092a\u0928 \u0915\u093e \u092c\u0939\u0941\u0924 \u0939\u0940 \u0938\u0941\u0902\u0926\u0930 \u0935\u0930\u094d\u0923\u0928 \u0915\u093f\u092f\u093e \u0939\u0948. \u0935\u0939\u0940 \u2018\u0938\u0924\u0938\u0948\u0902\u092f\u093e \u0915\u0947 \u0926\u094b\u0939\u0930\u0947, \u091c\u094d\u092f\u094b\u0902 \u0928\u093e\u0935\u093f\u0915 \u0915\u0947 \u0924\u0940\u0930\u2019 \u0935\u093e\u0932\u0947 \u092c\u093f\u0939\u093e\u0930\u0940. \u0926\u094b \u0932\u093e\u0907\u0928 \u0915\u0947 \u0926\u094b\u0939\u0947 \u092e\u0947\u0902 \u0917\u0930\u094d\u092e\u0940 \u0915\u0947 \u092a\u0942\u0930\u0947 \u0939\u093e\u0932\u093e\u0924 \u0915\u093e \u0928\u0915\u094d\u0936\u093e \u0916\u0940\u0902\u091a \u0926\u093f\u092f\u093e \u0939\u0948. \u092c\u0938, \u0909\u0928\u0915\u0947 \u0907\u0938 \u0926\u094b\u0939\u0947 \u092e\u0947\u0902 \u0928\u093e\u092f\u093f\u0915\u093e, \u0906\u092a \u0939\u093f\u0930\u094b\u0907\u0928 \u0938\u092e\u091d \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0928\u093e\u092f\u0915 \u0938\u0947 \u0915\u0939\u0924\u0940 \u0939\u0948 \u0915\u093f \u091c\u0947\u0920 \u0915\u0940 \u0926\u094b\u092a\u0939\u0930\u0940 \u0910\u0938\u0940 \u0939\u0948 \u0915\u093f \u091b\u093e\u092f\u093e \u092d\u0940 \u091b\u093e\u0902\u0939 \u0916\u094b\u091c\u0928\u0947 \u091a\u0932\u0940 \u0917\u0908 \u0939\u0948. \u092e\u0924\u0932\u092c \u0915\u0939\u0940\u0902 \u0915\u093f\u0938\u0940 \u0915\u0940 \u091b\u093e\u092f\u093e \u0924\u0915 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916 \u0930\u0939\u0940 \u0939\u0948. \u0910\u0938\u0947 \u0939\u093e\u0932\u0924 \u092e\u0947\u0902 \u0918\u0930 \u092e\u0947\u0902 \u0939\u0940 \u0930\u0939\u0928\u093e \u0920\u0940\u0915 \u0939\u094b\u0917\u093e. \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0905\u092c \u0915\u0947 \u0928\u093e\u092f\u0915 \u0910\u0938\u093e \u0915\u0930 \u0928\u0939\u0940\u0902 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0917\u0930\u094d\u092e\u0940 \u0938\u0947 \u0928\u093f\u091c\u093e\u0924 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u0915\u0940 \u0913\u0930 \u0928\u093f\u0915\u0932 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0928\u0924\u0940\u091c\u093e \u092f\u0947 \u0939\u0948 \u0915\u093f \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u092a\u0930 \u092d\u092f\u093e\u0928\u0915 \u091c\u093e\u092e \u0932\u0917 \u091c\u093e \u0930\u0939\u093e \u0939\u0948. \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0935\u0939\u093e\u0902 \u092d\u0940 \u0930\u093e\u0939\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948. \u0935\u0939\u093e\u0902 \u092d\u0940 \u092a\u093e\u0930\u093e \u091a\u0922\u093c\u093e \u0939\u0941\u0906 \u0939\u0948. \u0939\u093f\u092e\u093e\u091a\u0932 \u0914\u0930 \u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921 \u0926\u094b\u0928\u094b \u0930\u093e\u091c\u094d\u092f\u094b\u0902 \u0915\u0940 \u0915\u0908 \u0928\u0926\u093f\u092f\u094b\u0902 \u0915\u093e \u091c\u0932\u0938\u094d\u0924\u0930 \u092c\u0930\u094d\u092b \u092a\u093f\u0918\u0932\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092c\u0922\u093c\u093e \u0939\u0948. \u092f\u0947 \u092c\u0930\u094d\u092b \u0917\u0930\u094d\u092e\u0940 \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u092a\u093f\u0918\u0932\u0940 \u0939\u0948. \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 \u0915\u0940 \u0939\u093e\u0932\u0924\n\u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921 \u0915\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0926\u094d\u0935\u093e\u0930 \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 \u0915\u094b \u0915\u0939\u093e \u0914\u0930 \u092e\u093e\u0928\u093e \u091c\u0