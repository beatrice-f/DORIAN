0440\u0442\u0438\u0442\u0435 \u043d\u0435\u0432\u0435\u0434\u043d\u044a\u0436 \u0441\u0430 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u0432\u0430\u043b\u0438, \u0447\u0435 \u0440\u0443\u0441\u043a\u0438\u044f\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0435 \u043d\u0430\u0441\u043e\u0447\u0438\u043b \u043f\u043e\u0433\u043b\u0435\u0434\u0430 \u0441\u0438 \u043a\u044a\u043c \u043f\u043e\u0432\u0435\u0447\u0435 \u0446\u0435\u043b\u0438 \u0432 \u0431\u0435\u0437\u0443\u043c\u043d\u0430\u0442\u0430 \u0441\u0438 \u043c\u0435\u0447\u0442\u0430 \u0434\u0430 \u0441\u0438 \u0432\u044a\u0440\u043d\u0435 \u0438\u0437\u0433\u0443\u0431\u0435\u043d\u0430\u0442\u0430 \u0438\u043c\u043f\u0435\u0440\u0438\u044f. \u0410 \u0442\u0430\u0437\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0430 \u041f\u0443\u0442\u0438\u043d \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0434\u0438, \u0447\u0435 \u0449\u0435 \u0438\u0437\u043f\u0440\u0430\u0442\u0438 \u043d\u0430 \u0441\u044a\u044e\u0437\u043d\u0438\u0446\u0438\u0442\u0435 \u0441\u0438 \u0440\u0430\u043a\u0435\u0442\u0438 \u0441 \u0434\u0430\u043b\u0435\u0447\u0435\u043d \u043e\u0431\u0441\u0435\u0433 \u0432 \u043e\u0442\u0433\u043e\u0432\u043e\u0440 \u043d\u0430 \u0442\u043e\u0432\u0430, \u0447\u0435 \u0417\u0430\u043f\u0430\u0434\u044a\u0442 \u0438\u0437\u043f\u0440\u0430\u0449\u0430 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043e\u0440\u044a\u0436\u0438\u044f. \u0412 \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0437\u0430 The Sun \u041f\u0435\u0442\u0440\u0435\u044a\u0441 \u0435 \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0435 \u041f\u0443\u0442\u0438\u043d \u0435 \u0431\u0438\u043b \"\u043c\u043d\u043e\u0433\u043e \u044f\u0441\u0435\u043d\" \u043e\u0442\u043d\u043e\u0441\u043d\u043e \u0437\u0430\u043f\u043e\u0447\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043d\u043e\u0432\u0430 \u0432\u043e\u0439\u043d\u0430 \u0432 \u0415\u0432\u0440\u043e\u043f\u0430. \u0421\u0432\u