2\u0430\u0442\u0430 \u043d\u0438. \u0418\u0434\u0432\u0430\u0442\u0435 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u043a\u043e\u044f\u0442\u043e \u0437\u0430 \u043d\u0430\u0441 \u0435 \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u0437\u0430 \u0432\u0430\u0441 \u0435 \u041c\u0435\u043a\u0441\u0438\u043a\u043e. \u0418\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u0442\u0435 \u0442\u0430\u043c \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u043d\u043e \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0430\u0440\u043c\u0438\u044f. \u0418\u0441\u043a\u0430\u0442\u0435 \u0434\u0430 \u0440\u0430\u0437\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u0442\u0430\u043c \u0440\u0430\u043a\u0435\u0442\u0438. \u0418 \u043c\u0438\u0441\u043b\u0438\u0442\u0435, \u0447\u0435 \u043d\u0438\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u043c \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u043c \u043d\u0435\u0449\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0441 \u0432\u0430\u0441? \u0413\u0440\u0435\u0448\u0438\u0442\u0435!\u201c. \u041f\u0440\u0438\u043f\u043e\u043c\u043d\u044f\u043c\u0435, \u0447\u0435 \u043c\u043d\u043e\u0433\u043e \u0435\u043a\u0441\u043f\u0435\u0440\u0442\u0438 \u043d\u0435\u043f\u0440\u0435\u043a\u044a\u0441\u043d\u0430\u0442\u043e \u043e\u0431\u044f\u0441\u043d\u044f\u0432\u0430\u0442 \u043a\u0430\u043a\u0432\u0438 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0435\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u044f \u043d\u0430 \u043d\u0430\u043f\u0440\u0435\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u0438\u043c\u0430 \u0420\u0443\u0441\u043a\u0430\u0442\u0430 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f. \u0422\u0435 \u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043f\u043e\u0432\u0442\u0430\u0440\u044f\u0442, \u0447\u0435 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0431\u044a\u0434\u0430\u0442 \u0440\u0430\u0437\u04