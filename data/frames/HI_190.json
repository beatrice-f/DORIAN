\u0930\u0940 \u092f\u0930\u092e\u0948\u0915 \u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u094b \u0932\u0947\u0915\u0930 \u092c\u0940\u0924\u0947 \u0926\u093f\u0928\u094b\u0902 \u092c\u0921\u093c\u093e \u092c\u092f\u093e\u0928 \u0926\u093f\u092f\u093e \u0925\u093e\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0936\u093e\u0902\u0924\u093f \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0939\u092e \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0930\u0947\u0902\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0907\u0938 \u0939\u092b\u094d\u0924\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947, \u092d\u093e\u0930\u0924 \u0928\u0947 \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u092e\u0927\u094d\u092f\u0938\u094d\u0925 \u0915\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0915\u0939\u093e \u0917\u092f\u093e \u0915\u093f \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0939\u092e \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u093e\u0932\u0942\u092e \u0939\u0