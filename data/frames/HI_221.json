0924\u092c\u093e\u0939 \u0915\u0930\u0928\u0947 \u0915\u093e \u092c\u0921\u093c\u093e \u092a\u094d\u0932\u093e\u0928 \u092c\u0928\u093e \u0932\u093f\u092f\u093e \u0939\u0948\u0964\n\u090f\u091c\u0947\u0902\u0938\u0940, \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940\u0964 Russia Ukraine war \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0926\u094b \u0938\u093e\u0932 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u094b \u0917\u090f \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u0939\u093e\u0930 \u092e\u093e\u0930\u0928\u0947 \u0915\u094b \u0924\u0948\u092f\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0909\u0932\u091f\u093e \u0905\u092c \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0928\u0947 \u0930\u0942\u0938 \u092a\u0930 \u0939\u092e\u0932\u0947 \u0924\u0947\u091c \u0915\u0930 \u0926\u093f\u090f \u0939\u0948\u0902\u0964 \u0930\u0942\u0938 \u091c\u0939\u093e\u0902 \u0924\u093e\u092c\u0921\u093c\u0924\u094b\u0921\u093c \u0939\u092e\u0932\u0947 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948, \u0935\u0939\u0940\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0930\u0923\u0928\u0940\u0924\u093f \u0915\u0947 \u0938\u093e\u0925 \u0930\u0942\u0938\u0940 \u091c\u092e\u0940\u0928 \u0915\u092c\u094d\u091c\u093e\u0928\u0947 \u092a\u0930 \u091c\u0941\u091f\u093e \u0939\u0948\u0964 \u0907\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0930\u0942\u0938 \u0915\u0947 \u0915\u0908 \u0936\u0939\u0930\u094b\u0902 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0921\u094d\u0930\u094b\u0928 \u0905\u091f\u0948\u0915 \u092d\u0940 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964 \n\u0907\u0938 \u092c\u0940\u091a \u0905\u092c \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094b\u0932\u094b\u0926\u093f\u092e\u0940\u0930 \u091c\u0