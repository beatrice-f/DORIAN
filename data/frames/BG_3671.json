u0435\u043b\u0438\u0442\u0435 \u0414\u0430 \u0433\u043b\u0430\u0441\u0443\u0432\u0430\u0442 \u0437\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \"\u0449\u0435 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u0442 \u043c\u0438\u0440\u043d\u0438 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0438, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u043e\u0439\u043d\u0430\u0442\u0430\". \u0422\u043e\u0439 \u043f\u0438\u0448\u0435 \u0437\u0430 \u0442\u043e\u0432\u0430 \u0432 Facebook (\u0417\u0430\u0431\u0440\u0430\u043d\u0435\u043d \u0432 \u0420\u0443\u0441\u043a\u0430\u0442\u0430 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f). \"\u0413\u043b\u0430\u0441\u0443\u0432\u0430\u0445 \u0432 \u0431\u043e\u043b\u043d\u0438\u0446\u0430\u0442\u0430, \u0442\u044a\u0439 \u043a\u0430\u0442\u043e \u0442\u0435\u0437\u0438 \u0438\u0437\u0431\u043e\u0440\u0438 \u0441\u044a\u0449\u043e \u0441\u0430 \u0432\u0430\u0436\u043d\u0438. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0435 \u0434\u0430 \u0441\u0435 \u0438\u0437\u0431\u0438\u0440\u0430\u0442 \u0435\u0432\u0440\u043e\u0434\u0435\u043f\u0443\u0442\u0430\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \u0449\u0435 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u0442 \u043c\u0438\u0440\u043d\u0438\u0442\u0435 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0438, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0432\u043e\u0439\u043d\u0430\u0442\u0430, \u043f\u0438\u0448\u0435 \u0424\u0438\u0446\u043e. \"\u0421\u044a\u0433\u043b\u0430\u0441\u0438\u0435\u0442\u043e, \u0434\u0430\u0434\u0435\u043d\u043e \u043e\u0442 \u0437\u0430\u043f\u0430\u0434\u043d\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0437\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0