434\u043e \u043a\u0440\u0430\u044f \u043d\u0430 2024 \u0433.\u201c. \u0422\u043e\u0432\u0430 \u0435 \u0437\u0430\u044f\u0432\u0438\u043b \u0433\u0435\u043d\u0435\u0440\u0430\u043b-\u043c\u0430\u0439\u043e\u0440 \u0410\u043f\u0442\u0438 \u0410\u043b\u0430\u0443\u0434\u0438\u043d\u043e\u0432, \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440 \u043d\u0430 \u0441\u0438\u043b\u0438\u0442\u0435 \u0441\u044a\u0441 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u201e\u0410\u0445\u043c\u0430\u0442\u201c, \u0441\u044a\u043e\u0431\u0449\u0430\u0432\u0430\u0442 \u0440\u0443\u0441\u043a\u0438 \u043c\u0435\u0434\u0438\u0438. \u201e\u0414\u044a\u0440\u0436\u0430 \u043d\u0430 \u043c\u043d\u0435\u043d\u0438\u0435\u0442\u043e \u0441\u0438: \u043f\u043e\u0432\u0435\u0447\u0435 \u043e\u0442 \u0443\u0432\u0435\u0440\u0435\u043d \u0441\u044a\u043c, \u0447\u0435 \u0442\u0430\u0437\u0438 \u0433\u043e\u0434\u0438\u043d\u0430 \u0449\u0435 \u0437\u0430\u0432\u044a\u0440\u0448\u0438\u043c \u0421\u0412\u041e\u201c, \u0435 \u0437\u0430\u044f\u0432\u0438\u043b \u0442\u043e\u0439. \u0410\u043b\u0430\u0443\u0434\u0438\u043d\u043e\u0432 \u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u043b, \u0447\u0435 \u0412\u044a\u043e\u0440\u044a\u0436\u0435\u043d\u0438\u0442\u0435 \u0441\u0438\u043b\u0438 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u201e\u0432\u0435\u0447\u0435 \u0441\u0430 \u0441\u0435 \u043f\u0440\u044a\u0441\u043d\u0430\u043b\u0438 \u0438\u0437 \u0432\u0441\u0438\u0447\u043a\u0438 \u0444\u0440\u043e\u043d\u0442\u043e\u0432\u0435, \u043a\u0430\u0442\u043e \u043d\u0430 \u0432\u0441\u0435\u043a\u0438 \u043d\u044f\u043a\u043e\u043b\u043a\u043e \u0434\u043d\u0438 \u0440\u0443\u0441\u043a\u0438\u0442\u0435 \u0447\u0430\u0441\u0442\u0438 \u043f\u0440\u0435\u0432\u0437\u0435\u043c\u0430\u0442 \u043d\u043e\u0432\u0438 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438 \u043c\u0435\u0441\u0442\u0430\u20