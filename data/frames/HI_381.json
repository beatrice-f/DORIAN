2f\u0939", "\u0935\u0948\u0936\u094d\u0935\u093f\u0915", "\u0930\u0915\u094d\u0937\u093e", "\u0938\u0939\u092f\u094b\u0917\u094b\u0902", "\u092e\u0947\u0902", "\u092c\u0926\u0932\u0924\u0947", "\u0938\u092e\u0940\u0915\u0930\u0923\u094b\u0902", "\u0915\u094b", "\u092d\u0940", "\u0930\u0947\u0916\u093e\u0902\u0915\u093f\u0924", "\u0915\u0930\u0924\u093e", "\u0939\u0948", "\u0964"], "sentence": "\u0924\u0947\u091c\u0938 \u0915\u0947 \u0907\u0902\u091c\u0928 \u0915\u0940 \u0938\u092a\u094d\u0932\u093e\u0908 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0926\u0947\u0930\u0940: \u092d\u093e\u0930\u0924\u0940\u092f \u0935\u093e\u092f\u0941\u0938\u0947\u0928\u093e \u0915\u0947 \u0906\u0927\u0941\u0928\u093f\u0915\u0940\u0915\u0930\u0923 \u092a\u0930 \u092c\u0921\u093c\u093e \u091d\u091f\u0915\u093e\n\n\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u094d\u0935\u0926\u0947\u0936\u0940 \u0924\u0947\u091c\u0938 Mk1A \u0932\u0921\u093c\u093e\u0915\u0942 \u0935\u093f\u092e\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u091c\u0928 \u0915\u0940 \u0938\u092a\u094d\u0932\u093e\u0908 \u0915\u094b \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 GE \u090f\u092f\u0930\u094b\u0938\u094d\u092a\u0947\u0938 \u0928\u0947 2025 \u0924\u0915 \u091f\u093e\u0932 \u0926\u093f\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0926\u094d\u0935\u093f\u092a\u0915\u094d\u0937\u0940\u092f \u0938\u0902\u092c\u0902\u0927\u094b\u0902 \u092e\u0947\u0902 \u0916\u091f\u093e\u0938 \u0906\u0908 \u0939\u0948\u0964 \u092f\u0939 \u0926\u0947\u0930\u0940 \u0910\u0938\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948 \u091c\u092c \u092d\u093e\u0930\u0924 \u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u092e\u093f\u0917-21 \u0935\u093f\u092e\u093e\u0928\u094b\u0902 \u0915\u094b \u0930\u093f\u091f\u093e\u092f\u0930 \u0915\u0930 \u0930\u