u0937\u0940\u092f \u0930\u093e\u0938\u094d\u0924\u093e \u0939\u0948? \u0930\u0942\u0938 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948 - \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0930, \u0938\u094d\u0935\u093f\u091f\u094d\u091c\u0930\u0932\u0948\u0902\u0921 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u090f\u0915 \u0936\u093e\u0902\u0924\u093f \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e \u0930\u0939\u093e \u0939\u0948, \u0914\u0930 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u094b\u0902 \u092a\u0930 \u0928\u091c\u0930 \u0930\u0916\u0924\u0947 \u0939\u0941\u090f, \u092d\u093e\u0930\u0924 \u0938\u0939\u093f\u0924 \u0938\u092d\u0940 \u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0907\u0938\u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e \u0939\u0948\u0964\n\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u092a\u0924\u094d\u0930\u0915\u093e\u0930 \u091f\u0915\u0930 \u0915\u093e\u0930\u094d\u0932\u0938\u0928 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f, \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0915\u094d\u092f\u093e \u0915\u0939\u093e \u0925\u093e: \u201c\u0939\u092e \u092a\u094b\u0932\u0948\u0902\u0921 \u092a\u0930 \u0939\u092e\u0932\u093e \u0915\u094d\u092f\u094b\u0902 \u0915\u0930\u0947\u0902\u0917\u0947? \u0939\u092e\u0947\u0902 \u092a\u094b\u0932\u0948\u0902\u0921, \u0932\u093e\u0924\u0935\u093f\u092f\u093e \u092f\u093e \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0926\u0947\u0936 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0926\u093f\u0932\u091a\u0938\u094d\u092a\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0927\u092e\u0915\u0940 \u0926\u0947\u0928\u093e \u0939\u0948\u0964\n\u092d\u093e\u0930\u0924 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f\n\u0930\u0942\u0938 \u0938\u0902\u092c\u0902\u0927 - \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u092e\u0947\u0902 \u092a\u0930\u0939\u0947\u091c \u092a\u0930 \u0915\u094b\u0908 \u092c\u0926\u0932\u093e\u0935 \u0928\u0939\u0940\u0902\u0964 \u0924\u0947\u0932 \u0915\u0940 \u0916\u0930\u0940\u0926 \u092e\u0947\u0902 \u0935\u0943\u0926\u094d\u0927\u093f \u0939\u0941\u0908 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0930\u0942\u0938 \u0915\u093e \u0924\u0947\u0932 \u0906\u092f\u093e\u0924 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e 30-40% \u0939\u0948, \u091c\u092c\u0915\u093f \u092f\u0941\u0926\u094d\u0927-\u092a\u0942\u0930\u094d\u0935 \u092f\u0939 \u090f\u0915 \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u0938\u0947 \u092d\u0940 \u0915\u092e \u0939\u0948\u0964 \u0930\u0942\u0938 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092e\u0941\u0926\u094d\u0926\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u0948\u0928\u094d\u092f \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0916\u0930\u0940\u0926 \u0915\u094b \u0939\u0930\u0940 \u091d\u0902\u0921\u0940 \u092e\u093f\u0932 \u0917\u0908 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0926\u094d\u0935\u093f\u092a\u0915\u094d\u0937\u0940\u092f \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092c\u0922\u093c \u0930\u0939\u093e \u0939\u0948\u0964 \u0930\u093e\u091c\u0928\u0940\u0924\u093f\u0915 \u0938\u094d\u0924\u0930 \u092a\u0930, \u092a\u0940\u090f\u092e \u0905\u092c 2 \u0938\u093e\u0932 \u0938\u0947 \u092e\u0949\u0938\u094d\u0915\u094b \u0928\u0939\u0940\u0902 \u0917\u090f \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u0940 \u091c\u092f\u0936\u0902\u0915\u0930 \u0928\u0947 \u0926\u093f\u0938\u0902\u092c\u0930 \u092e\u0947\u0902 \u0926\u094c\u0930\u093e \u0915\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0947 \u0905\u0915\u094d\u091f\u0942\u092c\u0930 \u092e\u0947\u0902 \u092e\u0949\u0938\u094d\u0915\u094b \u092e\u0947\u0902 \u092c\u094d\u0930\u093f\u0915\u094d\u0938 \u0936\u093f\u0916\u0930 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u0940 \u0909\u092e\u094d\u092e\u0940\u0926 \u0939\u0948\u0964 \u0907\u0938 \u092c\u0940\u091a, \u092a\u0936\u094d\u091a\u093f\u092e \u0938\u0947 \u0935\u093f\u0930\u094b\u0927 \u0915\u0947 \u0938\u094d\u0935\u0930 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926, \u0935\u093f\u092a\u0915\u094d\u0937\u0940 \u0928\u0947\u0924\u093e \u090f\u0932\u0947\u0915\u094d\u0938\u0940 \u0928\u0935\u0932\u0928\u0940 \u0915\u0940 \u092e\u094c\u0924 \u092a\u0930 \u0915\u094b\u0908 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0906\u0908\u0964\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0938\u093e\u0925, \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u0905\u0927\u093f\u0915 \u0930\u0942\u0922\u093c\u093f\u0935\u093e\u0926\u0940 \u0930\u0939\u0940 \u0939\u0948 - \u091c\u092c\u0915\u093f \u0909\u0938\u0928\u0947 \u0926\u0935\u093e\u090f\u0902, \u092a\u093e\u0928\u0940 \u0915\u0947 \u091f\u0948\u0902\u0915, \u0924\u0902\u092c\u0942 \u0907\u0924\u094d\u092f\u093e\u0926\u093f \u091c\u0948\u0938\u0940 \u0932\u0917\u092d\u0917 100 \u091f\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0935\u0939 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0917\u0908 \u0922\u093e\u0902\u091a\u093e\u0917\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u0930 \u0938\u0939\u092e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908 \u0939\u0948\u0964 \u0915\u0940\u0935 \u092e\u0947\u0902 \u092e\u0902\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0915\u093e \u0915\u094b\u0908 \u0926\u094c\u0930\u093e \u0928\u0939\u0940\u0902, \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0928\u0947 \u091c\u093e\u092a\u093e\u0928 \u092e\u0947\u0902 \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940 \u0932\u0947\u0915\u093f\u0928 \u0909\u0928\u094d\u0939\u0947\u0902 G20 \u0936\u093f\u0916\u0930 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u092e\u0947\u0902 \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\n\u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0907\u0938 \u0930\u0941\u0916 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926, \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u092f\u0942\u0930\u094b\u092a \u0915\u0947 \u0938\u093e\u0925 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0941\u090f \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u0915\u0941\u091b \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u0902\u092a\u0928\u093f\u092f\u094b\u0902 \u092a\u0930 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927 \u0932\u0917\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u092a\u0936\u094d\u091a\u093f\u092e \u0938\u0947 \u0926\u094d\u0935\u093f\u092a\u0915\u094d\u0937\u0940\u092f \u091c\u0941\u0921\u093c\u093e\u0935 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0915\u092e\u0940 \u0928\u0939\u0