\u0930\u093e\u092f\u0938\u0940\u0928\u093e \u0921\u093e\u092f\u0932\u0949\u0917 \u0915\u0947 \u0932\u093f\u090f \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0930\u0942\u0938 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u092c\u094d\u091c\u093c\u093e \u0915\u0940 \u0917\u0908 \u091c\u093c\u092e\u0940\u0928 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0916\u094b\u0928\u0947 \u0915\u093e \u0916\u093c\u0924\u0930\u093e \u0939\u0948? \u0914\u0930 \u0915\u094d\u092f\u093e 2022 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0935\u093f\u0926\u0947\u0936 \u0928\u0940\u0924\u093f \u0915\u0940 \u0938\u0941\u0908 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092d\u0940 \u0918\u0942\u092e \u0917\u0908 \u0939\u0948? \u0939\u092e \u0906\u092a\u0915\u094b \u0935\u0939 \u0924\u0938\u094d\u0935\u0940\u0930 \u0926\u093f\u0916\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u0947 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0930\u093e\u092f\u0938\u0940\u0928\u093e \u0938\u0902\u0935\u093e\u0926 \u092e\u0947\u0902 \u0909\u092d\u0930\u0940 - \u091c\u0939\u093e\u0902 \u090f\u0915\u0924\u094d\u0930 \u0939\u0941\u090f 21 \u092e\u0947\u0902 \u0938\u0947 15 \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u0940 \u092f\u0942\u0930\u094b\u092a \u0938\u0947 \u0925\u0947 - \u0914\u0930 \u092d\u093e\u0930\u0924 \u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0930\u0942\u0938 \u0938\u0947 \u0924\u0947\u0932 \u0914\u0930 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u0940 \u0916\u0930\u0940\u0926 \u092a\u0930 \u092a\u0941\u0928\u0930\u094d\u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0940 \u091c\u094b\u0930\u0926\u093e\u0930 \u0935\u0915\u093e\u0932\u0924 \u0915\u0940\u0964\n\u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u091c\u0930\u094d\u092e\u0928 \u0905\u0916\u092c\u093e\u0930 \u0939\u0948\u0902\u0921\u0947\u0932\u094d\u0938\u092c\u094d\u0932\u0948\u091f \u0915\u094b \u0926\u093f\u090f \u090f\u0915 \u0938\u093e\u0915\u094d\u0937\u093e\u0924\u094d\u0915\u093e\u0930 \u092e\u0947\u0902 \u0936\u094d\u0930\u0940 \u091c\u092f\u0936\u0902\u0915\u0930 \u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u092c\u091a\u093e\u0935 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0915\u0939\u093e \u0925\u093e \u0915\u093f \"\u0930\u0942\u0938 \u0928\u0947 \u0915\u092d\u0940 \u092d\u0940 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0939\u093f\u0924\u094b\u0902 \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0902\u091a\u093e\u092f\u093e \u0939\u0948\"\u0964\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u0926\u094b \u0938\u093e\u0932 - \u092e\u0942\u0932 \u0930\u0942\u092a \u0938\u0947 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0915\u092e \u0939\u094b\u0928\u0947 \u0915\u0940 \u0909\u092e\u094d\u092e\u0940\u0926 \u0925\u0940 - \u092f\u0939\u093e\u0902 5 \u091a\u0940\u091c\u0947\u0902 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0906\u092a\u0915\u094b \u091c\u093e\u0928\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\n\u0930\u0942\u0938 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u092d\u093f\u092f\u093e\u0928 \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0915\u0947 \u0926\u094b \u0938\u093e\u0932 \u092c\u093e\u0926 - \u092f\u0926\u093f \u092e\u093e\u0930\u094d\u091a 2022 \u0924\u0915 \u0930\u0942\u0938 \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u0932\u0917\u092d\u0917 20% \u0939\u093f\u0938\u094d\u0938\u0947 \u092a\u0930 \u0915\u092c\u094d\u091c\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0925\u093e, \u0924\u094b 2024 \u0924\u0915 \u0935\u0939 \u0905\u092d\u0940 \u092d\u0940 \u0907\u0938\u092e\u0947\u0902 \u0938\u0947 \u0932\u0917\u092d\u0917 17% \u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0905\u0928\u0941\u092e\u093e\u0928 \u0939\u0948 \u0915\u093f \u0935\u0930\u094d\u0937 \u0915\u0947 \u0905\u0902\u0924 \u0924\u0915 \u0930\u0942\u0938 132 \u0905\u0930\u092c \u0921\u0949\u0932\u0930 \u0916\u0930\u094d\u091a \u0915\u0930 \u091a\u0941\u0915\u093e \u0939\u094b\u0917\u093e \u0914\u0930 \u092a\u0936\u094d\u091a\u093f\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 300 \u0905\u0930\u092c \u0921\u0949\u0932\u0930 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u093e \u0928\u0941\u0915\u0938\u093e\u0928 \u0939\u094b\u0917\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u091a\u0940\u0928, \u092d\u093e\u0930\u0924 \u0914\u0930 \u092c\u094d\u0930\u093e\u091c\u093c\u0940\u0932 \u091c\u0948\u0938\u0947 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0907\u0938\u0915\u0940 \u0924\u0947\u0932 \u0915\u0940 \u092c\u093f\u0915\u094d\u0930\u0940 \u0932\u0917\u092d\u0917 \u092f\u0941\u0926\u094d\u0927-\u092a\u0942\u0930\u094d\u0935 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0906 \u0917\u0908 \u0939\u0948\u0964\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u092f\u0941\u0926\u094d\u0927 \u0915\u093e \u0916\u093e\u092e\u093f\u092f\u093e\u091c\u093e \u092d\u0941\u0917\u0924\u0928\u093e \u092a\u0921\u093c\u093e \u0939\u0948 - \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u092e\u093e\u0930\u0947 \u0917\u090f, 14 \u092e\u093f\u0932\u093f\u092f\u0928 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u0941\u090f, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 6 \u092e\u093f\u0932\u093f\u092f\u0928 \u0905\u092c \u0936\u0930\u0923\u093e\u0930\u094d\u0925\u0940 \u0939\u0948\u0902 \u091c\u094b 11 \u0926\u0947\u0936\u094b\u0902 \u092e\u0947\u0902 \u0930\u0939 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0936\u0939\u0930, \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0922\u093e\u0901\u091a\u0947 \u0928\u0937\u094d\u091f \u0939\u094b \u0917\u090f, \u0914\u0930 \u0907\u0938\u0915\u0947 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0914\u0930 \u0938\u0948\u0928\u094d\u092f \u0938\u0902\u0938\u093e\u0927\u0928\u094b\u0902 \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0926\u092c\u093e\u0935 \u092c\u0928\u093e \u0930\u0939\u093e\u0964 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0909\u092a \u090f\u092b\u090f\u092e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930- \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u092a\u0939\u0932\u0947 \u0939\u0940 500 \u0905\u0930\u092c \u0921\u0949\u0932\u0930 \u0915\u093e \u0928\u0941\u0915\u0938\u093e\u0928 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948\u0964 \u0905\u092c \u092f\u0939 \u092f\u0942\u0930\u094b\u092a\u0940\u092f \u0938\u0902\u0918 \u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948-\u0928\u093e\u091f\u094b \u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0905\u0927\u093f\u0915 \u091c\u091f\u093f\u0932 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\n\u092f\u0941\u0926\u094d\u0927 \u0915\u0947 2 \u0935\u0930\u094d\u0937\u094b\u0902 \u0928\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u092e\u0947\u0902 \u0915\u0908 \u0917\u0932\u0924\u093f\u092f\u093e\u0901 \u0926\u093f\u0916\u093e\u0908 \u0939\u0948\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u093f