930\u0942\u0938\u0940 \u0935\u093f\u092e\u093e\u0928 \u0915\u0947 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e\u0917\u094d\u0930\u0938\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0918\u091f\u0928\u093e \u0928\u0947 \u090f\u0915 \u092c\u093e\u0930 \u092b\u093f\u0930 \u092f\u0939 \u0926\u0930\u094d\u0936\u093e\u092f\u093e \u0939\u0948 \u0915\u093f \u092b\u0930\u0935\u0930\u0940 2022 \u0938\u0947 \u092f\u0941\u0926\u094d\u0927\u0930\u0924 \u0907\u0928 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0939\u093e\u0932\u093e\u0924 \u0915\u093f\u0924\u0928\u0947 \u0938\u0902\u0917\u0940\u0928 \u0939\u0948\u0902\u0964 \u0930\u0942\u0938 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u0915\u0940\u0935 \u0928\u0947 \u0930\u0942\u0938\u0940 \u0938\u0940\u092e\u093e\u0935\u0930\u094d\u0924\u0940 \u0936\u0939\u0930 \u092c\u0947\u0932\u0917\u094b\u0930\u094b\u0921 \u092e\u0947\u0902 \u0907\u0938 \u0935\u093f\u092e\u093e\u0928 \u0915\u094b \u092e\u093e\u0930 \u0917\u093f\u0930\u093e\u092f\u093e\u0964 \u0907\u0938 \u0935\u093f\u092e\u093e\u0928 \u092e\u0947\u0902 65 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0948\u0928\u093f\u0915 \u0925\u0947\u0964 \u092c\u0947\u0932\u0917\u094b\u0930\u094b\u0921 \u0936\u0939\u0930 \u0928\u0947 \u0939\u093e\u0932 \u0915\u0947 \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0930-\u092c\u093e\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0924\u0930\u092b \u0938\u0947 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0917\u094b\u0932\u093e\u092c\u093e\u0930\u0940 \u091d\u0947\u0932\u0940 \u0939\u0948\u0964 \u0915\u0940\u0935 \u0928\u0947 \u0926\u0941\u0937\u094d\u092a\u094d\u0930\u091a\u093e\u0930 \u092b\u0948\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0930\u0942\u0938 \u0915\u0940 \u0906\u0932\u094b\u091a\u0928\u093e \u0915\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0928\u0947 \u0935\u093f\u092e\u093e\u0928 \u0915\u094b \u092e\u093e\u0930 \u0917\u093f\u0930\u093e\u0928\u0947 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092d\u0942\u092e\u093f\u0915\u093e \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0918\u091f\u0928\u093e \u0910\u0938\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0939\u0941\u0908 \u0939\u0948 \u091c\u092c \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0938\u0947\u0928\u093e \u0930\u0942\u0938 \u0915\u0947 \u0932\u0917\u093e\u0924\u093e\u0930 \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u0947 \u091a\u0932\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u0940\u091a \u0905\u0917\u094d\u0930\u093f\u092e \u092e\u094b\u0930\u094d\u091a\u0947 \u092a\u0930 \u092e\u0941\u0915\u093e\u092c\u0932\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u0942\u091d \u0930\u0939\u0940 \u0939\u0948\u0964 \u0935\u0930\u094d\u0937 2022 \u092e\u0947\u0902 \u0905\u092a\u092e\u093e\u0928\u091c\u0928\u0915 \u091d\u091f\u0915\u0947 \u091d\u0947\u0932\u0928\u0947 \u0935\u093e\u0932\u0947 \u0930\u0942\u0938 \u0928\u0947 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092b\u093f\u0930 \u0938\u0947 \u0930\u092b\u094d\u0924\u093e\u0930 \u092a\u0915\u0921\u093c \u0932\u0940 \u0939\u0948\u0964 \u092a\u093f\u091b\u0932\u0947 \u0938\u093e\u0932, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0936\u0940\u0930\u094d\u0937 \u0938\u094d\u0924\u0930 \u0915\u0947 \u090f\u0915 \u091c\u0928\u0930\u0932 \u0928\u0947 \u0926\u0915\u094d\u0937\u093f\u0923 \u0914\u0930 \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0915\u0947 \u0915\u092c\u094d\u091c\u0947 \u0935\u093e\u0932\u0947 \u0907\u0932\u093e\u0915\u094b\u0902 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092e\u0915\u0938\u0926 \u0938\u0947 \u091c\u0942\u0928 2023 \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0915\u093f\u090f \u0917\u090f \u091c\u0935\u093e\u092c\u0940 \u0939\u092e\u0932\u0947 \u0915\u0947 \u0935\u093f\u092b\u0932 \u0939\u094b\u0928\u0947 \u0915\u0940 \u092c\u093e\u0924 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0925\u0940\u0964 \u0930\u0942\u0938 \u0928\u0947 \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u0902 \u0907\u0932\u093e\u0915\u093e\u0908 \u092c\u0922\u093c\u0924 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u092e\u0930\u093f\u0902\u0915\u093e \u092a\u0930 \u0915\u092c\u094d\u091c\u093c\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948 \u0914\u0930 \u0905\u0935\u0926\u0940\u0935\u0915\u093e \u0924\u0925\u093e \u0915\u0941\u092a\u093f\u092f\u093e\u0902\u0938\u094d\u0915 \u0915\u0940 \u0913\u0930 \u0906\u0917\u0947 \u092c\u0922\u093c \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u092e\u0947\u0902 \u092d\u093e\u0930\u0940 \u0928\u0941\u0915\u0938\u093e\u0928 \u0915\u0947 \u092c\u0940\u091a, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u091c\u0928\u0930\u0932 5,00,000 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u0940 \u0932\u093e\u092e\u092c\u0902\u0926\u0940 \u0915\u093e \u0906\u0939\u094d\u0935\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 - \u091c\u094b\u0915\u093f \u092c\u0947\u0939\u0926 \u0905\u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0938\u0947 \u092d\u0940 \u092c\u0926\u0924\u0930, \u0935\u093e\u0936\u093f\u0902\u0917\u091f\u0928 \u092e\u0947\u0902 \u092c\u0926\u0932\u0924\u0940 \u092b\u093f\u091c\u093e\u0902 \u0928\u0947 \u0915\u0940\u0935 \u0915\u094b \u090f\u0915 \u0916\u0924\u0930\u0928\u093e\u0915 \u0938\u0902\u0926\u0947\u0936 \u0926\u093f\u092f\u093e \u0939\u0948\u0964\n\u0935\u094b\u0932\u094b\u0926\u093f\u092e\u093f\u0930 \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0940 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u0935\u093f\u092e\u093e\u0928 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u0938\u091a\u094d\u091a\u093e\u0908 \u0915\u094b \u0909\u091c\u093e\u0917\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0907\u0938 \u0935\u093f\u092e\u093e\u0928 \u0915\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092e\u093f\u0938\u093e\u0907\u0932 \u0926\u094d\u0935\u093e\u0930\u093e \u0917\u093f\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u094b\u0917\u093e, \u0924\u094b \u092f\u0939 \u0936\u094d\u0930\u0940 \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0930\u093e\u091c\u0928\u0940\u0924\u093f\u0915 \u091a\u0941\u0928\u094c\u0924\u0940 \u0938\u093e\u092c\u093f\u0924 \u0939\u094b\u0917\u0940\u0964 \u0932\u0947\u0915\u093f\u0928 \u0909\u0928\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0907\u0938 \u092f\u0941\u0926\u094d\u0927 \u0915\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u090f\u0915 \u092c\u0921\u093c\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0924\u0915 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915 \u092c\u0939\u093e\u0926\u0941\u0930\u093e\u0928\u093e \u0905\u0902\u0926\u093e\u091c \u0926\u093f\u0916\u093e\u092f\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u091c\u0940\u0924 - \u092f\u093e\u0928\u0940 \u0930\u0942\u0938 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u092c\u094d\u091c\u093e \u0915\u093f\u090f \u0917\u090f \u0938\u092d\u0940 \u0907\u0932\u093e\u0915\u094b\u0902 \u0915\u094b \u0935\u093e\u092a\u0938 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u0947 - \u0924\u0915 \u0932\u0921\u093c\u0947\u0917\u093e\u0964 \u092d\u0932\u0947 \u0939\u0940 \u0930\u0942\u0938 \u0915\u093e \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0907\u0932\u093e\u0915\u094b\u0902 \u092a\u0930 \u0915\u092c\u094d\u091c\u093e \u0914\u0930 \u0909\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u091b\u0947\u0921\u093c\u093e \u0917\u092f\u093e \u092f\u0941\u0926\u094d\u0927 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092a\u093e\u0938 \u091c\u0940\u0924 \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u092c\u0922\u093c\u0928\u0947 \u0935\u093e\u0932\u093e \u0915\u094b\u0908 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u0930\u093e\u0938\u094d\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0917\u093e\u091c\u093e \u092a\u0930 \u0907\u091c\u0930\u093e\u0907\u0932 \u0915\u0947 \u0939\u092e\u0932\u0947, \u091c\u093f\u0938\u0947 \u092c\u093e\u0907\u0921\u0947\u0928 \u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0915\u093e \u092a\u0942\u0930\u094d\u0923 \u0938\u092e\u0930\u094d\u0925\u0928 \u0939\u093e\u0938\u093f\u0932 \u0939\u0948, \u0928\u0947 \u092d\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0938\u0947 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0927\u094d\u092f\u093e\u0928 \u092d\u091f\u0915\u093e \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u0907\u0938 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0915\u0941\u091b \u0939\u0940 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0916\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u0938\u092e \u0916\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0930\u093f\u092a\u092c\u094d\u0932\u093f\u0915\u0928 \u0928\u0947\u0924\u093e \u0921\u094b\u0928\u093e\u0932\u094d\u0921 \u091