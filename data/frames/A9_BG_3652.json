0434\u0435\u0440\u0438 \u043d\u0435 \u0432\u0438\u0436\u0434\u0430\u0442 \u0442\u043e\u0432\u0430, \u041e\u0440\u0431\u0430\u043d \u043a\u0430\u0437\u0430: \"\u0432\u044a\u043f\u0440\u043e\u0441\u044a\u0442 \u043d\u0435 \u0435 \u0432 \u0442\u043e\u0432\u0430, \u0447\u0435 \u0442\u0435 \u043d\u0435 \u0433\u043e \u0432\u0438\u0436\u0434\u0430\u0442, \u0442\u0435 \u0433\u043e \u0438\u0441\u043a\u0430\u0442\". \u0422\u043e\u0439 \u043e\u0442\u0431\u0435\u043b\u044f\u0437\u0430, \u0447\u0435 \u0432 \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430 \u0415\u0421 \u0438 \u041d\u0410\u0422\u041e \u0441\u043c\u044f\u0442\u0430\u0442, \u0447\u0435 \u0420\u0443\u0441\u0438\u044f \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u043e\u0431\u0435\u0434\u0435\u043d\u0430 \u043f\u043e \u0432\u043e\u0435\u043d\u0435\u043d \u043f\u044a\u0442 \u0438 \u0441\u0435 \u0433\u043e\u0442\u0432\u044f\u0442 \u0434\u0430 \u0432\u043b\u044f\u0437\u0430\u0442 \u0432 \u043f\u0440\u044f\u043a \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441 \u043d\u0435\u044f. \"\u041f\u043e\u0434 \u043d\u0430\u0442\u0438\u0441\u043a\u0430 \u043d\u0430 \u0410\u043c\u0435\u0440\u0438\u043a\u0430 \u0442\u0435 \u0441\u0435 \u043d\u0430\u0441\u043e\u0447\u0432\u0430\u0442 \u043a\u044a\u043c \u0435\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u044f \u043d\u0430 \u0432\u043e\u0435\u043d\u043d\u0438\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u0422\u043e\u0432\u0430 \u0435 \u0432\u043e\u0435\u043d\u043d\u0430 \u043f\u0441\u0438\u0445\u043e\u0437\u0430, \u0447\u0438\u0439\u0442\u043e \u0438\u0437\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u0435 \u043d\u0430\u043c\u0438\u0440\u0430 \u043d\u0430 \u0434\u0432\u0435 \u043c\u0435\u0441\u0442\u0430-\u0411\u0440\u044e\u043a\u0441\u0435\u043b \u0438 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d, \u0438 \u0437\u0430\u0442\u043e\u0432\u0430 \u0438 \u0442\u0430\u043c, \u0438 \u0442\u0430\u0