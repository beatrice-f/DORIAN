40\u0435\u044a\u043c, \u0435, \u0447\u0435 \u0435 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0447\u0435\u0441\u0442\u0435\u043d. \u0422\u043e\u0439 \u043a\u0430\u0437\u0430, \u0447\u0435 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u043c \u0432\u043e\u0439\u043d\u0430\u0442\u0430 \u043c\u0435\u0436\u0434\u0443 \u0420\u0443\u0441\u0438\u044f \u0438 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u0437\u0430\u0449\u043e\u0442\u043e \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0441\u044a\u0434\u044a\u0440\u0436\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0438 \u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438 \u043d\u0430 \u0441\u0442\u043e\u0439\u043d\u043e\u0441\u0442 \u0442\u0440\u0438\u043b\u0438\u043e\u043d\u0438 \u0434\u043e\u043b\u0430\u0440\u0438. - \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0430\u0442\u0430 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u043a\u0430 \u0410\u043d\u044f \u041f\u0430\u0440\u0430\u043c\u043f\u0438\u043b\n\u0413\u0440\u0435\u044a\u043c \u043a\u0430\u0437\u0430, \u0447\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u043c \u0434\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043c \u043d\u0430 \u0442\u0435\u0437\u0438 \u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438 \u0438 \u0446\u044f\u043b\u043e\u0442\u043e \u0442\u043e\u0432\u0430 \u0431\u043e\u0433\u0430\u0442\u0441\u0442\u0432\u043e \u0434\u0430 \u043e\u0441\u0442\u0430\u043d\u0430\u0442 \u0437\u0430 \u0420\u0443\u0441\u0438\u044f \u0438 \u041a\u0438\u0442\u0430\u0439. \u0422\u043e\u0447\u043d\u043e \u0442\u043e\u0432\u0430 \u0449\u0435 \u0441\u0435 \u0441\u043b\u0443\u0447\u0438, \u0430\u043a\u043e \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u044a\u0434\u0435 \u0434\u043e\u043f\u0443\u0441\u043d\u0430\u0442\u0430 \u0434\u0430 \u0431\u044a\u0434\u0435 \u0441\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u0430 \u0434\u044a\u0440\u0436\u0430\u0