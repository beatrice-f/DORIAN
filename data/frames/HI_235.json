40", "\u0964"], "sentence": "\u092c\u0922\u093c\u0924\u093e \u092a\u0932\u093e\u092f\u0928 \u0914\u0930 \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u0928, \u091c\u0932\u0935\u093e\u092f\u0941 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0916\u094d\u0924 \u0915\u0926\u092e\u094b\u0902 \u0915\u0940 \u0926\u0930\u0915\u093e\u0930\n\n\u0926\u0941\u0928\u093f\u092f\u093e \u0907\u0938 \u0938\u092e\u092f \u0915\u0908 \u0917\u0902\u092d\u0940\u0930 \u0938\u0902\u0915\u091f\u094b\u0902 \u0938\u0947 \u0917\u0941\u091c\u0930 \u0930\u0939\u0940 \u0939\u0948, \u091c\u093f\u0928\u092e\u0947\u0902 \u0907\u091c\u0930\u093e\u092f\u0932-\u0939\u092e\u093e\u0938 \u0938\u0902\u0918\u0930\u094d\u0937, \u092f\u0942\u0915\u094d\u0930\u0947\u0928-\u0930\u0942\u0938 \u092f\u0941\u0926\u094d\u0927 \u0914\u0930 \u0924\u093e\u0907\u0935\u093e\u0928-\u091a\u0940\u0928 \u0915\u0947 \u092c\u0940\u091a \u0924\u0928\u093e\u0935 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964 1962 \u0915\u0947 \u0915\u094d\u092f\u0942\u092c\u093e \u092e\u093f\u0938\u093e\u0907\u0932 \u0938\u0902\u0915\u091f \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0939\u093e\u0932\u093e\u0924 \u0907\u0924\u0928\u0947 \u0916\u0924\u0930\u0928\u093e\u0915 \u0928\u0939\u0940\u0902 \u0939\u0941\u090f \u0925\u0947, \u092d\u0932\u0947 \u0939\u0940 \u0936\u0940\u0924 \u092f\u0941\u0926\u094d\u0927 \u0915\u093e \u0926\u094c\u0930 \u0932\u0902\u092c\u093e \u091a\u0932\u093e\u0964 \u0906\u091c \u0915\u093e \u0938\u0902\u0915\u091f \u0928 \u0915\u0947\u0935\u0932 \u092f\u0941\u0926\u094d\u0927, \u092c\u0932\u094d\u0915\u093f \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923\u0940\u092f \u092e\u0941\u0926\u094d\u0926\u094b\u0902 \u0938\u0947 \u092d\u0940 \u091c\u0941\u0921\u093c\u093e \u0939\u0948\u0964\n\u091c\u0932\u0935\u093e\u092f\u0941 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0928\u0947 \u092e\u093e\u0928\u0935\u0924\u093e \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092c\u0921\u093c\u0940 \u091a\u0941\u0928\u094c\u0924\u093f\u092f\u093e\u0902 \u0916\u0921\u093c\u0940 \u0915\u0930 \u0926\u0940 \u0939\u0948\u0902\u0964 \u092a\u0936\u094d\u091a\u093f\u092e \u090f\u0936\u093f\u092f\u093e \u0914\u0930 \u0905\u092b\u094d\u0930\u0940\u0915\u0940 \u0926\u0947\u0936 \u0938\u0942\u0921\u093e\u0928 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0906\u092a\u0926\u093e\u0913\u0902 \u0938\u0947 \u092c\u0941\u0930\u0940 \u0924\u0930\u0939 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u0948\u0902\u0964 \u0938\u0942\u0921\u093e\u0928 \u092e\u0947\u0902 \u092d\u093e\u0930\u0940 \u092c\u093e\u0930\u093f\u0936 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0914\u0930 \u092c\u0940\u092e\u093e\u0930\u093f\u092f\u093e\u0902 \u092c\u0922\u093c \u0930\u0939\u0940 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u092b\u093f\u0932\u093f\u0938\u094d\u0924\u0940\u0928 \u0915\u0947 \u0917\u093e\u091c\u093e \u092e\u0947\u0902 \u092d\u0940 \u091c\u0932\u0935\u093e\u092f\u0941 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f\u0915\u0942\u0932 \u092a\u094d\u0930\u092d\u093e\u0935\u094b\u0902 \u0938\u0947 \u0932\u093e\u0916\u094b\u0902 \u0932\u094b\u0917 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u0947 \u0905\u092d\u093e\u0935 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964 \u0926\u094b\u0928\u094b\u0902 \u0939\u0940 \u0926\u0947\u0936\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u0932\u0935\u093e\u092f\u0941 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0917\u0902\u092d\u0940\u0930 \u0938\u0902\u0915\u091f \u0915\u093e \u092a\u0930\u093f\u0923\u093e\u092e \u0939\u0948\u0964\n\u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u0915\u0940 \u0930\u093f\u092a\u094b\u093