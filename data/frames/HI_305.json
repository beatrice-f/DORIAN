\u0915\u093e\u0928\u094b\u0902", "\u092a\u0930", "\u0939\u092e\u0932\u0947", "\u0915\u0930\u0924\u0940", "\u0930\u0939\u0940", "\u0939\u0948", ".", "\u092e\u0917\u0930", "\u0905\u092c", "\u0930\u0942\u0938", "\u0915\u0947", "\u0918\u0930", "\u092e\u0947\u0902", "\u0918\u0941\u0938\u0915\u0930", "\u0939\u092e\u0932\u0947", "\u0915\u0930", "\u0930\u0939\u0940", "\u0939\u0948", ".", "\u0907\u0938\u0938\u0947", "\u092a\u0939\u0932\u0947", "\u092f\u0942\u0915\u094d\u0930\u0947\u0928", "\u0928\u0947", "\u0915\u092d\u0940", "\u092d\u0940", "\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915", "\u0924\u094c\u0930", "\u092a\u0930", "\u0930\u0942\u0938", "\u092e\u0947\u0902", "\u091c\u092e\u0940\u0928\u0940", "\u0918\u0941\u0938\u092a\u0948\u0920", "\u0928\u0939\u0940\u0902", "\u0915\u0940", "\u0925\u0940", "."], "sentence": "\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u0930\u0942\u0938 \u092a\u0930 \u092a\u0932\u091f\u0935\u093e\u0930: \u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0935\u093f\u0936\u094d\u0935 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092c\u093e\u0926 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0930\u0942\u0938\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0918\u0941\u0938\u092a\u0948\u0920\n\n\u0905\u092c \u0930\u0942\u0938 \u092a\u0930 \u091a\u0922\u093c\u093e\u0908 \u0915\u0930 \u0930\u0939\u093e \u092f\u0942\u0915\u094d\u0930\u0947\u0928\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u093e \u0930\u0942\u0938 \u0915\u0947 \u0907\u0932\u093e\u0915\u094b\u0902 \u092e\u0947\u0902 \u0932\u0917\u093e\u0924\u093e\u0930 \u0918\u0941\u0938\u092a\u0948\u0920 \u091c\u093e\u0930\u0940 \u0939\u0948. \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0907\u0938 \u0915\u0926\u092e \u0938\u0947 \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e \u092e\u0947\u0902 \u0939\u0921\u093c\u0915\u0902\u092a \u092e\u091a \u091a\u0941\u0915\u093e \u0939\u0948. \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0932\u0917\u093e\u0924\u093e\u0930 \u0906\u0917\u0947 \u0915\u0940 \u0913\u0930 \u092c\u0922\u093c \u0930\u0939\u0940 \u0939\u0948. \u0907\u0938\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0930\u0942\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0947 \u0918\u0930\u094b\u0902 \u0938\u0947 \u092d\u093e\u0917\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0939\u094b\u0928\u093e \u092a\u0921\u093c\u093e \u0939\u0948. \u092f\u0939\u093e\u0902 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u092c\u093e\u0924 \u0939\u0948 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0915\u0940 \u092f\u0939 \u0918\u0941\u0938\u092a\u0948\u0920 \u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0935\u093f\u0936\u094d\u0935 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092c\u093e\u0926 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0915\u093f\u0938\u0940 \u0935\u093f\u0926\u0947\u0936\u0940 \u0938\u0947\u0928\u093e \u0915\u093e \u0930\u0942\u0938\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0939\u0948. \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u092f\u0939 \u0915\u0926\u092e \u0930\u0942\u0938 \u0914\u0930 \u092a\u0941\u0924\u093f\u0928 \u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092c\u0921\u093c\u0940 \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u0917\u0940 \u0915\u0940 \u092c\u093e\u0924 \u0939\u0948. \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0930\u0942\u0938\u0940 \u0938\u0930\u091c\u092e\u0940\u0902 \u0938\u0947 \u0926\u0941\u0936\u094d\u092e\u0928 \u0915\u094b \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0940 \u0915