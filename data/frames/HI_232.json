48\u091c\u094d\u091e\u093e\u0928\u093f\u0915\u094b\u0902 \u0928\u0947 \u092c\u0928\u093e\u092f\u093e \u0928\u092f\u093e \u092a\u094d\u0932\u093e\u0928\n\n\u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u091a\u0947\u0902\u091c \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0938\u0947 \u0928\u093f\u092a\u091f\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915\u094b\u0902 \u0928\u0947 \u090f\u0915 \u0938\u094d\u091f\u0921\u0940 \u092e\u0947\u0902 \u090f\u0915 \u092c\u0921\u093c\u093e \u0916\u0941\u0932\u093e\u0938\u093e \u0915\u093f\u092f\u093e \u0939\u0948. \u0907\u0938\u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0939\u0940\u0930\u0947 \u0915\u0940 \u0927\u0942\u0932 \u092f\u093e\u0928\u0940 \u0921\u0938\u094d\u091f \u0938\u0947 \u092f\u093e \u092b\u093f\u0930 \u0915\u0908 \u0914\u0930 \u0915\u0902\u092a\u093e\u0909\u0902\u0921 \u0915\u0947 \u091b\u093f\u0921\u093c\u0915\u093e\u0935 \u0938\u0947 \u0938\u0942\u0930\u094d\u092f \u0938\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u0947\u0921\u093f\u090f\u0936\u0928 \u0915\u094b \u0935\u093e\u092a\u0938 \u0905\u0902\u0924\u0930\u093f\u0915\u094d\u0937 \u092e\u0947\u0902 \u092d\u0947\u091c\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u092a\u0943\u0925\u094d\u0935\u0940 \u092a\u0930 \u092c\u0922\u093c\u0924\u0947 \u0924\u093e\u092a\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u092e\u0940 \u0906 \u0938\u0915\u0924\u0940 \u0939\u0948. \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u091a\u0947\u0902\u091c \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0932\u0917\u093e\u0924\u093e\u0930 \u092c\u0922\u093c\u0924\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948\u0902. \u0907\u0938\u0915\u094b \u0932\u0947\u0915\u0930 \u092f\u0942\u090f\u0928 \u092d\u0940 \u0932\u0917\u093e\u0924\u093e\u0930 \u091a\u093f\u0902\u0924\u093e \u091c\u0924\u093e \u0930\u0939\u093e \u0939\u0948. \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0907\u0938 \u0938\u092e\u0938\u094d\u092f\u093e \u0938\u0947 \u0928\u093f\u092a\u091f\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915\u094b\u0902 \u0928\u0947 \u090f\u0915 \u0938\u094d\u091f\u0921\u0940 \u092e\u0947\u0902 \u0917\u091c\u092c \u0915\u093e \u0916\u0941\u0932\u093e\u0938\u093e \u0915\u093f\u092f\u093e \u0939\u0948. \u0907\u0938\u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u092a\u0943\u0925\u094d\u0935\u0940 \u0915\u0947 \u090a\u092a\u0930\u0940 \u0935\u093e\u092f\u0941\u092e\u0902\u0921\u0932 \u092e\u0947\u0902 \u0939\u0930 \u0938\u093e\u0932 \u0905\u0917\u0930 \u0932\u093e\u0916\u094b\u0902 \u091f\u0928 \u0939\u0940\u0930\u0947 \u0915\u0940 \u0927\u0942\u0932 \u091b\u093f\u0921\u093c\u0915\u0940 \u091c\u093e\u090f \u0924\u094b \u092a\u0943\u0925\u094d\u0935\u0940 \u0915\u0947 \u0924\u093e\u092a\u092e\u093e\u0928 \u0915\u094b \u0920\u0902\u0921\u093e \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u092f\u0947 \u0926\u093e\u0935\u093e \u0925\u094b\u0921\u093c\u093e \u0905\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0932\u0917\u0928\u0947 \u0935\u093e\u0932\u093e \u091c\u0930\u0942\u0930 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0910\u0938\u093e \u0926\u093e\u0935\u093e \u0915\u094b\u0908 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906. \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940 \u0915\u0908 \u0915\u0902\u092a\u093e\u0909\u0902\u0921 \u0915\u0947 \u091c\u0948\u0938\u0947 \u0938\u0932\u094d\u092b\u0930, \u0915\u0948\u0932\u094d\u0936\u093f\u092f\u092e, \u090f\u0932\u094d\u092f\u0942\u092e\u093f\u0928\u093f\u092f\u092e \u0914\u0930 \u0938\u093f\u0932\u093f\u0915\u0949\u0928 \u0915\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0938\u0947 \u0907\u0938 \u0915\u093