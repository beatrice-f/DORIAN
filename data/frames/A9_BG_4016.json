0441\u0430\u043d\u043a\u0446\u0438\u0438\u0442\u0435. \u0412 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u043d\u0430 \u0442\u0440\u0435\u0441\u043a\u0430\u0432\u043e\u0442\u043e \u043b\u043e\u0431\u0438\u0440\u0430\u043d\u0435 \u0437\u0430 \u0435\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u044f \u043d\u0430 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u043d\u0430 \u0417\u0430\u043f\u0430\u0434, \u043b\u0438\u043f\u0441\u0432\u0430\u0442 \u0434\u044a\u043b\u0431\u043e\u043a\u043e\u043c\u0438\u0441\u043b\u0435\u043d\u0438 \u0433\u043b\u0430\u0441\u043e\u0432\u0435 \u043d\u0430 \u043d\u0435\u0441\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0441\u0440\u0435\u0449\u0443 \u043f\u0440\u043e\u043a\u0441\u0438 \u0432\u043e\u0439\u043d\u0430\u0442\u0430 \u043d\u0430 \u041d\u0410\u0422\u041e \u0441 \u0420\u0443\u0441\u0438\u044f \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u043f\u0438\u0448\u0435 Responsible Statecraft. \u041d\u043e \u0442\u0435 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0442. \u0421\u0440\u0435\u0434 \u0442\u044f\u0445 \u0441\u0430 \u0431\u0438\u0432\u0448\u0438\u0442\u0435 \u0437\u0430\u043f\u0430\u0434\u043d\u0438 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0446\u0438 \u043d\u0430 \u0421\u0410\u0429 \u0414\u0436\u0430\u043a \u041c\u0430\u0442\u043b\u043e\u043a \u0438 \u0427\u0430\u0441 \u0424\u0440\u0438\u0439\u043c\u0430\u043d, \u0422\u043e\u043d\u0438 \u0411\u0440\u0435\u043d\u0442 \u043e\u0442 \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u044f \u0438 \u0422\u043e\u043d\u0438 \u041a\u0435\u0432\u0438\u043d \u043e\u0442 \u0410\u0432\u0441\u0442\u0440\u0430\u043b\u0438\u044f. \u0410 \u0432 \u0442\u0435\u0437\u0438 \u0440\u0435\u0434\u0438\u0446\u0438 \u0438\u043c\u0430 \u043d\u043e\u0432\u043e \u043f\u043e\u043f\u044a\u043b\u043d\u0435\u043d\u0438\u0435 \u0432 \u043b\u0438\u0446\u0435\u0442\u043e \u043d\u0430 \u0418\u044a\u043d \u041f\u0440\u0430\u0443\u0434, \u043e\u043f\u043