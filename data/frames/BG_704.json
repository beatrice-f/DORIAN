433. \u0438 \u0430\u0433\u0440\u0435\u0441\u0438\u044f\u0442\u0430 \u043d\u0430 \u041d\u0410\u0422\u041e \u0441\u0440\u0435\u0449\u0443 \u042e\u0433...\n\n\u0412\u0441\u0435\u043a\u0438 \u043f\u044a\u0442, \u0440\u0430\u0437\u043c\u0438\u0448\u043b\u044f\u0432\u0430\u0439\u043a\u0438 \u0432\u044a\u0440\u0445\u0443 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0430\u043b\u043d\u0430\u0442\u0430 \u0446\u044f\u043b\u043e\u0441\u0442 \u0438 \u043d\u0435\u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u0438\u043b\u0430, \u0441\u043f\u043e\u043c\u043d\u0435\u0442\u0435 \u0441\u0438 1999 \u0433. \u0438 \u0430\u0433\u0440\u0435\u0441\u0438\u044f\u0442\u0430 \u043d\u0430 \u041d\u0410\u0422\u041e \u0441\u0440\u0435\u0449\u0443 \u042e\u0433\u043e\u0441\u043b\u0430\u0432\u0438\u044f \u0438 \u043e\u043f\u0438\u0442\u0430 \u0437\u0430 \u043e\u0442\u0446\u0435\u043f\u0432\u0430\u043d\u0435 \u043d\u0430 \u041a\u043e\u0441\u043e\u0432\u043e \u0438 \u041c\u0435\u0442\u043e\u0445\u0438\u044f. \u0413\u043e\u0432\u043e\u0440\u0435\u0439\u043a\u0438 \u0437\u0430 \u043d\u0435\u043d\u0430\u043c\u0435\u0441\u0430 \u0432\u044a\u0432 \u0432\u044a\u0442\u0440\u0435\u0448\u043d\u0438\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0438, \u0441\u043f\u043e\u043c\u043d\u0435\u0442\u0435 \u0441\u0438 \u0437\u0430\u043f\u0430\u0434\u043d\u0438\u0442\u0435 \u0435\u043c\u0438\u0441\u0430\u0440\u0438 \u043d\u0430 \u043a\u0438\u0435\u0432\u0441\u043a\u0438\u044f \u201e\u043c\u0430\u0439\u0434\u0430\u043d\u201c. \u0421\u043f\u043e\u043c\u043d\u0435\u0442\u0435 \u0441\u0438 \u0445\u0438\u043b\u044f\u0434\u0438\u0442\u0435 \u0438 \u0445\u0438\u043b\u044f\u0434\u0438 \u0445\u043e\u0440\u0430, \u043a\u043e\u0438\u0442\u043e \u0441\u0435 \u0443\u0434\u0430\u0432\u0438\u0445\u0430 \u0432 \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e \u043c\u043e\u0440\u0435, \u043e\u043f\u0438\u0442\u0432\u0430\u0439\u043a\u0438 \u0441\u0435 \u0434\u0430 \u0438\u0437\u0431\u044f\