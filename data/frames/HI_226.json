u0942\u091c \u090f\u091c\u0947\u0902\u0938\u0940 \u0930\u0949\u092f\u091f\u0930\u094d\u0938 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915, \u0907\u0938\u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0947 \u0932\u093f\u090f \u0935\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092a\u0930 \u0926\u092c\u093e\u0935 \u092d\u0940 \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0928\u0947 \u0936\u0928\u093f\u0935\u093e\u0930 \u0915\u094b \u090f\u0915 \u0935\u0940\u0921\u093f\u092f\u094b \u091c\u093e\u0930\u0940 \u0915\u0930 \u092c\u0924\u093e\u092f\u093e \u0915\u093f 30 \u0905\u0917\u0938\u094d\u0924 \u0915\u094b \u0930\u0942\u0938 \u0928\u0947 \u0916\u093e\u0930\u0915\u0940\u0935 \u092a\u0930 \u090f\u092f\u0930\u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915 \u0915\u0940, \u091c\u093f\u0938\u092e\u0947\u0902 6 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u093f\u092f\u094b\u0902 \u0915\u0940 \u092e\u094c\u0924 \u0939\u094b \u0917\u0908\u0964 \u0935\u0939\u0940\u0902 97 \u0932\u094b\u0917 \u0918\u093e\u092f\u0932 \u0939\u0941\u090f\u0964\n\u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0907\u0928 \u0939\u092e\u0932\u094b\u0902 \u0915\u094b \u0924\u092d\u0940 \u0930\u094b\u0915\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u091c\u092c \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0930\u0942\u0938 \u0915\u0940 \u090f\u092f\u0930\u092b\u0940\u0932\u094d\u0921\u094d\u0938 \u0914\u0930 \u0938\u0948\u0928\u094d\u092f \u0920\u093f\u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0928\u093f\u0936\u093e\u0928\u093e \u092c\u0928\u093e\u090f\u0917\u093e\u0964 \u0939\u092e \u0939\u0930 \u0930\u094b\u091c \u0905\u092a\u0928\u0947 \u0938\u0939\u092f\u094b\u0917\u0940 \u0926\u0947\u0936\u094b\u0902 \u0938\u0947 \u0907\u0938 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0909\u0928\u094d\u0939