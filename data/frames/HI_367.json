0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0938\u0902\u0915\u091f: \u092a\u0930\u092e\u093e\u0923\u0941 \u0924\u0928\u093e\u0935 \u092c\u0922\u093c\u093e, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u0939\u092e\u0932\u093e \u0914\u0930 \u092a\u0941\u0924\u093f\u0928 \u0915\u093e \u0928\u0908 \u0928\u0940\u0924\u093f \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\n\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0928\u0947 \u0930\u0942\u0938 \u092a\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 \u091b\u0939 \u090f\u091f\u0940\u090f\u0938\u0940\u090f\u092e\u090f\u0938 \u092e\u093f\u0938\u093e\u0907\u0932\u094b\u0902 \u0938\u0947 \u0939\u092e\u0932\u093e \u0915\u0930 \u0924\u0928\u093e\u0935\u092a\u0942\u0930\u094d\u0923 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u0914\u0930 \u0917\u0939\u0930\u093e \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u0930\u0942\u0938 \u0915\u0947 \u092c\u094d\u0930\u093f\u092f\u0902\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0907\u0938 \u0939\u092e\u0932\u0947 \u0938\u0947 \u092a\u0930\u092e\u093e\u0923\u0941 \u092f\u0941\u0926\u094d\u0927 \u0915\u093e \u0916\u0924\u0930\u093e \u092c\u0922\u093c \u0917\u092f\u093e \u0939\u0948\u0964 \u0930\u0942\u0938\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u091b\u0939 \u092e\u0947\u0902 \u0938\u0947 \u092a\u093e\u0902\u091a \u092e\u093f\u0938\u093e\u0907\u0932\u094b\u0902 \u0915\u094b \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092e\u093e\u0930 \u0917\u093f\u0930\u093e\u092f\u093e \u0917\u092f\u093e, \u091c\u092c\u0915\u093f \u090f\u0915 \u092e\u093f\u0938\u093e\u0907\u0932 \u0915\u093e \u092e\u0932\u092c\u093e \u0938\u0948\u0928\u094d\u092f \u0905\u0921\u094d\u0921\u0947 \u092a\u0930 \u0917\u093f\u0930\u093e, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u092c\u0921\u093c\u0