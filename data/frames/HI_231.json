915\u094b \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0915\u0940 \u091b\u0920\u0940 \u0905\u0928\u0941\u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0940 \u0939\u0948. \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0935\u0939\u093e\u0902 \u0915\u0947 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u0915\u0930\u094d\u0924\u093e \u0938\u094b\u0928\u092e \u0935\u093e\u0902\u0917\u091a\u0941\u0915 \u0905\u092a\u0928\u0947 \u0938\u092e\u0930\u094d\u0925\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0932\u0917\u093e\u0924\u093e\u0930 \u0906\u0902\u0926\u094b\u0932\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947. \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0932\u0947\u0939 \u0938\u0947 \u0926\u093f\u0932\u094d\u0932\u0940 \u0924\u0915 \u092a\u0948\u0926\u0932 \u092e\u093e\u0930\u094d\u091a \u0915\u093f\u092f\u093e \u0914\u0930 \u0906\u092e\u0930\u0923 \u0905\u0928\u0936\u0928 \u092d\u0940 \u0915\u093f\u092f\u093e. \u092f\u0947 \u0932\u094b\u0917 \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0932\u0926\u094d\u0926\u093e\u0916 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0932\u094b\u0915 \u0938\u0947\u0935\u093e \u0906\u092f\u094b\u0917 \u0914\u0930 \u0932\u0947\u0939 \u0914\u0930 \u0915\u093e\u0930\u0917\u093f\u0932 \u091c\u093f\u0932\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0932\u094b\u0915\u0938\u092d\u093e \u0938\u0940\u091f\u094b\u0902 \u0915\u0940 \u092d\u0940 \u092e\u093e\u0902\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u0909\u0928\u0915\u0940 \u092e\u093e\u0902\u0917\u0947 \u092a\u0942\u0930\u0940 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0936\u094d\u0935\u093e\u0938\u0928 \u0915\u093f\u092f\u093e \u0939\u0948. \u0