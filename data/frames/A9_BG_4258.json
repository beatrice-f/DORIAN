 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u0430\u0442\u0430 \u0441\u0438 \u0432\u043e\u0435\u043d\u043d\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0431\u0435\u0437\u043a\u0440\u0430\u0439\u043d\u043e, \u0430\u043a\u043e \u0437\u0430\u043f\u0430\u0434\u043d\u0438\u0442\u0435 \u0441\u044a\u044e\u0437\u043d\u0438\u0446\u0438 \u043d\u0430 \u041a\u0438\u0435\u0432 \u043d\u0435 \u0441\u043f\u0440\u0430\u0442 \u0434\u0430 \u043c\u0443 \u043e\u043a\u0430\u0437\u0432\u0430\u0442 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0430 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u0430, \u0437\u0430\u044f\u0432\u0438 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u044f\u0442 \u043f\u043e\u043b\u0438\u0442\u0438\u043a \u0438 \u043b\u0438\u0434\u0435\u0440 \u043d\u0430 \u043f\u0430\u0440\u0442\u0438\u044f\u0442\u0430 Reform UK \u041d\u0430\u0439\u0434\u0436\u044a\u043b \u0424\u0430\u0440\u0430\u0434\u0436 \u043d\u0430 \u0441\u0440\u0435\u0449\u0430 \u0441 \u0438\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043b\u0438, \u0446\u0438\u0442\u0438\u0440\u0430\u043d \u043e\u0442 Daily Mail. \u00ab\u041c\u043e\u0436\u0435\u043c \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u043c \u0434\u0430 \u043d\u0430\u043b\u0438\u0432\u0430\u043c\u0435 \u043f\u0430\u0440\u0438 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u0431\u0435\u0437 \u0434\u0430 \u0441\u043f\u0438\u0440\u0430\u043c\u0435, \u043d\u043e \u0434\u0430\u043b\u0438 \u0442\u044f \u043d\u0430\u0438\u0441\u0442\u0438\u043d\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0438\u0437\u0434\u044a\u0440\u0436\u0438 \u0442\u0430\u043a\u0430\u0432\u0430 \u0437\u0430\u0433\u0443\u0431\u0430 \u043d\u0430 \u0432\u043e\u0439\u0441\u043a\u0438 \u0435 \u043e\u0442\u043a\u0440\u0438\u0442 \u0432\u044a\u043f\u0440\u043e\u0441. \u0422\u0440\u0443\u0434\u043d\u043e \u0435, \u0437\u0430\u0449\u043e\u0442\u043e \u0420\u0443\u0441\u0438\u044f \u043c\u043e\u0436\u0435 \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438 \u0434\u0430 \u0432\u043e\u0434\u0438 \u0431\u043e\u0439\u043d\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432\u0435\u0447\u043d\u043e\u00bb, \u043a\u0430\u0437\u0430 \u0442\u043e\u0439. \u0420\u0430\u043d\u043e \u0438\u043b\u0438 \u043a\u044a\u0441\u043d\u043e \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0435\u0442\u0435 \u0434\u044a\u0440\u0436\u0430\u0432\u0438 \u0449\u0435 \u0438\u043c\u0430 \u043f\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u0438 \u043e\u0447\u0438 \u0432 \u043e\u0447\u0438, \u0443\u0431\u0435\u0434\u0435\u043d \u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u044a\u0442. \u0422\u043e\u0439 \u043d\u0435 \u0438\u0437\u043a\u043b\u044e\u0447\u0438 \u0442\u043e\u0432\u0430 \u0434\u0430 \u0441\u0435 \u0441\u043b\u0443\u0447\u0438, \u0430\u043a\u043e \u0414\u043e\u043d\u0430\u043b\u0434 \u0422\u0440\u044a\u043c\u043f \u0441\u043f\u0435\u0447\u0435\u043b\u0438 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u0438\u0442\u0435 \u0438\u0437\u0431\u043e\u0440\u0438 \u0432 \u0421\u0410\u0429 \u043f\u0440\u0435\u0437 \u043d\u043e\u0435\u043c\u0432\u0440\u0438. \u0412 \u0442\u043e\u0437\u0438 \u0441\u043b\u0443\u0447\u0430\u0439 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0449\u0435 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0432\u0437\u0435\u043c\u0435 \u0442\u0440\u0443\u0434\u043d\u043e\u0442\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0434\u0430 \u0441\u0435 \u043e\u0442\u043a\u0430\u0436\u0435 \u043e\u0442 \u0437\u0430\u0433\u0443\u0431\u0435\u043d\u0438\u0442\u0435 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0438, \u043f\u0440\u0438\u0437\u043d\u0430 \u043f\u0430\u0440\u0442\u0438\u0439\u043d\u0438\u044f\u0442 \u043b\u0438\u0434\u0435\u0440. \u201e\u041c\u043e\u0436\u0435\u043c \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u043c \u0434\u0430 \u0438\u043c \u043f\u04