92e", "\u092a\u0930", "\u091c\u0940\u0924", "\u092a\u093e\u0908", "\u091c\u093e", "\u0938\u0915\u0924\u0940", "\u0939\u0948", "\u092f\u093e", "\u0928\u0939\u0940\u0902", "\u0964"], "sentence": "Russia-Ukraine war: \u0928\u093e\u091f\u094b \u0915\u0947 \u0935\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0930\u0942\u0938 \u0928\u0947 \u092c\u0928\u093e \u0926\u093f\u092f\u093e \u092e\u0932\u092c\u093e ...\n\nRussia-Ukraine war: \u0928\u093e\u091f\u094b \u0915\u0947 \u0935\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0930\u0942\u0938 \u0928\u0947 \u092c\u0928\u093e \u0926\u093f\u092f\u093e \u092e\u0932\u092c\u093e, \u0905\u0938\u0932\u0940 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u091f\u093f\u0915 \u092a\u093e\u090f \u091f\u0948\u0902\u0915, \u0906\u0930\u094d\u091f\u093f\u0932\u0930\u0940 \u0938\u093f\u0938\u094d\u091f\u092e \u0914\u0930 \u092c\u0916\u094d\u0924\u0930\u092c\u0902\u0926 \u0935\u093e\u0939\u0928\nBy \u0936\u093f\u0935\u0947\u0928\u094d\u0926\u094d\u0930 \u0915\u0941\u092e\u093e\u0930 \u0930\u093e\u092f | Published: August 31, 2024 03:10 PM2024-08-31T15:10:31+5:302024-08-31T15:12:34+5:30\nRussia-Ukraine war: \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u091c\u0902\u0917 \u0936\u0941\u0930\u0942 \u0939\u0941\u090f 900 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0926\u093f\u0928 \u0939\u094b \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u0930\u0942\u0938 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0928\u093e\u091f\u094b \u0915\u0947 \u0905\u0924\u094d\u092f\u093e\u0927\u0941\u0928\u093f\u0915 \u0939\u0925\u093f\u092f\u093e\u0930 \u092d\u0940 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0938\u0948\u0928\u094d\u092f \u0936\u0915\u094d\u0924\u093f \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\nRussia-Ukraine war: \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u091c\u0902\u0917 \u0936\u0941\u0930\u0942 \u0939\u0941\u090f 900 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0926\u093f\u0928 \u0939\u094b \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0905\u092c \u0924\u0915 \u0905\u0930\u092c\u094b\u0902 \u0915\u0947 \u0939\u0925\u093f\u092f\u093e\u0930 \u0928\u0937\u094d\u091f \u0939\u094b \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0907\u0938 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0926\u0947\u0936\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0948\u0964 \u0907\u0928 \u0926\u0947\u0936\u094b\u0902 \u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0917\u094b\u0932\u093e-\u092c\u093e\u0930\u0942\u0926, \u092a\u0948\u0938\u0947 \u0914\u0930 \u0939\u0925\u093f\u092f\u093e\u0930 \u092d\u0940 \u092e\u093f\u0932\u0947 \u0939\u0948\u0902\u0964 \u0930\u0942\u0938 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0928\u093e\u091f\u094b \u0915\u0947 \u0905\u0924\u094d\u092f\u093e\u0927\u0941\u0928\u093f\u0915 \u0939\u0925\u093f\u092f\u093e\u0930 \u092d\u0940 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0938\u0948\u0928\u094d\u092f \u0936\u0915\u094d\u0924\u093f \u0915\u093e \u092a\u094d\u0930\u0924\u0940\u0915 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u091c\u0902\u0917 \u0928\u0947 \u0915\u0908 \u0927\u093e\u0930\u0923\u093e\u090f\u0902 \u092d\u0940 \u0924\u094b\u0921\u093c\u0940 \u0939\u0948\u0902\u0964 \u091c\u0902\u0917 \u0938\u0947 \u0906\u0927\u0941\u0928\u093f\u0915 \u092f\u0941\u0926\u094d\u0927 \u0915\u0940 \u0915\u0920\u094b\u0930 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915\u0924\u093e\u090f\u0902 \u0938\u093e\u092e\u0928\u0947 \u0906\u0908 \u0939\u0948\u0902\u0964 \u0928\u093e\u091f\u094b \u0915\u0940 \u0905\u0924\u094d\u092f\u093e\u0927\u0941\u0928\u093f\u0915 \u0924\u0915\u0928\u0940\u0915 \u0938\u0947 \u092c\u0928\u0947 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u094b \u092d\u0940 \u091c\u0902\u0917 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u092e\u0947\u0902 \u0928\u0937\u094d\u091f \u0939\u094b\u0928\u093e \u092a\u0921\u093c\u093e \u0939\u0948\u0964 \u0915\u0908 \u0910\u0938\u0947 \u0939\u0925\u093f\u092f\u093e\u0930 \u091c\u093f\u0928 \u092a\u0930 \u0928\u093e\u091f\u094b \u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0928\u093e\u091c \u0925\u093e, \u0909\u0928\u0915\u094b \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e\u0913\u0902 \u0928\u0947 \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u0947 \u0928\u0937\u094d\u091f \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u0907\u0928 \u0939\u093e\u0908-\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u093e \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u092e\u0947\u0902 \u0928\u0937\u094d\u091f \u0939\u094b\u0928\u093e \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u091c\u0902\u0917 \u0915\u093f\u0924\u0928\u0940 \u092d\u0940\u0937\u0923 \u0939\u0948\u0964 \u0938\u093e\u0925 \u0939\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0907\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u094b\u0902 \u0915\u0940 \u0924\u093e\u0915\u0924 \u092a\u0930 \u092d\u0940 \u0938\u0935\u093e\u0932 \u0909\u0920\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u093e\u0902 \u0939\u092e \u0906\u092a\u0915\u094b \u0910\u0938\u0947 \u092e\u0936\u0939\u0942\u0930 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0930\u0942\u0938 \u0915\u0940 \u0938\u0947\u0928\u093e \u0928\u0947 \u0928\u0937\u094d\u091f \u0915\u093f\u090f \u0939\u0948\u0902\u0964\n1- \u091a\u0948\u0932\u0947\u0902\u091c\u0930 2 (\u091c\u0940\u092c\u0940)- \u091a\u0948\u0932\u0947\u0902\u091c\u0930 2, \u092c\u094d\u0930\u093f\u091f\u0947\u0928 \u0915\u093e \u091f\u0948\u0902\u0915 \u0939\u0948\u0964 \u0907\u0938\u0947 \u092e\u0941\u0916\u094d\u092f \u092f\u0941\u0926\u094d\u0927\u0915 \u091f\u0948\u0902\u0915 (\u090f\u092e\u092c\u0940\u091f\u0940) \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u091c\u0902\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091a\u0948\u0932\u0947\u0902\u091c\u0930 2 \u0915\u093e \u092e\u0932\u092c\u093e \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u093e \u0925\u093e \u0932\u0947\u0915\u093f\u0928 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0924\u0948\u0928\u093e\u0924 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u093e \u092c\u0947\u0926\u093e\u0917 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0916\u094b \u0926\u093f\u092f\u093e\u0964 \u0905\u0917\u0938\u094d\u0924 \u0915\u0947 \u092e\u0927\u094d\u092f \u092e\u0947\u0902 \u0915\u0941\u0930\u094d\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0928\u0947 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u091f\u0948\u0902\u0915 \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930 \u0926\u093f\u092f\u093e\u0964\n2- \u0905\u092c\u094d\u0930\u093e\u092e\u094d\u0938 (\u0905\u092e\u0947\u0930\u093f\u0915\u093e)- \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0938\u0948\u0928\u094d\u092f \u0924\u093e\u0915\u0924 \u0915\u0947 \u090f\u0915 \u0914\u0930 \u092a\u094d\u0930\u0924\u0940\u0915 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u090f\u092e1 \u0905\u092c\u094d\u0930\u093e\u092e\u094d\u0938 \u0915\u094b \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0915\u0941\u0930\u094d\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u092a\u0939\u0932\u0940 \u0939\u093e\u0930 \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u093e\u0964 \u0915\u0908 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u094d\u0938 \u092e\u0947\u0902 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0906\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u093f\u090f \u0917\u090f 31 \u0905\u092c\u094d\u0930\u093e\u092e\u094d\u0938 \u091f\u0948\u0902\u0915\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e 20 \u0928\u0937\u094d\u091f \u0939\u094b \u0917\u090f \u0939\u0948\u0902\u0964\n3- HIMARS \u0930\u0949\u0915\u0947\u091f \u0906\u0930\u094d\u091f\u093f\u0932\u0930\u0940 (\u092f\u0942\u090f\u0938)- \u0905\u092a\u0928\u0940 \u092b\u093e\u092f\u0930\u092a\u0949\u0935\u0930 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e HIMARS \u0930\u0949\u0915\u0947\u091f \u0906\u0930\u094d\u091f\u093f\u0932\u0930\u0940 \u0938\u093f\u0938\u094d\u091f\u092e \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0925\u093f\u092f\u093e\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u0941\u0930\u094d\u0938\u094d\u0915 \u0939\u092e\u0932\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u0924\u0940\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u093e\u0901 \u0928\u0937\u094d\u091f \u0939\u094b \u0917\u0908\u0902\u0964\n4- \u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915\u0930 (\u0938\u0940\u090f)- \u0915\u0928\u093e\u0921\u093e \u092e\u0947\u0902 \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915\u0930 \u090f\u092a\u0940\u0938\u0940-\u0906\u0908\u090f\u092b\u0935\u0940 \u092c\u0916\u094d\u0924\u0930\u092c\u0902\u0926 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u094b \u0907\u0938 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u092c\u0921\u093c\u0947 \u092a\u0948\u092e\u093e\u0928\u0947 \u092a\u0930 \u0924\u0948\u0928\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0932\u0917\u092d\u0917 \u090f\u0915 \u0926\u0930\u094d\u091c\u0928 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u094b \u0930\u0942\u0938\u0940 \u0935\u093e\u092f\u0941 \u0938\u0947\u0928\u093e, \u0932\u0948\u0902\u0938\u0947\u091f \u0921\u094d\u0930\u094b\u0928 \u0914\u0930 \u0915\u093e\u0932\u093e \u0938\u093e\u0917\u0930 \u092c\u0947\u0921\u093c\u0947 \u0915\u0940 \u0928\u094c\u0938\u0947\u0928\u093e \u0907\u0928\u094d\u092b\u0948\u0902\u091f\u094d\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u0937\u094d\u091f \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0926\u094b \u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915\u0930 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u094b \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e \u0928\u0947 \u0905\u092a\u0928\u0947 \u0915\u092c\u094d\u091c\u0947 \u092e\u0947\u0902 \u092d\u0940 \u0932\u0947 \u0932\u093f\u092f\u093e\u0964\n5- \u092e\u093e\u0930\u094d\u0921\u0930 (\u0921\u0940\u0908)- \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0947 \u092e\u093e\u0930\u094d\u0921\u0930 \"\u0936