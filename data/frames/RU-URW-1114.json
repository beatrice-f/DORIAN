043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0420\u0424 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d, \u043e\u0442\u043c\u0435\u0442\u0438\u0432, \u0447\u0442\u043e \u041c\u043e\u0441\u043a\u0432\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u043b\u0430 \u0438 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0437\u0430 \u043c\u0438\u0440\u043d\u043e\u0435, \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u043e-\u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430. \"\"\u041c\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u044b \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c \u0428\u0430\u043d\u0445\u0430\u0439\u0441\u043a\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e \u0443\u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430. \u0420\u043e\u0441\u0441\u0438\u044f, \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0433\u043e\u0442\u043e\u0432\u0430 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0432\u0430\u0448\u0438 \u0438\u0434\u0435\u0438 \u0438 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044b\"\", - \u0441\u043a\u0430\u0437\u0430\u043b \u041f\u0443\u0442\u0438\u043d, \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044f \u043d\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u0438 \u0421\u043e\u0432\u0435\u0442\u0430 \u0433\u043b\u0430\u0432 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432 - \u0447\u043b\u0435\u043d\u043e\u0432 \u0428\u0