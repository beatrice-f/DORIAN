f\u090f \u0926\u092c\u093e\u0935 \u0921\u093e\u0932\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0907\u0938 \u0938\u0902\u0918\u0930\u094d\u0937 \u0928\u0947 \u0928 \u0938\u093f\u0930\u094d\u092b \u092f\u0942\u0930\u094b\u092a \u092c\u0932\u094d\u0915\u093f \u092a\u0942\u0930\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u0927\u0915\u094d\u0915\u093e \u092a\u0939\u0941\u0902\u091a\u093e\u092f\u093e \u0939\u0948 \u0914\u0930 \u0926\u0915\u094d\u0937\u093f\u0923\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0907\u0938 \u092c\u093e\u0924 \u0915\u094b \u0932\u0947\u0915\u0930 \u0906\u092e \u0938\u0939\u092e\u0924\u093f \u092c\u0922\u093c \u0930\u0939\u0940 \u0939\u0948 \u0915\u093f \u092f\u0939 \u0926\u0941\u0936\u094d\u092e\u0928\u0940 \u091c\u0932\u094d\u0926 \u0938\u0947 \u091c\u0932\u094d\u0926 \u0916\u0924\u094d\u092e \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u091a\u0940\u0928 \u0914\u0930 \u092c\u094d\u0930\u093e\u091c\u0940\u0932 \u0928\u0947 \u0907\u0938 \u0924\u0915\u093e\u091c\u0947 \u0915\u094b \u092d\u093e\u0902\u092a \u0932\u093f\u092f\u093e \u0939\u0948 \u0914\u0930 \u0936\u093e\u0902\u0924\u093f \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092c\u0921\u093c\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e\u0928\u0947 \u0915\u093e \u0938\u0902\u0915\u0947\u0924 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u092d\u093e\u0930\u0924 \u0915\u094b \u092d\u0940 \u0907\u0938\u092e\u0947\u0902 \u0939\u093f\u091a\u0915\u093f\u091a\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u091a\u093e\u0939\u093f\u090f\u0964 \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u0915\u0947 \u092e\u0949\u0938\u094d\u0915\u094b \u0915\u0947 \u0938\u093e\u0925 \u0905\u091a\u094d\u091b\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u0941\u0936\u094d\u0930\u0940 \u091d\u093e\u092a\u0930\u0