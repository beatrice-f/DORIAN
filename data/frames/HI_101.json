2\u0938\u094d\u0915\u0940", "\u0938\u0947", "\u092e\u093f\u0932\u0928\u0947", "\u0915\u0947", "\u0932\u093f\u090f", "\u0915\u0940\u0935", "\u0915\u0940", "\u092f\u093e\u0924\u094d\u0930\u093e", "\u0915\u0940", ".", "\u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947", "\u0915\u0940\u0935", "\u0915\u0947", "\u0938\u093e\u0925", "'", "\u092e\u093f\u0924\u094d\u0930", "'", "\u092c\u0928\u0947", "\u0930\u0939\u0928\u0947", "\u0914\u0930", "\u0936\u093e\u0902\u0924\u093f", "\u0938\u092e\u091d\u094c\u0924\u0947", "\u092e\u0947\u0902", "\u092e\u0926\u0926", "\u0915\u0930\u0928\u0947", "\u0915\u0940", "\u092c\u093e\u0924", "\u0915\u0939\u0940", "."], "sentence": "\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0914\u0930 \u0930\u0942\u0938 \u0915\u0947 \u092c\u0940\u091a \u092f\u0941\u0926\u094d\u0927 \u0916\u0924\u094d\u092e \u0915\u0930\u093e\u0928\u0947 \u092e\u0947\u0902 \u092d\u093e\u0930\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u092e\u0926\u0926: \u0930\u093f\u092a\u094b\u0930\u094d\u091f\n\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928, \u0930\u0942\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0936\u093e\u0902\u0924\u093f \u0938\u092e\u091d\u094c\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f, \u092d\u093e\u0930\u0924 \u0916\u093e\u0938 \u0924\u094c\u0930 \u092a\u0930 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0930\u0947\u0902\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0915\u094b \u090f\u0915 \u092a\u094d\u0930\u092e\u0941\u0916 \u092e\u0927\u094d\u092f\u0938\u094d\u0925 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u0947\u0916 \u0930\u0939\u093e \u0939\u0948. \u092a\u0949\u0932\u093f\u091f\u093f\u0915\u094b \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0915\u0940\u0935 \u0915\u094b \u0909\u092e\u094d\u092e\u0940\u0926 \u0939\u0948 \u0915\u093f \u092d\u093e\u0930\u0924 \u0915\u093e \u0924\u091f\u0938\u094d\u0925 \u0930\u0941\u0916 \u0914\u0930 \u0915\u0942\u091f\u0928\u0940\u0924\u093f\u0915 \u092a\u094d\u0930\u092d\u093e\u0935 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u0905\u0939\u092e \u0915\u0926\u092e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948. \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092a\u094d\u0930\u0947\u0938\u093f\u0921\u0947\u0902\u091f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0939\u0941\u0908. \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u092e\u0940\u0921\u093f\u092f\u093e \u0907\u0902\u091f\u0930\u092b\u0948\u0915\u094d\u0938 \u0928\u0947 \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0947 \u0936\u0940\u0930\u094d\u0937 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u090f\u0902\u0921\u094d\u0930\u0940 \u092f\u0930\u092e\u0915 \u0915\u0947 \u0939\u0935\u093e\u0932\u0947 \u0938\u0947 \u092c\u0924\u093e\u092f\u093e, '\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0905\u092a\u0928\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928, \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0928\u0947 \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e \u0915\u093f \u092d\u093e\u0930\u0924 \u0915\u092d\u0940 \u092d\u0940 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u092f\u094b\u091c\u0928\u093e \u092f\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0917\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0905\u0916\u0902\u0921\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0915\u094b\u0908 \u0938\u092e\u091d\u094c\u0924\u093e \u0936\u093e\u092e\u093f\u0932 \u0939\u094b.' \u090f\u0915 \u0909\u091a\u094d\u091a \u092a\u0926\u0938\u094d\u0925 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0928\u0947 \u0928\u093e\u092e \u0928 \u092c\u0924\u093e\u0928\u0947 \u0915\u0940 \u0936\u0930\u094d\u0924 \u092a\u0930 \u0915\u0939\u093e \u0915\u093f \u092d\u093e\u0930\u0924 \u0915\u0940\u0935 \u0915\u0940 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0909\u092e\u094d\u092e\u0940\u0926 \u0939\u0948. \u092d\u093e\u0930\u0924 \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0936\u093e\u0902\u0924\u093f \u0938\u092e\u091d\u094c\u0924\u0947 \u092a\u0930 \u092a\u0939\u0941\u0902\u091a\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u092e\u094b\u0926\u0940 \u0928\u0947 \u0915\u0940\u0935 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u093f\u092f\u093e \u0925\u093e \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0930\u0942\u0938 \u0915\u0947 \u0939\u092e\u0932\u0947 \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u091a\u0940\u091c\u094b\u0902 \u092a\u0930 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0938\u092e\u091d\u094c\u0924\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0917\u0940. \u0915\u0940\u0935 \u0915\u0940 \u0928\u091c\u0930 \u092e\u0947\u0902 \u092e\u094b\u0926\u0940 \u0928\u0947 \u0915\u092e \u0938\u092e\u092f \u092e\u0947\u0902 \u090f\u0915 \u0932\u0902\u092c\u093e \u0938\u092b\u0930 \u0924\u092f \u0915\u093f\u092f\u093e \u0939\u0948. \u091c\u092c \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u091c\u0941\u0932\u093e\u090