3f \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0926\u0947\u0936\u094b\u0902 \u0914\u0930 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0902\u0917\u0920\u0928\u094b\u0902 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u092c\u0948\u0920\u0915 \u0939\u0948. \u0907\u0938\u092e\u0947\u0902 90 \u0926\u0947\u0936 \u0914\u0930 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0902\u0917\u0920\u0928 \u0939\u093f\u0938\u094d\u0938\u093e \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902. \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0907\u0938 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u0915\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0926\u094b \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u0930\u0916\u0940 \u0925\u0940\u0902. \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092f\u0941\u0926\u094d\u0927 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u094b \u0936\u0930\u094d\u0924\u0947\u0902 \u0930\u0916\u0940 \u0925\u0940\u0902. \u092a\u0939\u0932\u0940, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0926\u094b\u0928\u0947\u0924\u094d\u0938\u094d\u0915, \u0932\u0941\u0939\u093e\u0902\u0938\u094d\u0915, \u0916\u0947\u093c\u0930\u0938\u094b\u0928 \u0914\u0930 \u091c\u093c\u093e\u092a\u094b\u0930\u091c\u093c\u093f\u092f\u093e \u0938\u0947 \u0905\u092a\u0928\u0947 \u0938\u0948\u0928\u093f\u0915 \u0939\u091f\u093e\u0928\u0947 \u0939\u094b\u0902\u0917\u0947. \u0926\u0942\u0938\u0930\u0940, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0928\u0947\u091f\u094b \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e. \u0938\u094d\u0935\u093f\u091f\u094d\u091c\u0930\u0932\u0948\u0902\u0921 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d