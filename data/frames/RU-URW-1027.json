43a\u0440\u0430\u0438\u043d\u044b", ",", "\u043b\u0438\u043a\u0432\u0438\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445", "\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u043c\u0438", "\u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438", "\u0432\u043e", "\u0432\u0440\u0435\u043c\u044f", "\u0441\u043f\u0435\u0446\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438", "."], "sentence": "\u041f\u043e\u0441\u043e\u043b\u044c\u0441\u0442\u0432\u043e \u0420\u0424 \u043f\u0440\u0438\u0437\u0432\u0430\u043b\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0437\u0430\u0445\u043e\u0440\u043e\u043d\u0435\u043d\u0438\u0439 \u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0445 \u0432\u043e\u0438\u043d\u043e\u0432 \u0432 \u042d\u0441\u0442\u043e\u043d\u0438\u0438\n\n\u041f\u043e\u0441\u043e\u043b\u044c\u0441\u0442\u0432\u043e \u0420\u043e\u0441\u0441\u0438\u0438 \u0432 \u042d\u0441\u0442\u043e\u043d\u0438\u0438 \u0432\u044b\u0440\u0430\u0437\u0438\u043b\u043e \u043f\u0440\u043e\u0442\u0435\u0441\u0442 \u0438\u0437-\u0437\u0430 \u0434\u0435\u043c\u043e\u043d\u0442\u0430\u0436\u0430 \u043d\u0430\u0434\u0433\u0440\u043e\u0431\u0438\u0439 \u043a\u0440\u0430\u0441\u043d\u043e\u0430\u0440\u043c\u0435\u0439\u0446\u0435\u0432 \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0435 \u0421\u0430\u0430\u0440\u0435\u043c\u0430\u0430. \u041e\u0431 \u044d\u0442\u043e\u043c \u0432\u043e \u0432\u0442\u043e\u0440\u043d\u0438\u043a, 2 \u0438\u044e\u043b\u044f, \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u0432 \u043f\u0440\u0435\u0441\u0441-\u0441\u043b\u0443\u0436\u0431\u0435 \u0432\u0435\u0434\u043e\u043c\u0441\u0442\u0432\u0430. \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438 \u043d\u043e\u0442\u0443 \u0441 \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u043c\u0438 \u043e\