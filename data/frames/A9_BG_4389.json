\u0430\u043a\u0432\u043e \u0431\u0435\u0437\u0443\u043c\u0438\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0445\u0430 \u0442\u0435\u0437\u0438 \u043c\u0430\u043d\u0438\u0430\u0446\u0438 \u0432 \u0421\u0410\u0429?! The American Conservative: \u0421\u0410\u0429 \u0442\u0440\u044f\u0431\u0432\u0430\u0448\u0435 \u0434\u0430 \u0440\u0430\u0437\u0433\u043b\u0435\u0434\u0430\u0442 \u043f\u043b\u0430\u043d\u0430 \u043d\u0430 \u041f\u0443\u0442\u0438\u043d \u0437\u0430 \u0437\u0430\u0432\u044a\u0440\u0448\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430\n\u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d \u043d\u0435 \u0442\u0440\u044f\u0431\u0432\u0430\u0448\u0435 \u0434\u0430 \u043e\u0442\u043a\u0430\u0437\u0432\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0440\u0443\u0441\u043a\u0438\u044f \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u0437\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u043f\u0438\u0448\u0435 \u0414\u0436\u0435\u0439\u043c\u0441 \u041a\u0430\u0440\u0434\u0435\u043d, \u0431\u0438\u0432\u0448 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u043a \u0432 \u0434\u0432\u0443\u0441\u0442\u0440\u0430\u043d\u043d\u0430\u0442\u0430 \u0440\u0443\u0441\u043a\u043e-\u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0430 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u044f \u043a\u044a\u043c \u0414\u044a\u0440\u0436\u0430\u0432\u043d\u0438\u044f \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442, \u0432 \u0441\u0442\u0430\u0442\u0438\u044f \u0437\u0430 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 The American Conservative. \u201e\u0410\u043a\u043e \u0432\u044a\u043d\u0448\u043d\u0430\u0442\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u043d\u0430 \u0421\u0410\u0429 \u043d\u0435 \u0441\u0435 \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0435\u0448\u0435 \u043e\u0442 \u0445\u043e\u0440\u0430 \u0441 \u043c\u0430\u043d\u0438\u044f \u043d\u0430 \u0432\u0435\u043b\u0438\u0447\u0438\u0435, \u0442\u0435 \u043f\u043e\u043d\u0435 \u0449\u044f\u0445\u0430 \u0434\u0430 \u043e\u0431\u043c\u0438\u0441\u043b\u044f\u0442 \u0442\u043e\u0437\u0438 \u043f\u043b\u0430\u043d \u043d\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d, \u043a\u0430\u0442\u043e \u0441\u0435 \u0438\u043c\u0430 \u043f\u0440\u0435\u0434\u0432\u0438\u0434, \u0447\u0435 \u043a\u0430\u043a\u0442\u043e \u043f\u0438\u0441\u0430\u0445 \u043f\u043e-\u0440\u0430\u043d\u043e, \u0432\u044a\u043f\u0440\u043e\u0441\u044a\u0442 \u043a\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0430 \u0414\u043e\u043d\u0435\u0446\u043a, \u041b\u0443\u0433\u0430\u043d\u0441\u043a, \u0425\u0435\u0440\u0441\u043e\u043d \u0438 \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0438\u0435 \u043d\u0430\u0441 \u0438\u0437\u043e\u0431\u0449\u043e \u043d\u0438 \u043a\u0430\u0441\u0430\u0435\u201c, \u043a\u0430\u0437\u0430 \u0442\u043e\u0439. \u041a\u0430\u0440\u0434\u0435\u043d \u043f\u043e\u0434\u0447\u0435\u0440\u0442\u0430, \u0447\u0435 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0441\u044a\u0449\u043e \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u043f\u0440\u0438\u0435\u043c\u0435 \u043c\u0438\u0440\u043d\u0438\u0442\u0435 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0438 \u043d\u0430 \u0440\u0443\u0441\u043a\u0438\u044f \u043b\u0438\u0434\u0435\u0440. \u0412\u044a\u043f\u0440\u0435\u043a\u0438 \u0442\u043e\u0432\u0430, \u0434\u043e\u0431\u0430\u0432\u0438 \u0442\u043e\u0439, \u041a\u0438\u0435\u0432 \u043d\u044f\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0441\u044a\u0433\u043b\u0430\u0441\u0438 \u0441 \u0442\u043e\u0432\u0430, \u0442\u044a\u0439 \u043a\u0430\u0442\u043e \u0441\u043b\u0435\u0434 \u043f\u043e\u0434\u043e\u0431\u043d\u0430 \u0441\u0442\u044a\u043f\u043a\u0430 \u0436\u0438\u0432\u043e\u0442\u044a\u0442 \u043d\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0449\u0435 \u0431\u044a\u0434\u0435 \u0432 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442 \u043f\u043e\u0440\u0430\u0434\u0438 \u043d\u0430\u0442\u0438\u0441\u043a\u0430 \u043e\u0442 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0442\u0435 \u043a\u0440\u0430\u0439\u043d\u043e\u0434\u0435\u0441\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u0438. \u0420\u0443\u0441\u043a\u0438\u044f\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u043c\u0438\u043d\u0430\u043b\u0430\u0442\u0430 \u0441\u0435\u0434\u043c\u0438\u0446\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438 \u043d\u043e\u0432\u0438 \u043c\u0438\u0440\u043d\u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0437\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u043f\u0440\u0435\u0434\u0432\u0438\u0436\u0434\u0430\u0449\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u0442\u0430\u0442\u0443\u0442\u0430 \u043d\u0430 \u041a\u0440\u0438\u043c, \u0414\u041d\u0420, \u041b\u041d\u0420, \u0425\u0435\u0440\u0441\u043e\u043d\u0441\u043a\u0430 \u0438 \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u043a\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0430\u0442\u043e \u0440\u0435\u0433\u0438\u043e\u043d\u0438 \u043d\u0430 \u0420\u0443\u0441\u0438\u044f, \u0437\u0430\u043a\u0440\u0435\u043f\u0432\u0430\u043d\u0435 \