, ",", "\u0924\u093e\u0915\u093f", "\u0926\u094b\u092c\u093e\u0930\u093e", "\u092f\u0942\u0915\u094d\u0930\u0947\u0928", "\u092a\u0930", "\u0930\u0942\u0938\u0940", "\u0939\u092e\u0932\u093e", "\u0928", "\u0939\u094b", ".", "\""], "sentence": "\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\n\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0935\u093f\u0926\u0947\u0936\u0940 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u0940 \u0938\u092e\u093f\u0924\u093f \u0915\u0947 \u0938\u0926\u0938\u094d\u092f \u0913\u0932\u0947\u0915\u094d\u091c\u093c\u0947\u0902\u0921\u0930 \u092e\u0947\u0930\u0947\u091c\u093c\u0915\u094b \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u0915\u094b \u0930\u0942\u0938 \u0915\u0947 \u0939\u0935\u093e\u0932\u0947 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u091d\u094c\u0924\u0947 \u092a\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0938\u0939\u092e\u0924 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u0935\u093e\u0932 \u0939\u0940 \u0928\u0939\u0940\u0902 \u092a\u0948\u0926\u093e \u0939\u094b\u0924\u093e. \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e, \"\u0939\u0930 \u0928\u091c\u093c\u0930\u093f\u090f \u0938\u0947 \u0939\u092e \u0938\u0939\u092e\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0947 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u0938\u0902\u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u0915\u093c\u093e\u0928\u0942\u0928 \u0915\u0947 \u0924\u0939\u0924 \u0907\u0938\u0915\u093e \u0938\u0935\u093e\u0932 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0909\u0920\u0924\u093e. \u0938\u0902\u0935\u093f\u0927\u093e\u0928 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0930\u0915\u093e\u0930 \u092f\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0