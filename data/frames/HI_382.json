u0924 \u092e\u0947\u0902 \u0907\u0928\u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u092d\u0940 \u0930\u0916\u093e \u0939\u0948\u0964 \u092f\u0939 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092a\u0941\u0930\u093e\u0928\u0947 \u0914\u0930 \u092e\u091c\u092c\u0942\u0924 \u0938\u0902\u092c\u0902\u0927\u094b\u0902 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948, \u092d\u0932\u0947 \u0939\u0940 \u092f\u0939 \u0915\u0941\u091b \u0905\u0928\u094d\u092f \u0936\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u091c\u0948\u0938\u0947 \u091a\u0940\u0928 \u0915\u094b \u0905\u0938\u0939\u091c \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0938\u0941\u0916\u094b\u0908-75, \u091c\u094b \u0905\u092a\u0928\u0947 \u0938\u094d\u091f\u0940\u0932\u094d\u0925 \u092b\u0940\u091a\u0930\u094d\u0938, \u0909\u0928\u094d\u0928\u0924 \u090f\u0935\u093f\u092f\u093e\u0928\u093f\u0915\u094d\u0938, \u090f\u0906\u0908 \u0924\u0915\u0928\u0940\u0915 \u0914\u0930 \u0915\u093f\u092b\u093e\u092f\u0924\u0940 \u0915\u0940\u092e\u0924 (\u0932\u0917\u092d\u0917 30-35 \u092e\u093f\u0932\u093f\u092f\u0928 \u0921\u0949\u0932\u0930) \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u090f\u092b-35 \u0938\u094d\u091f\u0940\u0932\u094d\u0925 \u091c\u0947\u091f \u0915\u093e \u090f\u0915 \u0938\u0940\u0927\u093e \u092a\u094d\u0930\u0924\u093f\u0926\u094d\u0935\u0902\u0926\u094d\u0935\u0940 \u0939\u0948, \u091c\u094b \u0909\u0938\u0938\u0947 \u0915\u093e\u092b\u0940 \u0938\u0938\u094d\u0924\u093e \u0939\u0948\u0964 \u0935\u093f\u092e\u093e\u0928 \u0915\u0940 \u0917\u0924\u093f (1.8 \u092e\u0948\u0915), 3,000 \u0915\u093f\u092e\u0940 \u0930\u0947\u0902\u091c \u0914\u0930 7.4 \u091f\u0928 \u0939