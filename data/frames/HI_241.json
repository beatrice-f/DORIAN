26\u094d\u0926\u094b\u0902 \u092a\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0939\u094b\u0917\u0940, \u0907\u0938\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0935\u094d\u0939\u093e\u0907\u091f \u0939\u093e\u0909\u0938 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0926\u0940 \u0917\u0908 \u0939\u0948. \u0907\u0938\u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948 \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u093e \u092e\u0941\u0926\u094d\u0926\u093e. \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u0928\u0947\u0936\u0928\u0932 \u0938\u093f\u0915\u094d\u092f\u094b\u0930\u093f\u091f\u0940 \u0915\u093e\u0909\u0902\u0938\u093f\u0932 \u0915\u0949\u0930\u094d\u0921\u093f\u0928\u0947\u091f\u0930 \u092b\u0949\u0930 \u0938\u094d\u091f\u094d\u0930\u0948\u091f\u091c\u093f\u0915 \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u0915\u0947\u0936\u0928 \u091c\u0949\u0928 \u0915\u093f\u0930\u094d\u092c\u0940 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0926\u094b\u0928\u094b\u0902 \u0928\u0947\u0924\u093e \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u0936\u093e\u0902\u0924\u093f \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0915\u094b \u0932\u0947\u0915\u0930 \u0915\u093f\u0938 \u0939\u0926 \u0924\u0915 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930\u0947\u0902\u0917\u0947, \u092e\u0948\u0902 \u0905\u092d\u0940 \u0928\u0939\u0940\u0902 \u0915\u0939 \u0938\u0915\u0924\u093e. \u092c\u0924\u093e \u0926\u0947\u0902 \u0915\u093f \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u094b \u092c\u093e\u0907\u0921\u0947\u0928 \u0914\u0930 \u092b\u0930\u094d\u0938\u094d\u091f \u0932\u0947\u0921\u0940 \u091c\u093f\u0932 \u092c\u093e\u0907\u0921\u0947\u0928 \u0915\u0947 \u0928\u094d\u092f\u094b\u0924\u0947 \u092a\u0930 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 24 \u0