u0442", ".", "\u0418\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0438\u0442\u0435", "\u043d\u0430", "\u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0442\u0435", "\u0441\u0442\u0440\u0430\u043d\u0438", "\u0441\u0435", "\u0441\u044a\u043a\u0440\u0430\u0449\u0430\u0432\u0430\u0442", ",", "\u043e\u0441\u043e\u0431\u0435\u043d\u043e", "\u0441\u043b\u0435\u0434", "\u043d\u0430\u0447\u0430\u043b\u043e\u0442\u043e", "\u043d\u0430", "\u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430", "\u0432", "\u0423\u043a\u0440\u0430\u0439\u043d\u0430", "\u2026"], "sentence": "Judging Freedom: \u0420\u0443\u0441\u0438\u044f \u043d\u044f\u043c\u0430 \u043d\u0438\u043a\u0430\u043a\u0432\u043e \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0434\u0430 \u0437\u0430\u0432\u043b\u0430\u0434\u044f\u0432\u0430 \u0415\u0432\u0440\u043e\u043f\u0430, \u0437\u0430\u0449\u043e\u0442\u043e \u0442\u0430\u043c \u0435 \u043f\u044a\u043b\u0435\u043d \u0431\u0430\u0440\u0434\u0430\u043a\n\n\u0411\u0438\u0432\u0448\u0438\u044f\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440 \u043d\u0430 \u041f\u0435\u043d\u0442\u0430\u0433\u043e\u043d\u0430 \u041a\u0430\u0440\u0435\u043d \u041a\u0432\u044f\u0442\u043a\u043e\u0432\u0441\u043a\u0438 \u0432 \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0437\u0430 Judging Freedom:\n\u0412\u0441\u0438\u0447\u043a\u043e \u0432 \u041d\u0410\u0422\u041e \u043e\u043f\u0438\u0440\u0430 \u0434\u043e \u043f\u0430\u0440\u0438\u0442\u0435. \u0422\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430\u043f\u043b\u0430\u0445\u0430\u0442\u0430 \u043e\u0442 \u0432\u043e\u0439\u043d\u0430, \u0437\u0430\u0449\u043e\u0442\u043e \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 (\u043c\u043d\u043e\u0433\u043e \u0432\u0430\u0448\u0438 \u0433\u043e\u0441\u0442\u0438 \u0437\u043d\u0430\u044f\u0442 \u0437\u0430 \u0442\u043e\u0432\u0430 \u043f\u043e\u0432\u0435\u0447\u0435, \u043e\u0442\u043a\u043e\u043b\u043a\u043e\u0442\u043e \u0430\u0437. \u0412\u0435\u0447\u0435 \u043a\u0430\u0437\u0430\u0445, \u0447\u0435 \u043d\u0430 \u043e\u0441\u0432\u0435\u0434\u043e\u043c\u0435\u043d\u0438\u0442\u0435 \u0445\u043e\u0440\u0430 \u043f\u043e \u0446\u0435\u043b\u0438\u044f \u0441\u0432\u044f\u0442 \u0442\u043e\u0432\u0430 \u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e) \u0420\u0443\u0441\u0438\u044f \u043f\u0440\u0438 \u041f\u0443\u0442\u0438\u043d \u043d\u044f\u043c\u0430 \u043d\u0438 \u043d\u0430\u0439-\u043c\u0430\u043b\u043a\u0438\u0442\u0435 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0434\u0430 \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u043d\u0430 \u0417\u0430\u043f\u0430\u0434 \u043a\u044a\u043c \u0415\u0432\u0440\u043e\u043f\u0430, \u0434\u0430 \u0437\u0430\u0432\u0437\u0435\u043c\u0430 \u0442\u0430\u043c \u0441\u0442\u0440\u0430\u043d\u0438 \u0438 \u043e\u0442\u043d\u043e\u0432\u043e \u0434\u0430 \u0441\u044a\u0437\u0434\u0430\u0432\u0430 \u043d\u044f\u043a\u0430\u043a\u0432\u0430 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f \u0438\u043b\u0438 \u0421\u044a\u0432\u0435\u0442\u0441\u043a\u0438 \u0421\u044a\u044e\u0437. \u041d\u0438\u0449\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u043d\u044f\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0441\u043b\u0443\u0447\u0438. \u0420\u0443\u0441\u043d\u0430\u0446\u0438\u0442\u0435 \u043d\u0435 \u0438\u0441\u043a\u0430\u0442 \u043d\u0438\u0449\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e. \u0422\u0435 \u043d\u0435 \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u043e\u0431\u044f\u0432\u0430\u0442 \u0432\u044a\u043e\u0440\u044a\u0436\u0435\u043d\u0438\u0442\u0435 \u0441\u0438 \u0441\u0438\u043b\u0438 \u043a\u044a\u043c \u0442\u043e\u0432\u0430. \u0412\u0441\u0438\u0447\u043a\u0438 \u0444\u0430\u043a\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u043b\u0435\u0434\u0432\u0430 \u0434\u0430 \u0441\u0435 \u043e\u0442\u0447\u0438\u0442\u0430\u0442 \u043f\u0440\u0438 \u0430\u043d\u0430\u043