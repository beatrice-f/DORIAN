", "8", "\u0434\u043e", "10", "%", "\u043e\u0442", "\u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438\u0442\u0435", "\u0435\u043c\u0438\u0441\u0438\u0438", "\u043d\u0430", "\u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u0438", "\u0433\u0430\u0437\u043e\u0432\u0435", ".", "\u0410\u043a\u043e", "\u0431\u0435\u0448\u0435", "\u0434\u044a\u0440\u0436\u0430\u0432\u0430", ",", "\u0449\u0435\u0448\u0435", "\u0434\u0430", "\u0441\u0435", "\u043d\u0430\u0440\u0435\u0434\u0438", "\u043d\u0430", "\u0442\u0440\u0435\u0442\u043e", "\u043c\u044f\u0441\u0442\u043e", "\u0441\u043b\u0435\u0434", "\u041a\u0438\u0442\u0430\u0439", "\u0438", "\u0421\u0410\u0429", "."], "sentence": "\u041d\u0430\u0434 780 \u043c\u0438\u043b\u0438\u043e\u043d\u0430 \u0434\u0443\u0448\u0438 \u0433\u043b\u0430\u0434\u0443\u0432\u0430\u0442\n\n783 \u043c\u0438\u043b\u0438\u043e\u043d\u0430 \u0434\u0443\u0448\u0438 \u043f\u043e \u0441\u0432\u0435\u0442\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u0442 \u043e\u0442 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u043d \u0433\u043b\u0430\u0434, \u0430 \u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430 \u043f\u0440\u043e\u0434\u043e\u0432\u043e\u043b\u0441\u0442\u0432\u0435\u043d\u0438\u0442\u0435 \u043a\u0440\u0438\u0437\u0438 \u0441\u0435 \u0437\u0430\u0434\u044a\u043b\u0431\u043e\u0447\u0430\u0432\u0430\u0442. \u0421\u044a\u0449\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0447\u043e\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043e\u0442\u043e \u0435 \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u0438\u043b\u043e 19 \u043d\u0430 \u0441\u0442\u043e, \u0438\u043b\u0438 1,13 \u043c\u0438\u043b\u0438\u0430\u0440\u0434\u0430 \u0442\u043e\u043d\u0430, \u043e\u0442 \u0445\u0440\u0430\u043d\u0430\u0442\u0430, \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0430 \u043f\u0440\u0435\u0437 2022 \u0433., \u043e\u0431\u044f\u0432\u0438 \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u043e\u0431\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0442\u0435 \u043d\u0430\u0446\u0438\u0438 \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0435\u043d \u0434\u043e\u043a\u043b\u0430\u0434. \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044a\u0442, \u0438\u0437\u0433\u043e\u0442\u0432\u0435\u043d \u043e\u0442 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u0442\u0430 \u043d\u0430 \u041e\u041e\u041d \u0437\u0430 \u043e\u043a\u043e\u043b\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0434\u0430, \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430 \u043d\u0430\u043f\u0440\u0435\u0434\u044a\u043a\u0430 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u043f\u043e \u0441\u0432\u0435\u0442\u0430 \u0437\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u0430\u043d\u0435 \u043d\u0430 \u0446\u0435\u043b\u0442\u0430 \u0434\u043e \u043a\u0440\u0430\u044f \u043d\u0430 \u0442\u043e\u0432\u0430 \u0434\u0435\u0441\u0435\u0442\u0438\u043b\u0435\u0442\u0438\u0435 \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u044f\u043d\u0435\u0442\u043e \u043d\u0430 \u0445\u0440\u0430\u043d\u0430 \u0434\u0430 \u043d\u0430\u043c\u0430\u043b\u0435\u0435 \u043d\u0430\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430. \u0411\u0440\u043e\u044f\u0442 \u043d\u0430 \u0434\u044a\u0440\u0436\u0430\u0432\u0438\u0442\u0435, \u043a\u043e\u0438\u0442\u043e \u0441\u044a\u043e\u0431\u0449\u0430\u0432\u0430\u0442 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0437\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0430, \u0441\u0435 \u0435 \u0443\u0434\u0432\u043e\u0438\u043b \u0441\u043f\u0440\u044f\u043c\u043e \u043f\u044a\u0440\u0432\u0438\u044f \u0434\u043e\u043a\u043b\u0430\u0434 \u043e\u0442 2021 \u0433. \u041f\u043e \u043d\u0435\u0433\u043e\u0432\u0438 \u0434\u0430\u043d\u043d\u0438 17% \u043e\u0442 \u0445\u0440\u0430\u043d\u0430\u0442\u0430, \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0430 \u043f\u0440\u0435\u0437 2019 \u0433., \u0435 \u0431\u0438\u043b\u0430 \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u0435\u043d\u0430. \u0422\u043e\u0432\u0430 \u0441\u0435 \u0440\u0430\u0432\u043d\u044f\u0432\u0430 \u043d\u0430 1,03 \u043c\u043b\u0440\u0434. \u0442\u043e\u043d\u0430 \u0445\u0440\u0430\u043d\u0430. \u0410\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043e\u0431\u0430\u0447\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u0432\u0430\u0442 \u0434\u0430 \u043d\u0435 \u0441\u0435 \u043f\u0440\u0430\u0432\u044f\u0442 \u043f\u0440\u0435\u043a\u0438 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f, \u0442\u044a\u0439 \u043a\u0430\u0442\u043e \u043e\u0442 \u043c\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0430\u043d\u0438 \u043d\u044f\u043c\u0430 \u0434\u043e\u0441\u0442\u0430\u0442\u044a\u0447\u043d\u043e \u0434\u0430\u043d\u043d\u0438. \u0412\u0441\u0435\u043a\u0438 \u0447\u043e\u0432\u0435\u043a \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u044f \u0433\u043e\u0434\u0438\u0448\u043d\u043e \u043e\u043a\u043e\u043b\u043e 79 \u043a\u0433 \u0445\u0440\u0430\u043d\u0430, \u043a\u043e\u0435\u0442\u043e \u0441\u0435 \u0440\u0430\u0432\u043d\u044f\u0432\u0430 \u043d\u0430 \u043f\u043e\u043d\u0435 1 \u043c\u0438\u043b\u0438\u0430\u0440\u0434 \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u0435\u043d\u0438 \u044f\u0441\u0442\u0438\u044f \u0434\u043d\u0435\u0432\u043d\u043e \u0432 \u0441\u0432\u0435\u0442\u0430. \u041f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430\u0442\u0430 \u0447\u0430\u0441\u0442 \u043e\u0442 \u043e\u0442\u043f\u0430\u0434\u044a\u0446\u0438\u0442\u0435 (60%) \u0441\u0430 \u043e\u0442 \u0434\u043e\u043c\u0430\u043a\u0438\u043d\u0441\u0442\u0432\u0430\u0442\u0430. \u041e\u043a\u043e\u043b\u043e 28 \u043d\u0430 \u0441\u0442\u043e \u043e\u0442 \u0442\u044f\u0445 \u0441\u0430 \u043e\u0442 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0442\u0430 \u0437\u0430 \u0445\u0440\u0430\u043d\u0435\u043d\u0435 \u0438\u043b\u0438 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0442\u0438\u0442\u0435, \u0430 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u043d\u043e 12 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0430 - \u043e\u0442 \u0442\u044a\u0440\u0433\u043e\u0432\u0446\u0438\u0442\u0435 \u043d\u0430 \u0434\u0440\u0435\u0431\u043d\u043e. \"\u0422\u043e\u0432\u0430 \u0435 \u043f\u0430\u0440\u043e\u0434\u0438\u044f\", \u043a\u043e\u043c\u0435\u043d\u0442\u0438\u0440\u0430 \u0441\u044a\u0430\u0432\u0442\u043e\u0440\u043a\u0430\u0442\u0430 \u043d\u0430 \u0434\u043e\u043a\u043b\u0430\u0434\u0430 \u041a\u043b\u0435\u043c\u044a\u043d\u0442\u0430\u0439\u043d \u041e'\u041a\u043e\u043d\u044a\u0440, \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440 \u043f\u043e \u0432\u044a\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u043d\u0430 \u0440\u0430\u0437\u0445\u0438\u0449\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0445\u0440\u0430\u043d\u0438 \u0432 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u0442\u0430 \u043d\u0430 \u041e\u041e\u041d \u0437\u0430 \u043e\u043a\u043e\u043b\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0434\u0430. \"\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044a\u0442 \u0435 \u0441\u043b\u043e\u0436\u0435\u043d, \u043d\u043e \u0447\u0440\u0435\u0437 \u0441\u044a\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0442\u043e\u0439 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u0440\u0435\u0448\u0435\u043d\", \u0438\u0437\u0440\u0430\u0437\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043e\u0441\u0442 \u0442\u044f. \u041d\u0430 \u0440\u0430\u0437\u0445\u0438\u0442\u0435\u043d\u0430\u0442\u0430 \u0445\u0440\u0430\u043d\u0430 \u0441\u0435 \u043f\u0430\u0434\u0430 \u0434\u044f\u043b \u043e\u0442 8 \u0434\u043e 10% \u043e\u0442 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438\u0442\u0435 \u0435\u043c\u0438\u0441\u0438\u0438 \u043d\u0430 \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u