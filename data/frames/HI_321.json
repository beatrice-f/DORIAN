939\u0948", "."], "sentence": "\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0915\u0940 \u0932\u0917\u093e\u0924\u093e\u0930 \u092c\u0922\u093c\u0924\n\n\u092e\u093e\u0930\u093f\u092f\u093e \u091c\u093c\u094b\u0932\u0915\u0940\u0928\u093e \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0927\u0940\u0930\u0947 \u0927\u0940\u0930\u0947 \u0915\u0930\u0915\u0947 \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e\u090f\u0902 \u0926\u094b\u0928\u0947\u0924\u094d\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u092d\u0940\u0924\u0930\u0940 \u0936\u0939\u0930\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0917\u0908 \u0939\u0948\u0902. \u0935\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0915\u0947\u0902\u0926\u094d\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902.\" \u0909\u0928\u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915\u093c, \u092a\u0915\u094d\u0930\u094c\u0938\u094d\u0915 \u0914\u0930 \u092c\u0941\u0917\u094d\u0932\u0947\u0921\u093e\u0930 \u092a\u0930 \u0915\u092c\u094d\u091c\u093c\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0926\u094b\u0928\u0947\u0924\u094d\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u0915\u094d\u0930\u0948\u092e\u094b\u0924\u094b\u0930 \u0914\u0930 \u092c\u0917\u0932\u093e\u0902\u0938\u094d\u0915 \u0936\u0939\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u0915\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0916\u0941\u0932 \u0917\u092f\u093e \u0939\u0948. \u0935\u0939\u093e\u0902 \u0938\u0947 \u0909\u0928\u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092a\u094d\u0930\u094b\u0935 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u091c\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u092a\u094d\u0930\u092e\u0941\u0916 \u0914\u0926\u094d\u092f\u094b\u0917\u093f\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0939\u0948. \u0935\u094b \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0910\u0938\u093e \u0939\u0941\u0906 \u0924\u094b 2022 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0906 \u091c\u093e\u090f\u0917\u0940.\" \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0928\u0947 \u091c\u0940\u0924 \u0915\u0940 \u091c\u094b \u092f\u094b\u091c\u0928\u093e \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0938\u093e\u0902\u0938\u0926\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092a\u0947\u0936 \u0915\u0940 \u0909\u0938\u0915\u0947 \u0915\u0908 \u092a\u0939\u0932\u0942 \u0939\u0948\u0902. \u090f\u0915 \u0924\u094b \u092f\u0939 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0928\u0947\u091f\u094b \u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0926\u0940 \u091c\u093e\u090f, \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0928\u0947\u091f\u094b \u0915\u0947 \u0938\u092d\u0940 \u0938\u0939\u092f\u094b\u0917\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948. \u0935\u0939\u0940\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0928\u0947\u091f\u094b \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0926\u0947\u0936\u094b\u0902 \u0915\u093e \u0930\u0942\u0938 \u0938\u0947 \u0938\u0940\u0927\u093e \u091f\u0915\u093