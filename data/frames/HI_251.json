0924\u093f\u092e \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u092a\u0930 \u0905\u092a\u0928\u0940 \u0938\u0915\u094d\u0930\u093f\u092f\u0924\u093e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936\u094b\u0902 \u092e\u0947\u0902 \u091c\u0941\u091f\u0947 \u0939\u0948\u0902\u0964\n\u0935\u094d\u0939\u093e\u0907\u091f \u0939\u093e\u0909\u0938 \u0915\u0940 \u092a\u094d\u0930\u0947\u0938 \u0938\u091a\u093f\u0935 \u0915\u0948\u0930\u093f\u0928 \u091c\u0940\u0928 \u092a\u093f\u092f\u0930\u0947 \u0928\u0947 \u090f\u0915 \u092c\u092f\u093e\u0928 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u0913\u0935\u0932 \u0911\u092b\u093f\u0938 (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f) \u092e\u0947\u0902 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u092f\u0939 \u092c\u0948\u0920\u0915 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u094b \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0939\u094b\u0917\u0940, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u0939 \u0930\u0942\u0938 \u0915\u0947 \u0906\u0915\u094d\u0930\u092e\u0923 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u091c\u0940\u0928-\u092a\u093f\u092f\u0930\u0947 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915, \u092c\u0948\u0920\u0915 \u092e\u0947\u0902 \u0907\u091c\u0930\u093e\u092f\u0932 \u0914\u0930 \u0939\u092e\u093e\u0938 \u0915\u0947 \u092c\u0940\u091a \u090f\u0915 \u092c\u0902\u0927\u0915 \u0938\u092e\u091d\u094c\u0924\u093e \u0914\u0930 \u0938\u0902\u0918\u0930\u094d\u0937-\u0935\u093f\u0930\u093e\u092e \u0915\u0930\u093e