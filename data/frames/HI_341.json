\u0928\u0940\u0924\u093f \u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u0947\u0938\u0930 \u0913\u0932\u094d\u0917\u093e \u0913\u0928\u0941\u091a \u0915\u0939\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0928\u0947 \u092f\u0939 \u092e\u0941\u0926\u094d\u0926\u093e \u0909\u0920\u093e\u092f\u093e \u0939\u0948 \u0915\u093f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u092f\u0942\u0915\u0947 \u0928\u0947 \u091c\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0907\u0938\u0930\u093e\u0907\u0932 \u0915\u0940 \u092e\u0926\u0926 \u0915\u0940 \u0909\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0930\u0942\u0938 \u0915\u0947 \u0939\u092e\u0932\u0947 \u0938\u0947 \u092c\u091a\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u092e\u0926\u0926 \u0928\u0939\u0940\u0902 \u0915\u0940. \u0935\u0947 \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0909\u0928\u0915\u0940 \u092c\u093e\u0924 \u0938\u091a \u0939\u0948. \u0907\u0938\u0930\u093e\u0907\u0932 \u0915\u094b \u0926\u0940 \u0917\u0908 \u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u092e\u093f\u0932\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u092e\u0947\u0902 \u0905\u0902\u0924\u0930 \u0939\u0948. \u0907\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 24 \u092b\u093c\u0930\u0935\u0930\u0940 2022 \u0915\u094b \u092d\u0940 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0925\u0940 \u0932\u0947\u0915\u093f\u0928 \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u0941\u0906, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u092f\u0942\u0915\u0947 \u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u0935\u094b \u09