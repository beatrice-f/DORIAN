ence": "\u0422\u0443\u0440\u0446\u0438\u044f: \u0418\u043c\u0430 \u0440\u0438\u0441\u043a \u043e\u0442 \u0422\u0440\u0435\u0442\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430 \u0432\u043e\u0439\u043d\u0430. \u0414\u044a\u0440\u0436\u0430\u0432\u0438\u0442\u0435 \u043f\u043e\u0434\u0433\u043e\u0442\u0432\u044f\u0442 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0442\u0430 \u0438 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430\u0442\u0430 \u0441\u0438\n\n\u0422\u0443\u0440\u0441\u043a\u0438\u044f\u0442 \u0432\u044a\u043d\u0448\u0435\u043d \u043c\u0438\u043d\u0438\u0441\u0442\u044a\u0440 \u0425\u0430\u043a\u0430\u043d \u0424\u0438\u0434\u0430\u043d \u0441\u043c\u044f\u0442\u0430, \u0447\u0435 \u0438\u043c\u0430 \u0440\u0438\u0441\u043a \u043e\u0442 \u043f\u0440\u0435\u0440\u0430\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u043e\u0435\u043d\u043d\u0438\u0442\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0438 \u0432 \u0413\u0430\u0437\u0430 \u0438 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0432 \"\u0422\u0440\u0435\u0442\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430 \u0432\u043e\u0439\u043d\u0430\", \u043f\u0440\u0435\u0434\u0430\u0434\u0435 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0442\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0442\u0443\u0440\u0441\u043a\u0438\u044f \u0432. \"\u0414\u0436\u0443\u043c\u0445\u0443\u0440\u0438\u0439\u0435\u0442\", \u0446\u0438\u0442\u0438\u0440\u0430 \u0424\u0440\u043e\u0433 \u0438 \u0411\u0422\u0410. \u0417\u0430\u043f\u0438\u0442\u0430\u043d \u0434\u0430\u043b\u0438 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0438\u0437\u0431\u0443\u0445\u043d\u0435 \"\u0422\u0440\u0435\u0442\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430 \u0432\u043e\u0439\u043d\u0430\", \u0424\u0438\u0434\u0430\u043d \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438 \u0432 \u043f\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u