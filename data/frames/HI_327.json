u093f \u092f\u0939 \u0921\u094d\u0930\u094b\u0928 \u0905\u092a\u0928\u0940 \u0930\u093e\u0939 \u0938\u0947 \u092d\u091f\u0915 \u0917\u092f\u093e \u0925\u093e\u0964 \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u091c\u094b \u0926\u0942\u0938\u0930\u0940 \u0938\u092b\u0947\u0926 \u0932\u0915\u0940\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947 \u0930\u0939\u0940 \u0925\u0940, \u0935\u0939 \u0936\u093e\u092f\u0926 \u0930\u0942\u0938\u0940 \u090f\u0938\u092f\u0942-57 \u0935\u093f\u092e\u093e\u0928 \u0938\u0947 \u0906 \u0930\u0939\u0940 \u0925\u0940\u0964\n\u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0926\u093f\u0916\u093e\u0908 \u0926\u0947 \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u0930\u0942\u0938\u0940 \u0935\u093f\u092e\u093e\u0928 \u0913\u0916\u094b\u0924\u094d\u0928\u093f\u0915 \u0921\u094d\u0930\u094b\u0928 \u0915\u094b \u092e\u093e\u0930 \u0917\u093f\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0915\u093e \u092a\u0940\u091b\u093e \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0938\u0902\u092d\u0935\u0924\u0903, \u0930\u0942\u0938\u0940 \u0935\u093f\u092e\u093e\u0928 \u0921\u094d\u0930\u094b\u0928 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947, \u091c\u094b \u0936\u093e\u092f\u0926 \u0905\u092a\u0928\u0947 \u092e\u093e\u0930\u094d\u0917 \u0938\u0947 \u092d\u091f\u0915 \u091a\u0941\u0915\u093e \u0925\u093e\u0964 \u091a\u0942\u0902\u0915\u093f \u092f\u0939 \u0926\u094b\u0928\u094b\u0902 \u0935\u093f\u092e\u093e\u0928 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0909\u0921\u093c \u0930\u0939\u0947 \u0925\u0947, \u092f\u0939 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u091c\u0924\u093e\u0908 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948 \u0915\u093f \u0921\u094d\u0930\u094b\u0928 \u0915\u094b \u0926\u0941\u0936\u094d\u092e\u0928 \u0915\u0947 \u0939\u093e\u0925\u094b\u0902 \u092e\u0947\u0902 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0947 \u0928\u0937\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u093f\u092f\u093e \u0917\u092f\u093e\u0964\n\u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0928 \u0924\u094b \u0930\u0942\u0938 \u0914\u0930 \u0928 \u0939\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0928\u0947 \u0915\u094b\u0938\u094d\u0924\u093f\u092f\u093e\u0924\u093f\u0928\u094d\u0935\u093f\u0915\u093e \u0915\u0947 \u0928\u091c\u093c\u0926\u0940\u0915 \u0907\u0938 \u0918\u091f\u0928\u093e \u092a\u0930 \u0915\u094b\u0908 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u092f\u093e\u0928 \u091c\u093e\u0930\u0940 \u0915\u093f\u092f\u093e \u0939\u0948, \u092b\u093f\u0930 \u092d\u0940 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u094b\u0902 \u0915\u093e \u092e\u093e\u0928\u0928\u093e \u0939\u0948 \u0915\u093f \u0930\u0942\u0938 \u0915\u0947 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u093e \u0913\u0916\u094b\u0924\u094d\u0928\u093f\u0915 \u0921\u094d\u0930\u094b\u0928 \u092a\u0930 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0916\u094b \u0917\u092f\u093e \u0925\u093e\u0964 \u0910\u0938\u093e \u0938\u0902\u092d\u0935\u0924\u0903 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0935\u0949\u0930\u092b\u0947\u092f\u0930 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0947 \u091c\u0948\u092e\u0930 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0939\u0941\u0906 \u0939\u094b\u0917\u093e, \u091c\u093f\u0938\u0928\u0947 \u0921\u094d\u0930\u094b\u0928 \u0915\u0947 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0914\u0930 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u093f\u092f\u093e\u0964\n\u0907\u0938 \u0918\u091f