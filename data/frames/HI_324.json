u0936\u0928\u0932 \u092e\u0949\u0932 \u0915\u0940 \u0918\u093e\u0938 \u092a\u0930 \u092c\u0948\u0920\u0947 \u0926\u093f\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0915\u0941\u091b \u0932\u094b\u0917 \u0928\u0915\u0932\u0940 \u092a\u0948\u0930\u094b\u0902 \u0915\u0947 \u0938\u0939\u093e\u0930\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092a\u094d\u0930\u094b\u0938\u094d\u0925\u0947\u091f\u093f\u0915 \u0930\u0928\u093f\u0902\u0917 \u092c\u094d\u0932\u0947\u0921 \u0915\u0947 \u092b\u0940\u0924\u0947 \u092c\u093e\u0902\u0927 \u0930\u0939\u0947 \u0925\u0947. \u0907\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0930\u093e\u091c\u0927\u093e\u0928\u0940 \u0915\u0947 \u092c\u0940\u091a\u094b\u0902 \u092c\u0940\u091a \u0926\u0938 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0915\u0940 \u090f\u0915 \u0930\u0947\u0938 \u092e\u0947\u0902 \u0939\u093f\u0938\u094d\u0938\u093e \u0932\u0947\u0928\u093e \u0925\u093e. \u092f\u0947 \u0932\u094b\u0917 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u091d\u0902\u0921\u0947 \u0915\u0947 \u0930\u0902\u0917 \u0915\u0940 \u092a\u094b\u0936\u093e\u0915 \u092a\u0939\u0928\u0947 \u0939\u0941\u090f \u0925\u0947. \u092f\u0939\u093e\u0902 \u091c\u093f\u0924\u0928\u0947 \u0932\u094b\u0917 \u091c\u092e\u093e \u0925\u0947 \u0935\u094b \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0918\u093e\u092f\u0932 \u0939\u0941\u090f \u0939\u0948\u0902. \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u0907\u092f\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u0947 \u0905\u0902\u0917 \u0917\u0902\u0935\u093e\u0928\u0947 \u092a\u0921\u093c\u0947 \u0939\u0948\u0902. \u0926\u092e\u093f\u0924\u094d\u0930\u094b \u0915\u092e\u0947\u0928\u0938\u094d\u091a\u093f\u0915 \u0905\u092a\u0928\u0940 \u0930\u0928\u093f\u0902\u0917 \u0936\u0930\u094d\u091f \u0938\u0902\u092d\u093e\u0932 \u