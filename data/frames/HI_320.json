091c\u093c\u093e", "\u0915\u0930", "\u0932\u093f\u092f\u093e", "\u0914\u0930", "\u0930\u0942\u0938\u0940", "\u0938\u0947\u0928\u093e\u090f\u0902", "\u092a\u0942\u0930\u094d\u0935\u0940", "\u092f\u0942\u0915\u094d\u0930\u0947\u0928", "\u092e\u0947\u0902", "\u0918\u0941\u0938", "\u0906\u0908\u0902", "."], "sentence": "\u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u091c\u0902\u0917 \u0915\u0947 \u0939\u093e\u0932\u093e\u0924\n\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e \u0914\u0930 \u0915\u0940\u090f\u0935 \u0938\u094d\u0925\u093f\u0924 \u0925\u093f\u0915\u091f\u0948\u0902\u0915 \u0921\u0947\u092e\u094b\u0915\u094d\u0930\u0947\u091f\u093f\u0915 \u0907\u0928\u0940\u0936\u093f\u090f\u091f\u093f\u0935 \u092b\u093c\u093e\u0909\u0902\u0921\u0947\u0936\u0928 \u092e\u0947\u0902 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0938\u0902\u0918\u0930\u094d\u0937 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0905\u0927\u094d\u092f\u092f\u0928 \u0915\u0940 \u092a\u094d\u0930\u092e\u0941\u0916 \u092e\u093e\u0930\u093f\u092f\u093e \u091c\u093c\u094b\u0932\u0915\u0940\u0928\u093e \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093f\u0938\u0940 \u0915\u093c\u0940\u092e\u0924 \u092a\u0930 \u0938\u092e\u0930\u094d\u092a\u0923 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0917\u093e, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0930\u0942\u0938 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0938\u0930\u0915\u093e\u0930 \u0915\u093e \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935 \u092e\u093f\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948.\" \u0935\u094b \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u092e\u0917\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0915\u0908 \u0938\u0939\u092f\u094b\u0917\u0940 \u0926\u0947\u0936\u094b\u0902 \u0915\u0940, \u0916\u093c\u093e\u0938 \u0924\u094c\u0930 \u092a\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 \u092f\u0939 \u0938\u094b\u091a \u0939\u0948 \u0915\u093f \u0938\u093e\u092e\u0930\u093f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u092f\u0941\u0926\u094d\u0927\u0935\u093f\u0930\u093e\u092e \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u092a\u0930 \u0935\u093f\u091a\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948.\" \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e, \u091c\u093f\u0938\u0947 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u092e\u0941\u0926\u093e\u092f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092e\u093e\u0928\u0924\u093e \u0939\u0948 \u0909\u0938 \u092a\u0930 \u0930\u0942\u0938 \u0928\u0947 2014 \u092e\u0947\u0902 \u0915\u092c\u094d\u091c\u093c\u093e \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u093e \u0932\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u092b\u093f\u0930 2022 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092a\u0930 \u0939\u092e\u0932\u093e \u0915\u0930 \u0926\u093f\u092f\u093e. \u0915\u0908 \u0938\u093e\u0932\u094b\u0902 \u0938\u0947 \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0926\u093e\u0935\u093e \u0915\u0930\u0924\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0915\u093f \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0930\u0942\u0938 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0930\u0939\u093e \u0939\u0948 \u0907\u0938\u0932\u093f\u090f \u0935\u094b \u0909\u0938\u0947 \u090f\u0915 \u0905\u0932\u0917 \u0926\u0947\u0936 \u0928\u0939\u0940\u0902 \u092e\u093e\u0928\u0924\u0947. \u092e\u093e\u0930\u093f\u092f\u093e \u091c\u093c\u094b\u0932\u0915\u0940\u0928\u093e \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u0930\u0942\u0938 \u0915\u0947 \u0932\u093f\u090f \u091c\u0940\u0924 \u0915\u093e \u092e\u0924\u0932\u092c \u092f\u0939 \u0939\u0948 \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u090f\u0915 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0926\u0947\u0936 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925 \u0939\u094b \u091c\u093e\u090f. \u0935\u094b \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0930\u0942\u0938 \u0915\u093e \u092e\u0915\u093c\u0938\u0926 \u0905\u092d\u0940 \u092d\u0940 \u0935\u0939\u0940 \u0939\u0948. \u0935\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0936\u0939\u0930\u094b\u0902 \u0915\u094b, \u0910\u0938\u093e \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u0939\u093e\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0930\u0939\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u094b \u091c\u093e\u090f. \u0916\u093c\u093e\u0938 \u0924\u094c\u0930 \u092a\u0930 \u0938\u0930\u094d\u0926\u0940 \u0915\u0947 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902.\" \u092e\u093e\u0930\u093f\u092f\u093e \u091c\u093c\u094b\u0932\u0915\u0940\u0928\u093e \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915, \u0905\u0917\u0938\u094d\u0924 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0928\u0947 \u0915\u0941\u0930\u094d\u0938\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0930\u0942\u0938\u0940 \u0907\u0932\u093e\u0915\u094b\u0902 \u092a\u0930 \u0939\u092e\u0932\u093e \u0915\u0930\u0915\u0947 \u0909\u0928 \u092a\u0930 \u0915\u092c\u094d\u091c\u093c\u093e \u091c\u092e\u0