40\u043a\u0435\u0442 \u0441\u0433\u043e\u0440\u0435\u043b \u0432 \u0414\u043e\u043d\u0435\u0446\u043a\u0435 \u043f\u043e\u0441\u043b\u0435 \u043e\u0431\u0441\u0442\u0440\u0435\u043b\u0430 \u0412\u0421\u0423\n\n\u041f\u043e \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0434\u0430\u043d\u043d\u044b\u043c, \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0435 \u0431\u043e\u0435\u0432\u0438\u043a\u0438 \u043d\u0430\u043d\u043e\u0441\u0438\u043b\u0438 \u0443\u0434\u0430\u0440\u044b \u0441\u043d\u0430\u0440\u044f\u0434\u0430\u043c\u0438 \u0438\u0437 \u0420\u0421\u0417\u041e HIMARS. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442 \u0432 \u041a\u0438\u0435\u0432\u0441\u043a\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435 \u0414\u043e\u043d\u0435\u0446\u043a\u0430 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0430\u0442\u0430\u043a\u0438 \u0431\u043e\u0435\u0432\u0438\u043a\u043e\u0432 \u0430\u0440\u043c\u0438\u0438 \u0423\u043a\u0440\u0430\u0438\u043d\u044b. \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0433\u043e \u043e\u0431\u0441\u0442\u0440\u0435\u043b\u0430 \u043a\u0438\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 5-tv.ru. \u041a\u0430\u043a \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b \u043a\u043e\u0440\u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442 \u00ab\u0418\u0437\u0432\u0435\u0441\u0442\u0438\u0439\u00bb \u0415\u0432\u0433\u0435\u043d\u0438\u0439 \u0411\u044b\u043a\u043e\u0432\u0441\u043a\u0438\u0439, \u043c\u043e\u0449\u043d\u044b\u0435 \u0432\u0437\u0440\u044b\u0432\u044b \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0438\u0441\u044c \u0443\u0442\u0440\u043e\u043c \u0432 \u0414\u043e\u043d\u0435\u0446\u043a\u0435. \u0423\u0434\u0430\u0440 \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u0438\u0448\u0435\u043b\u0441\u044f \u043f\u043e \u041f\u0435\u0440\u0432\u043e\u043c\u0443 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u043c\u0443 \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442\u0443, \u043a\u0440\u0443\u043f\u043d\u043e\u043c\u0443, \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435. \u041d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438 \u041c\u0427\u0421 \u0420\u043e\u0441\u0441\u0438\u0438, \u043e\u043d\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u043b\u0438\u043a\u0432\u0438\u0434\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043e\u0433\u043e\u043d\u044c. \u00ab\u041c\u0430\u0433\u0430\u0437\u0438\u043d, \u043f\u043e \u0441\u0443\u0442\u0438, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d. \u0421\u043b\u043e\u0436\u0435\u043d\u0430 \u043a\u0440\u044b\u0448\u0430. \u0412\u044b\u0431\u0438\u0442\u044b \u0441\u0442\u0435\u043d\u044b. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u0433\u043e\u0440\u0435\u043d\u0438\u0435 \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0430\u043c\u043e\u0433\u043e \u0437\u0434\u0430\u043d\u0438\u044f. \u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043f\u043e\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0438\u0445 \u043d\u0435\u0442\u00bb, \u2014 \u0441\u043a\u0430\u0437\u0430\u043b \u043e\u043d. \u0411\u044b\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u0434\u043e\u0431\u0430\u0432\u