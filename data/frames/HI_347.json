entence": "\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0932\u0947\u0915\u0930 \u0932\u0917\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u091a\u0940\u0928 \u0930\u0942\u0938 \u0915\u0940 \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948? \u092c\u0940\u091c\u093f\u0902\u0917 \u092e\u0947\u0902 \u0939\u0941\u0908 \u090f\u0915 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0930\u0942\u0938 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0914\u0930 \u091a\u0940\u0928 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0936\u0940 \u091c\u093f\u0928\u092a\u093f\u0902\u0917 \u0928\u0947 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092e\u091c\u093c\u092c\u0942\u0924 \u0930\u093f\u0936\u094d\u0924\u094b\u0902 \u0915\u0940 \u0938\u0930\u093e\u0939\u0928\u093e \u0915\u0940 \u0939\u0948. \u092b\u093c\u0930\u0935\u0930\u0940 2022 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092a\u0930 \u0930\u0942\u0938 \u0915\u0947 \u0906\u0915\u094d\u0930\u092e\u0923 \u0915\u0947 \u092c\u093e\u0926 \u092f\u0947 \u0926\u094b\u0928\u094b\u0902 \u0928\u0947\u0924\u093e\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u091a\u094c\u0925\u0940 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u0939\u0948. \u0907\u0938 \u0926\u094c\u0930\u093e\u0928, \u091a\u0940\u0928 \u0930\u0942\u0938 \u0915\u093e \u0905\u0939\u092e \u0938\u0939\u092f\u094b\u0917\u0940 \u092c\u0928 \u0917\u092f\u093e \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0930\u0942\u0938 \u092a\u0930 \u0932\u0917\u093e\u090f \u0917\u090f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u0905\u0928\u094d\u092f \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092d\u093e\u0935 \u0915\u094b \u091a\u0940\u0928 \u0915\u092e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948. \u0915\u094d\u092f\u093e \u091a\u0940\u0928 \u0930\u0942\u0938 \u0915\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948? \u0930\u0942\u0938 \u0915\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u092e\u0941\u0939\u0948\u092f\u093e \u0915\u0930\u093e\u0928\u0947 \u0915\u0947 \u0906\u0930\u094b\u092a\u094b\u0902 \u0915\u0947 \u091a\u0940\u0928 \u0915\u0908 \u092c\u093e\u0930 \u0928\u0915\u093e\u0930 \u091a\u0941\u0915\u093e \u0939\u0948. \u092c\u0940\u092c\u0940\u0938\u0940 \u0915\u094b \u0926\u093f\u090f \u090f\u0915 \u0907\u0902\u091f\u0930\u0935\u094d\u092f\u0942 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u0940 \u090f\u0902\u091f\u0928\u0940 \u092c\u094d\u0932\u093f\u0902\u0915\u0928 \u0928\u0947 \u0915\u0939\u093e \u0925\u093e,\"\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u0932\u093f\u090f \u091a\u0940\u0928 \u0930\u0942\u0938 \u0915\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0939\u0925\u093f\u092f\u093e\u0930 \u092e\u0941\u0939\u0948\u092f\u093e \u0915\u0930\u093e \u0930\u0939\u093e \u0939\u094b, \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0930\u0939\u093e \u0939\u0948.\" \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u091a\u0940\u0928 \u092a\u0930 \u0906\u0930\u094b\u092a \u0939\u0948 \u0915\u093f \u0935\u0939 \u0930\u0942\u0938 \u0915\u094b \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0909\u092a\u0915\u0930\u0923 \u092e\u0941\u0939\u0948\u092f\u093e \u0915\u0930\u093e \u0930\u0939\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0938\u0947 \u0930\u0942\u0938 \u0915\u094b \u0905\u092a\u0928\u0940 \u2018\u092f\u0941\u0926\u094d\u0927 \u092e\u0936\u0940\u0928\u2019 \u092f\u093e\u0928\u0940 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b \u0930\u0939\u0947 \u092d\u093e\u0930\u0940 \u0939\u0925\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u092e\u0947\u0902 \u092e\u0926\u0926 \u092e\u093f\u0932 \u0930\u0939\u0940 \u0939\u0948. \u092c\u094d\u0932\u093f\u0902\u0915\u0928 \u0928\u0947 \u0915\u0939\u093e, \"\u0914\u0930 \u0939\u0925\u093f\u092f\u093e\u0930, \u091f\u0948\u0902\u0915, \u092c\u0916\u094d\u0924\u0930\u092c\u0902\u0926 \u0917\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0914\u0930 \u092e\u093f\u0938\u093e\u0907\u0932\u094b\u0902 \u092c\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u0907\u0928 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0938\u0947 \u0930\u0942\u0938 \u0915\u094b \u0915\u093e\u092b\u0940 \u092e\u0926\u0926 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948.\" \u0915\u093c\u0930\u0940\u092c 70 \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u092e\u0936\u0940\u0928 \u0909\u092a\u0915\u0930\u0923 \u0914\u0930 90 \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u092e\u093e\u0907\u0915\u094d\u0930\u094b \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u091c\u094b \u0930\u0942\u0938 \u0906\u092f\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0935\u0939 \u091a\u0940\u0928 \u0938\u0947 \u0939\u0940 \u0906\u0924\u0947 \u0939\u0948\u0902. \u092e\u0908 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0928\u0947 \u091a\u0940\u0928 \u0914\u0930 \u0939\u0949\u0928\u094d\u0917 \u0915\u0949\u0928\u094d\u0917 \u0938\u094d\u0925\u093f\u0924 20 \u0915\u0902\u092a\u0928\u093f\u092f\u094b\u0902 \u0915\u094b \u0928\u093f\u0936\u093e\u0928\u0947 \u092a\u0930 \u0932\u0947\u0924\u0947 \u0939\u0941\u090f \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u094b\u0902 \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0915\u0940 \u0925\u0940. \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u092e\u09