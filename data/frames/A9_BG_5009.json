8 \u0443\u0434\u0430\u0440\u0438 \u043f\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u044f\u0449\u0438 \u043e\u0440\u044a\u0436\u0438\u0435 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430\n\u0423\u0434\u0430\u0440\u0438\u0442\u0435 \u043f\u043e \u0440\u0443\u0441\u043a\u0430 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u044f \u0441 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u0442\u043e \u043d\u0430 \u0437\u0430\u043f\u0430\u0434\u043d\u0438 \u0441\u0442\u0440\u0430\u043d\u0438 \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430\u0442, \u0447\u0435 \u0442\u0435 \u0441\u0430 \u0432 \u043f\u0440\u044f\u043a\u0430 \u0432\u043e\u0439\u043d\u0430 \u0441 \u0420\u0443\u0441\u0438\u044f \u0438 \u041c\u043e\u0441\u043a\u0432\u0430 \u0449\u0435 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438. \u0422\u043e\u0432\u0430 \u0437\u0430\u044f\u0432\u0438 \u0440\u0443\u0441\u043a\u0438\u044f\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u043d\u0430 \u0441\u0440\u0435\u0449\u0430, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0438\u0440\u0430\u043d\u0430 \u043e\u0442 \u0422\u0410\u0421\u0421, \u0441 \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u043d\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u0438 \u0430\u0433\u0435\u043d\u0446\u0438\u0438. \"\u0412 \u043a\u0440\u0430\u0439\u043d\u0430 \u0441\u043c\u0435\u0442\u043a\u0430, \u0430\u043a\u043e \u0432\u0438\u0434\u0438\u043c, \u0447\u0435 \u0442\u0435\u0437\u0438 \u0441\u0442\u0440\u0430\u043d\u0438 \u0441\u0435 \u0432\u044a\u0432\u043b\u0438\u0447\u0430\u0442 \u0432\u044a\u0432 \u0432\u043e\u0439\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0449\u0443 \u043d\u0430\u0441 - \u0430 \u0442\u043e\u0432\u0430 \u0435 \u0438 \u043f\u0440\u044f\u043a\u043e\u0442\u043e \u0438\u043c \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432\u044a\u0432 \u0432\u043e\u0439\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0449\u0443 \u0420\u0443\u0441\u043a\u0430\u0442\u0430 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f, \u0442\u043e\u0433\u0430\u0432\u0430 \u0441\u0438 \u0437\u0430\u043f\u0430\u0437\u0432\u0430\u043c\u0435 \u043f\u0440\u0430\u0432\u043e\u0442\u043e \u0434\u0430 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u0435\u043c\u0435\u043c \u043e\u0442\u0432\u0435\u043d\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u0422\u043e\u0432\u0430 \u0435 \u043f\u044a\u0442\u044f\u0442 \u043a\u044a\u043c \u0441\u0435\u0440\u0438\u043e\u0437\u043d\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438\", \u043a\u0430\u0437\u0430 \u041f\u0443\u0442\u0438\u043d. \u0420\u0443\u0441\u0438\u044f \u043c\u043e\u0436\u0435 \u0434\u0430 \u0438\u0437\u043f\u0440\u0430\u0442\u0438 \u0434\u0430\u043b\u0435\u043a\u043e\u0431\u043e\u0439\u043d\u0438 \u043e\u0440\u044a\u0436\u0438\u044f \u0432 \u0440\u0435\u0433\u0438\u043e\u043d\u0438 \u043f\u043e \u0441\u0432\u0435\u0442\u0430, \u043e\u0442\u043a\u044a\u0434\u0435\u0442\u043e \u0434\u0430 \u0431\u044a\u0434\u0430\u0442 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438 \u0443\u0434\u0430\u0440\u0438 \u043f\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u044f\u0449\u0438 \u043e\u0440\u044a\u0436\u0438\u0435 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u043f\u043e\u0434\u0447\u0435\u0440\u0442\u0430 \u0440\u0443\u0441\u043a\u0438\u044f\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442. \"\u041c\u0438\u0441\u043b\u0438\u043c \u0437\u0430 \u0444\u0430\u043a\u0442\u0430, \u0447\u0435 \u0430\u043a\u043e \u043d\u044f\u043a\u043e\u0439 \u0441\u043c\u044f\u0442\u0430 \u0437\u0430 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e \u0434\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u044f \u0442\u0430\u043a\u0438\u0432\u0430 \u043e\u0440\u044a\u0436\u0438\u044f \