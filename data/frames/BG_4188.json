\u0439\u043a\u0438 \u0441\u0435 \u0434\u043d\u0435\u0441 \u0432 \u0433\u0435\u0440\u043c\u0430\u043d\u0441\u043a\u0438\u044f \u0411\u0443\u043d\u0434\u0435\u0441\u0442\u0430\u0433, \u0437\u0430\u044f\u0432\u0438, \u0447\u0435 \u041a\u0438\u0435\u0432 \u043d\u0438\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430\u043b\u043e \u0434\u0430 \u043f\u0440\u0430\u0432\u0438 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0438 \u0441 \u0420\u0443\u0441\u0438\u044f\n\n\u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438, \u0438\u0437\u043a\u0430\u0437\u0432\u0430\u0439\u043a\u0438 \u0441\u0435 \u0434\u043d\u0435\u0441 \u0432 \u0433\u0435\u0440\u043c\u0430\u043d\u0441\u043a\u0438\u044f \u0411\u0443\u043d\u0434\u0435\u0441\u0442\u0430\u0433, \u0437\u0430\u044f\u0432\u0438, \u0447\u0435 \u041a\u0438\u0435\u0432 \u043d\u0438\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430\u043b\u043e \u0434\u0430 \u043f\u0440\u0430\u0432\u0438 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0438 \u0441 \u0420\u0443\u0441\u0438\u044f. \u0421\u043f\u043e\u0440\u0435\u0434 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0432\u0440\u0435\u043c\u0435\u0442\u043e \u0437\u0430 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0438 \u0431\u0438\u043b\u043e \u043c\u0438\u043d\u0430\u043b\u043e. \u041f\u043e \u0432\u0440\u0435\u043c\u0435 \u043d\u0430 \u0440\u0435\u0447\u0442\u0430 \u0441\u0438 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0441\u044a\u0449\u043e \u043f\u043e\u0438\u0441\u043a\u0430 \u0438\u0437\u0437\u0435\u043c\u0432\u0430\u043d\u0435 \u043d\u0430 \u0440\u0443\u0441\u043a\u0438 \u0430\u043a\u0442\u0438\u0432\u0438 \u0437\u0430 \u0432\u044a\u0437\u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430. \u0422\u043e\u0439 \u043e\u0442\u043d\u043e\u0432\u043e \u043f\u043e\u0434\u0447\u0435\u0440\u0442\u0430, \u0447\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044a\u0442 \u0442\u0440\