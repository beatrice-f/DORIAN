e\u043c\u043e\u0449\u044c \u0423\u043a\u0440\u0430\u0438\u043d\u0435 \u0438 \u0440\u0430\u0441\u0445\u043e\u0434\u044b \u043d\u0430 \u043e\u0431\u043e\u0440\u043e\u043d\u0443, \u0447\u0442\u043e\u0431\u044b \u00ab\u043c\u043d\u043e\u0436\u0438\u0442\u044c \u043a\u043e\u0440\u0440\u0443\u043f\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0441\u0445\u0435\u043c\u044b\u00bb \u0432 \u0441\u0444\u0435\u0440\u0435 \u0432\u043e\u0435\u043d\u043d\u043e-\u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 (\u0412\u041f\u041a). \u041e\u0431 \u044d\u0442\u043e\u043c\n\n\u0432 \u0431\u0435\u0441\u0435\u0434\u0435 \u0441 \u00ab\u0420\u0438\u0434\u0443\u0441\u043e\u043c\u00bb. \u041f\u043e \u043c\u043d\u0435\u043d\u0438\u044e \u0434\u0435\u043f\u0443\u0442\u0430\u0442\u0430, \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u043e\u0431\u043e\u0433\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0417\u0430\u043f\u0430\u0434 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u043e\u0433\u043e , \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0441\u043a\u0438\u0439 \u0441\u0440\u043e\u043a \u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u0439 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0438\u0441\u0442\u0435\u043a \u0432 \u043c\u0430\u0435. \u00ab\u041d\u0430 \u043c\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434, \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438\u0439, \u0443\u0442\u0440\u0430\u0442\u0438\u0432 \u043b\u0435\u0433\u0438\u0442\u0438\u043c\u043d\u043e\u0441\u0442\u044c, \u0441\u0442\u0430\u043b \u043