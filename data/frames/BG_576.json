 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0437\u0430\u044f\u0432\u0438, \u0447\u0435 \u0435 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0434\u0430 \u0441\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u0440\u0443\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430. \u00ab\u041d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0435 \u0434\u0430 \u0441\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u0440\u0443\u0441\u043a\u0438 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430\u00bb, \u0442\u043e\u0432\u0430 \u0437\u0430\u044f\u0432\u0438 \u0441\u044a\u043f\u0440\u0443\u0433\u0430\u0442\u0430 \u043d\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0415\u043b\u0435\u043d\u0430 \u0432 \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0437\u0430 The Telegraph. \u201e\u0421\u0435\u0433\u0430 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044f\u0442\u0430 \u0435 \u043e\u0431\u0440\u0430\u0442\u043d\u0430\u0442\u0430 \u2013 \u0431\u0435\u0437 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u043d\u0435 \u043c\u043e\u0436\u0435\u0448 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0448 \u043d\u0438\u0449\u043e \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430, \u0441\u0435\u0433\u0430 \u0435 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0434\u0430 \u0441\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u043d\u0430 \u0440\u0443\u0441\u043a\u0438 \u0435\u0437\u0438\u043a, \u0437\u0430\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u043e \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u0448 \u043d\u0430 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u044f\u201c, \u0437\u0430\u044f\u0432\u0438 \u0442\u044f \u043f\u0440\u0435\u0434 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u0442\u0435. \u0421\u043f\u043e\u0440\u0435\u0434 \u043d\u0435\u044f \u0442\u044f \u0441\u0435 \u043e\u043f\u0438\u0442\u0432\u0430 \u0434\u0430 \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u043f\u043e\u0432\u0435\u0447\u0435 \u0440\u0443\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u043a\u044a\u0434\u0435\u0442\u043e \u0438 \u0434\u0430 \u0435 \u0438 \u0441\u0447\u0438\u0442\u0430, \u0447\u0435 \u0434\u0440\u0443\u0433\u0438\u0442\u0435 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u0438 \u0441\u044a\u0449\u043e \u043d\u0435 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0442\u043e\u0437\u0438 \u0435\u0437\u0438\u043a. \u0421\u043b\u0435\u0434 \u0434\u044a\u0440\u0436\u0430\u0432\u043d\u0438\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0430 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043f\u0440\u0435\u0437 2014 \u0433\u043e\u0434\u0438\u043d\u0430 \u0432\u043b\u0430\u0441\u0442\u0438\u0442\u0435 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0437\u0430\u043f\u043e\u0447\u043d\u0430\u0445\u0430 \u0434\u0430 \u0441\u0435 \u0431\u043e\u0440\u044f\u0442 \u043d\u0435 \u0441\u0430\u043c\u043e \u0441\u044a\u0441 \u0441\u044a\u0432\u0435\u0442\u0441\u043a\u0430\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043d\u043e \u0438 \u0441 \u0432\u0441\u0438\u0447\u043a\u043e, \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u043e \u0441 \u0420\u0443\u0441\u0438\u044f \u0438 \u0440\u0443\u0441\u043a\u0438\u044f \u0435\u0437\u0438\u043a. \u041f\u0440\u0435\u0437 2019 \u0433\u043e\u0434\u0438\u043d\u0430 \u0412\u044a\u0440\u0445\u043e\u0432\u043d\u0430\u0442\u0430 \u0440\u0430\u0434\u0430 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043f\u0440\u0438\u0435 \u0437\u0430\u043a\u043e\u043d \u201e\u0417\u0430 \u043e\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u0432\u0430\u043d\u0435 \u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u044f \u0435\u0437\u0438\u043a \u043a\u0430\u0442\u043e \u0434\u044a\u0440\u0436\u0430\u0432\u0435\u043d\u201c. \u0422\u043e\u0432\u0430 \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430, \u0447\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u0442\u0435 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0432\u044a\u0432 \u0432\u0441\u0438\u0447\u043a\u0438 \u0441\u0444\u0435\u0440\u0438 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 \u0441\u0438. \u0420\u0443\u0441\u043a\u0438\u044f\u0442 \u0432\u044a\u043d\u0448\u0435\u043d \u043c\u0438\u043d\u0438\u0441\u0442\u044a\u0440 \u0421\u0435\u0440\u0433\u0435\u0439 \u041b\u0430\u0432\u0440\u043e\u0432 \u043f\u043e-\u0440\u0430\u043d\u043e \u0437\u0430\u044f\u0432\u0438, \u0447\u0435 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0442\u0435 \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u0433\u043e\u0434\u0438\u043d\u0438 \u0441\u0430 \u0441\u043b\u0435\u0434\u0432\u0430\u043b\u0438 \u043a\u0443\u0440\u0441 \u043d\u0430 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043d\u0430 \u0434\u0435\u0440\u0443\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0438 \u043d\u0430\u0441\u0438\u043b\u0441\u0442\u0432\u0435\u043d\u0430 \u0430\u0441\u0438\u043c\u0438\u043b\u0430\u0446\u0438\u044f, \u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0442\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u0430 \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0430\u043b\u0438 \u0438 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0442 \u0434\u0430 \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0430\u0442 \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u04