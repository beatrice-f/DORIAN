0 \u0928\u092f\u093e \u0938\u0902\u0915\u091f, \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u094b \u0915\u094d\u092f\u094b\u0902 \u0925\u093e\u092e\u0928\u0940 \u092a\u0921\u093c \u0930\u0939\u0940 \u091f\u094d\u0930\u0915\u094b\u0902 \u0915\u0940 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917\n\u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0940 \u0915\u092e\u0940 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0928\u092f\u093e \u0938\u0902\u0915\u091f \u0917\u0939\u0930\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u0924 \u092f\u0947 \u0939\u094b \u0917\u0908 \u0939\u0948 \u0915\u093f \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u094b \u091f\u094d\u0930\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930, \u092b\u0948\u0915\u094d\u091f\u094d\u0930\u0940 \u092e\u0948\u0928\u0947\u091c\u0930 \u0914\u0930 \u0938\u093f\u0915\u094d\u092f\u094b\u0930\u093f\u091f\u0940 \u0917\u093e\u0930\u094d\u0921 \u091c\u0948\u0938\u0940 \u0928\u094c\u0915\u0930\u093f\u092f\u093e\u0902 \u0915\u0930\u0928\u0940 \u092a\u0921\u093c \u0930\u0939\u0940 \u0939\u0948\u0964\n\u0930\u0942\u0938 \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u091c\u0902\u0917 \u092e\u0947\u0902 \u0909\u0932\u091d\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092a\u0930 \u0928\u092f\u093e \u0938\u0902\u0915\u091f \u0916\u0921\u093c\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u091c\u093e\u0930\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u093f\u092f\u094b\u0902 \u0915\u0947 \u092e\u093e\u0930\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u094b \u092c\u0921\u093c\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092e\u0947\u0902 \u092d\u0930\u094d\u0924\u0940 \u0939\u094b\u0928\u0947 \u0915\u093e \u0906\u0939\u094d\u0935\u093e\u0928 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0928\u094c\u0915\u0930\u093f\u092f\u094b\u0902 \u092a\u0930 \u0905\u0938\u0930 \u092a\u0921\u093c\u0928\u0947 \u0932\u0917\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u0924 \u092f\u0947 \u0939\u094b \u0917\u0908 \u0939\u0948 \u0915\u093f \u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0940 \u0915\u092e\u0940 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u094b \u091f\u094d\u0930\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930, \u092b\u0948\u0915\u094d\u091f\u094d\u0930\u0940 \u092e\u0948\u0928\u0947\u091c\u0930 \u0914\u0930 \u0938\u093f\u0915\u094d\u092f\u094b\u0930\u093f\u091f\u0940 \u0917\u093e\u0930\u094d\u0921 \u091c\u0948\u0938\u0940 \u0928\u094c\u0915\u0930\u093f\u092f\u093e\u0902 \u0915\u0930\u0928\u0940 \u092a\u0921\u093c \u0930\u0939\u0940 \u0939\u0948\u0964\n\u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0926\u094b \u0938\u093e\u0932 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u093e \u0935\u0915\u094d\u0924 \u0939\u094b \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0932\u093e\u0916\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092e\u0947\u0902 \u0938\u0948\u0928\u093f\u0915 \u0914\u0930 \u092e\u093e\u0938\u0942\u092e \u0932\u094b\u0917 \u092e\u093e\u0930\u0947 \u091c\u093e \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u091b\u094b\u091f\u0947 \u0938\u0947 \u0926\u0947\u0936 \u092f\u0942\u094d\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0939\u0925\u093f\u092f\u093e\u0928\u0947 \u092e\u0947\u0902 \u0932\u0917\u093e \u0930\u0942\u0938 \u0905\u092d\u0940 \u0924\u0915 \u0928\u093e\u0915\u093e\u092e \u0930\u0939\u093e \u0939\u0948\u0964 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0914\u0930 \u092a\u0936\u094d\u091a\u093f\u092e \u0926\u0947\u0936 \u0932\u0917\u093e\u0924\u093e\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u092e\u0926\u0926 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0930\u0942\u0938 \u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0905\u092a\u0928\u093e \u0907\u0930\u093e\u0926\u093e \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c\u093e \u0939\u0948\u0964 \u092c\u0921\u093c\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092e\u0947\u0902 \u092e\u093e\u0930\u0947 \u091c\u093e \u0930\u0939\u0947 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u093e \u0938\u0902\u0915\u091f \u0916\u0921\u093c\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u092f\u0941\u0926\u094d\u0927 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u094b \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 '\u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f' \u092e\u093e\u0928\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0935\u0938\u093e\u092f\u094b\u0902 \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u093e\u0964\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u092e\u0947\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u092d\u0930\u094d\u0924\u0940 \u091c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0910\u0938\u0947 \u092e\u0947\u0902 \u092e\u0939\u093f\u0932\u093e\u090f\u0902 \u091f\u094d\u0930\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930, \u092b\u0948\u0915\u094d\u091f\u094d\u0930\u0940 \u092e\u0948\u0928\u0947\u091c\u0930 \u0914\u0930 \u0938\u093f\u0915\u094d\u092f\u094b\u0930\u093f\u091f\u0940 \u0917\u093e\u0930\u094d\u0921 \u091c\u0948\u0938\u0940 \u0928\u094c\u0915\u0930\u093f\u092f\u093e\u0902 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u092c\u0940\u092c\u0940\u0938\u0940 \u0909\u0930\u094d\u0926\u0942 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0932\u093f\u0932\u093f\u092f\u093e \u0936\u0941\u0932\u094d\u0939\u093e \u0938\u093f\u0932\u094d\u092a\u094b \u0928\u093e\u092e\u0915 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u092e\u0939\u093f\u0932\u093e \u0938\u0941\u092a\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u0938\u094d\u091f\u094b\u0930 \u0915\u0947 \u0932\u093f\u090f \u091f\u094d\u0930\u0915 \u091a\u0932\u093e\u0924\u0940 \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0935\u094b \u0915\u0939\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u092f\u0939 \u0909\u0928\u0915\u093e \u0935\u0930\u094d\u0937\u094b\u0902 \u0938\u0947 \u0938\u092a\u0928\u093e \u0925\u093e \u0932\u0947\u0915\u093f\u0928 \u0909\u0938 \u0938\u092e\u092f \u0909\u0928\u0915\u0947 \u092c\u091a\u094d\u091a\u0947 \u092c\u0939\u0941\u0924 \u091b\u094b\u091f\u0947 \u0925\u0947 \u0914\u0930 \u0909\u0928\u0915\u0947 \u092a\u0924\u093f \u092d\u0940 \u0910\u0938\u0940 \u0928\u094c\u0915\u0930\u0940 \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u0925\u0947\u0964 \u0905\u092c \u0909\u0928\u0915\u093e \u0924\u0932\u093e\u0915 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948 \u0914\u0930 \u0909\u0928\u0915\u0940 \u092e\u093e\u0902 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u0940 \u0926\u0947\u0916\u092d\u093e\u0932 \u092e\u0947\u0902 \u0909\u0928\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092e\u0939\u093f\u0932\u093e\u090f\u0902 \u091a\u0932\u093e \u0930\u0939\u0940\u0902 \u091f\u094d\u0930\u0915\n\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092a\u0930 \u0930\u0942\u0938 \u0915\u0947 \u092c\u0921\u093c\u0947 \u092a\u0948\u092e\u093e\u0928\u0947 \u092a\u0930 \u0906\u0915\u094d\u0930\u092e\u0923 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0932\u0947\u0932\u093f\u092f\u093e \u090f\u0915 \u0917\u094b\u0926\u093e\u092e \u092e\u0947\u0902 \u0915\u094d\u0932\u0930\u094d\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0925\u0940 \u0914\u0930 \u0938\u0940\u0930\u093f\u092f\u093e \u092e\u0947\u0902 \u091f\u0948\u0915\u094d\u0938\u0940 \u091a\u0932\u093e\u0924\u0940 \u0925\u0940\u0964 \u0935\u0939 \u0915\u0939\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u093e\u0921\u093c\u093f\u092f\u093e\u0902 \u091a\u0932\u093e\u0928\u0947 \u0915\u093e \u0936\u094c\u0915 \u0925\u093e, \u0907\u0938\u0932\u093f\u090f \u091c\u092c \u0909\u0928\u094d\u0939\u0947\u0902 \u091f\u094d\u0930\u0915 \u091a\u0932\u093e\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u092e\u093f\u0932\u093e, \u0924\u094b \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092e\u094c\u0915\u093e \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c\u093e\u0964 \u0935\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u092a\u093f\u091b\u0932\u0947 \u0938\u093e\u0932 \u091c\u092c \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u091f\u094d\u0930\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u093e \u091f\u0947\u0938\u094d\u091f \u092a\u093e\u0938 \u0915\u093f\u092f\u093e \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u0909\u0928\u0915\u0940 \u0926\u093e\u0926\u0940 \u0915\u093e \u092d\u