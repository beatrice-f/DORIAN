u094d\u0930\u0947\u0928", "\u091c\u093e\u090f\u0902\u0917\u0947", ".", "''"], "sentence": "\u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u091c\u093e\u0928\u0947 \u0915\u0940 \u0905\u091f\u0915\u0932\u094b\u0902 \u092a\u0930 \u0930\u0942\u0938\u0940 \u092e\u0940\u0921\u093f\u092f\u093e \u092e\u0947\u0902 \u0907\u0924\u0928\u0940 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948 \u091a\u0930\u094d\u091a\u093e? \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0930\u0947\u0902\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0905\u0917\u0938\u094d\u0924 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902. \u0930\u0942\u0938\u0940 \u0938\u092e\u093e\u091a\u093e\u0930 \u090f\u091c\u0947\u0902\u0938\u0940 \u0924\u093e\u0938 \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0947 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0902\u0938\u0926 \u0915\u0947 \u090f\u0915 \u0938\u0942\u0924\u094d\u0930 \u0928\u0947 \u092f\u0947 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0940 \u0939\u0948. \u0930\u0942\u0938 \u0915\u0947 \u0938\u0930\u0915\u093e\u0930\u0940 \u091f\u0940\u0935\u0940 \u091a\u0948\u0928\u0932 \u0906\u0930\u091f\u0940 \u0928\u0947 \u092d\u0940 \u092d\u093e\u0930\u0924\u0940\u092f \u092e\u0940\u0921\u093f\u092f\u093e \u092e\u0947\u0902 \u0930\u093e\u091c\u0928\u092f\u093f\u0915 \u0938\u0942\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0939\u0935\u093e\u0932\u0947 \u0938\u0947 \u091b\u092a\u0940 \u0916\u093c\u092c\u0930 \u0915\u093e \u0939\u0935\u093e\u0932\u093e \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0905\u0917\u0938\u094d\u0924 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902. \u0924\u093e\u0938 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915 \u0938\u0942\u0924\u094d\u0930 \u0928\u0947 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u092e\u094b\u0926\u0940 \u0915\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e\u0913\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u092c\u0924\u093e\u092f\u093e, ''\u092d\u093e\u0930\u0924 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0938\u0902\u0915\u091f \u092e\u0947\u0902 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0915\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u092e\u094b\u0926\u0940 \u0915\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092d\u093e\u0930\u0924 \u092f\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0930\u0916 \u0938\u0915\u0924\u093e \u0939\u0948. \u0907\u0938 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u092a\u0930 \u0905\u092d\u0940 \u0935\u093f\u091a\u093e\u0930 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948.'' \u0938\u0942\u0924\u094d\u0930 \u0928\u0947 \u0915\u0939\u093e, ''\u092d\u093e\u0930\u0924 \u0915\u0940 \u0930\u0942\u0938 \u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0940 \u0926\u094b\u0938\u094d\u0924\u0940 \u0939\u0948. \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0930\u0947\u0902\u0926\u094d\u