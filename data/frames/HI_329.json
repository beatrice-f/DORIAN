30\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0935\u094b \u092f\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0936\u093e\u0902\u0924\u093f \u0924\u092d\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948 \u091c\u092c \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u0939\u092e\u0947\u0902 \u0935\u093e\u092a\u093f\u0938 \u092e\u093f\u0932 \u091c\u093e\u090f, \u0924\u094b \u0907\u0938\u0915\u093e \u092e\u0924\u0932\u092c \u0939\u094b\u0917\u093e \u0915\u093f \u0935\u094b \u0917\u0902\u092d\u0940\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948. \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u0905\u092c \u091c\u093e \u091a\u0941\u0915\u093e \u0939\u0948.\" \u092c\u094d\u0930\u093e\u092f\u0928 \u0932\u093e\u0902\u091c\u093c\u093e \u0915\u0947 \u0907\u0938 \u092c\u092f\u093e\u0928 \u0915\u0947 \u092c\u093e\u0926, \u091f\u094d\u0930\u0902\u092a \u0915\u0947 \u090f\u0915 \u092a\u094d\u0930\u0935\u0915\u094d\u0924\u093e \u0928\u0947 \u0909\u0928\u0915\u0940 \u0907\u0928 \u091f\u093f\u092a\u094d\u092a\u0923\u093f\u092f\u094b\u0902 \u0938\u0947 \u0906\u0917\u093e\u092e\u0940 \u091f\u094d\u0930\u0902\u092a \u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0915\u094b \u0905\u0932\u0917 \u0915\u093f\u092f\u093e \u0939\u0948. \u092a\u094d\u0930\u0935\u0915\u094d\u0924\u093e \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \"\u0932\u093e\u0902\u091c\u093c\u093e \u0915\u094b \u0928\u0935 \u0928\u093f\u0930\u094d\u0935\u093e\u091a\u093f\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0915\u0940 \u0913\u0930 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0907\u091c\u093e\u091c\u093c\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948.\" \u092c\u094d\u0930\u093e\u092f\u0928 \u0932\u093e\u0902\u091c\u093c\u093e \u0928\u0947 \u0915\u0939\u093e \u0925\u093e, \"\u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0939 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0909\u0928\u0915\u093e \u092e\u0915\u093c\u0938\u0926 \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u0915\u094b \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0928 \u0924\u094b \u092f\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0939\u0948 \u0914\u0930 \u0928 \u0939\u0940 \u092f\u0942\u0930\u094b\u092a\u0940\u092f \u092e\u0941\u0932\u094d\u0915\u094b\u0902 \u0915\u093e.\" \"\u0939\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u091c\u092c 2014 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0928\u0947 \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u092a\u0930 \u0939\u092e\u0932\u093e \u0915\u093f\u092f\u093e \u0924\u094b \u092f\u0942\u0930\u094b\u092a \u0928\u0947 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e.\" \u0930\u0942\u0938 \u0928\u0947 \u0938\u093e\u0932 2014 \u092e\u0947\u0902 \u0915\u094d\u0930\u093e\u0907\u092e\u093f\u092f\u093e \u092a\u0930 \u0915\u092c\u094d\u091c\u093c\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0925\u093e. \u0907\u0938\u0915\u0947 \u0906\u0920 \u0938\u093e\u0932 \u092c\u093e\u0926, 24 \u092b\u093c\u0930\u0935\u0930\u0940 2022 \u0915\u094b \u0930\u0942\u0938 \u0928\u0947 \u092b\u093f\u0930 \u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0916\u093c\u093f\u0932\u093e\u092b\u093c \"\u0935\u093f\u0936\u0947\u0937 \u0905\u092d\u093f\u092f\u093e\u0928\" \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e. \u0907\u0938 \u091c\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0909\u0938\u09