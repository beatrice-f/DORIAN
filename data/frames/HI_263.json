f\u0941\u0926\u094d\u0927 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u0914\u0930 \u0930\u0942\u0938 \u0915\u0940 \u0915\u0925\u093f\u0924 \u0928\u093e\u0930\u093e\u091c\u093c\u0917\u0940 \u0935\u093e\u0932\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u092d\u093e\u0930\u0924 \u0928\u0947 \u0915\u093f\u092f\u093e \u0916\u093c\u093e\u0930\u093f\u091c\n\n\u092d\u093e\u0930\u0924 \u0915\u0947 \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0928\u0947 \u0938\u092e\u093e\u091a\u093e\u0930 \u090f\u091c\u0947\u0902\u0938\u0940 \u0930\u0949\u092f\u091f\u0930\u094d\u0938 \u0915\u0940 \u0909\u0938 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u0916\u093c\u093e\u0930\u093f\u091c \u0915\u093f\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0915\u093f \u092d\u093e\u0930\u0924\u0940\u092f \u0939\u0925\u093f\u092f\u093e\u0930 \u092f\u0942\u0930\u094b\u092a \u0915\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0917\u090f. 19 \u0938\u093f\u0924\u0902\u092c\u0930 \u0915\u094b \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0930\u0949\u092f\u091f\u0930\u094d\u0938 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e, ''\u092d\u093e\u0930\u0924 \u0915\u0947 \u0939\u0925\u093f\u092f\u093e\u0930 \u0928\u093f\u0930\u094d\u092e\u093e\u0924\u093e\u0913\u0902 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u091c\u094b \u092f\u0941\u0926\u094d\u0927 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u0942\u0930\u094b\u092a \u0915\u0947 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u092c\u0947\u091a\u0947 \u0917\u090f, \u0935\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092d\u0947\u091c\u0947