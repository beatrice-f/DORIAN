40\u0435\u043c\u044a\u043b \u0441\u0430 \u0443\u043b\u0442\u0438\u043c\u0430\u0442\u0443\u043c. \u0422\u043e\u0432\u0430 \u0437\u0430\u044f\u0432\u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u044f\u0442 \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440 \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u0432 \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0437\u0430 Sky TG24, \u0446\u0438\u0442\u0438\u0440\u0430\u043d\u043e \u043e\u0442 \"\u0424\u043e\u043a\u0443\u0441\". \u0414\u043d\u0435\u0441, 14 \u044e\u043d\u0438, \u0432 \u043d\u0430\u0432\u0435\u0447\u0435\u0440\u0438\u0435\u0442\u043e \u043d\u0430 \u043c\u0438\u0440\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0449\u0430 \u043d\u0430 \u0432\u044a\u0440\u0445\u0430 \u0432 \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u044f, \u041f\u0443\u0442\u0438\u043d \u043e\u0431\u044f\u0432\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u0441\u0438 \u0437\u0430 \u0437\u0430\u043f\u043e\u0447\u0432\u0430\u043d\u0435 \u043d\u0430 \u043c\u0438\u0440\u043d\u0438 \u043f\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u0438 \u0441 \u0423\u043a\u0440\u0430\u0439\u043d\u0430. \u0420\u044a\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u0442 \u043d\u0430 \u041a\u0440\u0435\u043c\u044a\u043b \u043f\u043e\u0438\u0441\u043a\u0430 \u0412\u0421\u0423 \u0434\u0430 \u0441\u0435 \u0438\u0437\u0442\u0435\u0433\u043b\u044f\u0442 \u043e\u0442 \u0414\u043e\u043d\u0435\u0446\u043a\u0430, \u041b\u0443\u0433\u0430\u043d\u0441\u043a\u0430, \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u043a\u0430 \u0438 \u0425\u0435\u0440\u0441\u043e\u043d\u0441\u043a\u0430 \u043e\u0431\u043b\u0430\u0441\u0442. \u0412 \u0441\u044a\u0449\u043e\u0442\u043e \u0432\u0440\u0435\u043c\u0435 \u041f\u0443\u0442\u0438\u043d \u0434\u043e\u0431\u0430\u0432\u0438, \u0447\u0435 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0441\u0435 \