\u0435\u0442\u043e", "\u0432", "\u043a\u0440\u0430\u0439\u043d\u0430", "\u0441\u043c\u0435\u0442\u043a\u0430", "\u0449\u0435", "\u043f\u0440\u0435\u0447\u0443\u043f\u0438", "\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u0442\u0430", "\u043d\u0430", "\u0444\u0440\u043e\u043d\u0442\u0430", ".", "\u0412", "\u043c\u043e\u043c\u0435\u043d\u0442\u0430", "\u0442\u043e\u0432\u0430", "\u0438\u0437\u0433\u043b\u0435\u0436\u0434\u0430", "\u043f\u044a\u043b\u0435\u043d", "\u0430\u0431\u0441\u0443\u0440\u0434", "."], "sentence": "Judging Freedom: \u0412 \u0421\u0410\u0429 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0432\u0430\u0442 \u043d\u0435\u0432\u043c\u0435\u043d\u044f\u0435\u043c\u0438\n\n\u041a\u0430\u0439\u043b \u0410\u043d\u0437\u0430\u043b\u043e\u0443\u043d, \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0430 Antiwar.com \u0432 \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0437\u0430 Judging Freedom:\n\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u0411\u0430\u0439\u0434\u044a\u043d \u0441\u0435 \u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430 \u0434\u0430 \u0438\u0437\u043e\u0441\u0442\u0430\u0432\u0438 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0442\u0430 \u0441\u0438, \u0447\u0435 \u0449\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043c \u043d\u0430 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u0438\u0442\u0435 \u0434\u0430 \u043f\u0440\u0430\u0432\u044f\u0442 \u043a\u0430\u043a\u0432\u043e\u0442\u043e \u0441\u0438 \u043f\u043e\u0438\u0441\u043a\u0430\u0442, \u0430 \u0437\u0430 \u0446\u0435\u043b\u0442\u0430 \u0449\u0435 \u0433\u0438 \u0432\u044a\u043e\u0440\u044a\u0436\u0430\u0432\u0430\u043c\u0435. \u0421\u0410\u0429 \u0438 \u0417\u0430\u043f\u0430\u0434\u0430 \u043d\u0430\u0438\u0441\u0442\u0438\u043d\u0430 \u043d\u044f\u043c\u0430\u0442 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u0438 \u0446\u0435\u043b\u0438 \u0437\u0430 \u0432