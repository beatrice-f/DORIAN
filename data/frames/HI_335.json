0936\u093f\u0936\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u0928\u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \"\u0905\u091f\u0942\u091f\" \u0939\u0948. \u0907\u0938 \u0926\u094c\u0930\u093e\u0928 \u0928\u0947\u091f\u094b \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0938\u0947\u0928\u093e \u0915\u0947 \u0938\u093e\u0925 \u0914\u0930 \u0907\u0902\u091f\u0947\u0917\u094d\u0930\u0947\u0936\u0928 \u0915\u0940 \u092d\u0940 \u0918\u094b\u0937\u0923\u093e \u0915\u0940 \u0939\u0948 \u0914\u0930 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u0938\u0926\u0938\u094d\u092f \u0926\u0947\u0936 \u0905\u0917\u0932\u0947 \u0938\u093e\u0932 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b 40 \u0905\u0930\u092c \u092f\u0942\u0930\u094b (43.3 \u0905\u0930\u092c \u0921\u0949\u0932\u0930) \u0915\u0940 \u092e\u0926\u0926 \u0926\u0947\u0928\u0947 \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0938\u092e\u0947\u0902 \u090f\u092b\u093c-16 \u0932\u0921\u093c\u093e\u0915\u0942 \u0935\u093f\u092e\u093e\u0928 \u0914\u0930 \u090f\u092f\u0930 \u0921\u093f\u092b\u0947\u0928\u094d\u0938 \u0938\u092a\u094b\u0930\u094d\u091f \u092d\u0940 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0917\u093e. \u0928\u0947\u091f\u094b \u0915\u0947 \u092e\u0939\u093e\u0938\u091a\u093f\u0935 \u091c\u0947\u0928\u094d\u0938 \u0938\u094d\u091f\u094b\u0932\u094d\u091f\u0928\u092c\u0930\u094d\u0917 \u0928\u0947 \u0915\u0939\u093e \u0939\u0948, \"\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0926\u0940 \u091c\u093e \u0930\u0939\u0940 \u092e\u0926\u0926 \u091a\u0948\u0930\u093f\u091f\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u0907\u0938\u092e\u0947\u0902 \u0939\u092e\u093e\u0930\u0947 \u0905\u092a\u0928\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0939\u093f\u0924 \u0939\u0948\u0902.\" \u0928\u0947\u091f\u094b \u0936\u093f\u0916\u0930 \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u092e\u094