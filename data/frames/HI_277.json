e, \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0926\u093e\u0935\u093e\n\n\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0939\u0948 \u0915\u093f \u0930\u0942\u0938 \u0915\u0947 \u0915\u0941\u091b \u091c\u093e\u0938\u0942\u0938 \u092a\u0941\u0924\u093f\u0928 \u0915\u0947 \u092a\u094d\u0932\u093e\u0928 \u0915\u094b \u0938\u092b\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u093e \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u0924\u0947. \u0907\u0938\u0932\u093f\u090f \u091c\u093e\u0938\u0942\u0938\u094b\u0902 \u0928\u0947 \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0940 \u0939\u0924\u094d\u092f\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u092f\u093e. \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0930\u0942\u0938\u0940 \u0938\u0947\u0928\u093e \u0915\u0947 \u0939\u092e\u0932\u094b\u0902 \u0915\u093e \u0906\u091c \u0928\u094c\u0935\u093e\u0902 \u0926\u093f\u0928 \u0939\u0948. \u0907\u0938 \u092c\u0940\u091a \u091f\u093e\u0907\u092e\u094d\u0938 \u0911\u092b \u0932\u0902\u0926\u0928 \u0915\u0940 \u090f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u092c\u0921\u093c\u093e \u0916\u0941\u0932\u093e\u0938\u093e \u0939\u0941\u0906 \u0939\u0948. \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u092f\u0941\u0926\u094d\u0927 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u090f\u0915 \u0939\u092b\u094d\u0924\u0947 \u0915\u0947 \u0905\u0902\u0926\u0930\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094b\u0932\u094b\u0926\u093f\u