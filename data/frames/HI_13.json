u0924\u0947 \u0915\u093e \"\u0909\u092a\u092f\u094b\u0917\" \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u093f\u092f\u093e \u0939\u0948 \u0914\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \"\u0905\u0935\u0948\u0927 \u092f\u0941\u0926\u094d\u0927\" \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0917\u094d\u0930\u0939 \u0915\u093f\u092f\u093e \u0939\u0948\u0964\n\u092f\u0947 \u091f\u093f\u092a\u094d\u092a\u0923\u093f\u092f\u093e\u0902 \u0935\u093f\u0926\u0947\u0936 \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u092a\u094d\u0930\u0935\u0915\u094d\u0924\u093e \u092e\u0948\u0925\u094d\u092f\u0942 \u092e\u093f\u0932\u0930 \u0928\u0947 \u0938\u094b\u092e\u0935\u093e\u0930 \u0915\u094b \u0905\u092a\u0928\u0947 \u0926\u0948\u0928\u093f\u0915 \u0938\u0902\u0935\u093e\u0926\u0926\u093e\u0924\u093e \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u092e\u0947\u0902 \u0915\u0940\u0902\u0964\n\u201c\u0930\u0942\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092d\u093e\u0930\u0924 \u0915\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0930\u093f\u0936\u094d\u0924\u093e \u0939\u0948\u0964 \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0938\u0930\u094d\u0935\u0935\u093f\u0926\u093f\u0924 \u0939\u0948\u0964 \u0914\u0930 \u0939\u092e\u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u094b \u0930\u0942\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0909\u0938 \u0938\u0902\u092c\u0902\u0927, \u0909\u0938 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0938\u0902\u092c\u0902\u0927 \u0914\u0930 \u0909\u0928\u0915\u0940 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u0905\u092a\u0928\u0947 \u0905\u0935\u0948\u0927 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0907\u0938 \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u094d\u092f\u093e\u092f\u0938\u0902\u0917\u0924 \u0936\u093e\u0902\u0924\u093f, \u0938\u094d\u0925\u093e\u092f\u0940 \u0936\u093e\u0902\u0924\u093f \u0916\u094b\u091c\u0928\u0947 \u0915\u093e \u0906\u0917\u094d\u0930\u0939 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947; \u092a\u0941\u0924\u093f\u0928 \u0915\u094b \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u091a\u093e\u0930\u094d\u091f\u0930 \u0915\u093e \u0938\u092e\u094d\u092e\u093e\u0928 \u0915\u0930\u0928\u0947, \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0905\u0916\u0902\u0921\u0924\u093e \u0914\u0930 \u0938\u0902\u092a\u094d\u0930\u092d\u0941\u0924\u093e \u0915\u093e \u0938\u092e\u094d\u092e\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u201d\u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e\u0964\n\u0936\u094d\u0930\u0940 \u092e\u093f\u0932\u0930 \u0928\u0947 \u090f\u0915 \u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930 \u092e\u0947\u0902 \u0915\u0939\u093e, \"\u0939\u092e \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u092a\u0930 \u092f\u0939\u0940 \u092a\u094d\u0930\u092d\u093e\u0935 \u0921\u093e\u0932\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0917\u094