f\u092a\u091f\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930\u0940 \u0915\u0930 \u0938\u0915\u0947\u0902.\" \u0935\u0947 \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0935\u094b \u0916\u093c\u0941\u092b\u093c\u093f\u092f\u093e \u092e\u093e\u092e\u0932\u094b\u0902 \u092a\u0930 \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u094b \u0938\u0932\u093e\u0939 \u092d\u0940 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902. \u0905\u0917\u0930 \u0935\u094b \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u092c\u0928\u0924\u0940 \u0939\u0948\u0902 \u0924\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0916\u093c\u093f\u0932\u093e\u092b\u093c \u0930\u0942\u0938\u0940 \u0939\u092e\u0932\u0947 \u0915\u094b \u0916\u093c\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0915\u093e\u092b\u093c\u0940 \u092e\u0926\u0926 \u092e\u093f\u0932\u0947\u0917\u0940.\" \u0926\u0930\u094d\u091c\u0928\u094b\u0902 \u0926\u0947\u0936 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0938\u0948\u0928\u093f\u0915, \u0906\u0930\u094d\u0925\u093f\u0915 \u0914\u0930 \u092e\u093e\u0928\u0935\u0940\u092f \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u092e\u0917\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0926\u0947 \u0930\u0939\u093e \u0939\u0948. \u0907\u0938\u0940 \u092e\u0939\u0940\u0928\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0928\u0947 42 \u0915\u0930\u094b\u0921\u093c \u0921\u0949\u0932\u0930 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0940 \u0938\u0948\u0928\u093f\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0926\u0940 \u0939\u0948. \u0905\u092c \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u0928\u093f\u091c\u0940 \u0915\u0902\u092a\u0928\u093f\u092f\u093e\u0902 \u092d\u0940 \u0939\u0925\u093f\u092f\u093e\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0906 \u0930\u0939\u0940 \u0939\u0948\u0902. \u092e\u0917\u0930 \u0926\u0947\u0936 \u0915\u0947 \u0915\u0908 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u091a\u0932\u093e\u0928\u0947 \u0914\u0930 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0940 \u0924\u0928\u0916\u093c\u094d\u0935\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0938\u0939\u092f\u094b\u0917\u0940 \u0926\u0947\u0936\u094b\u0902 \u0938\u0947 \u0906\u0930\u094d\u0925\u093f\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948. \u092e\u0948\u0930\u0940 \u090f\u0928 \u092e\u093e\u0930\u094d\u0936 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u092f\u0941\u0926\u094d\u0927 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0947 \u0938\u092e\u092f \u0938\u0947 \u0939\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u094b \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0935\u093f\u0937\u092f \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 \u0926\u094b\u0928\u094b\u0902 \u092a\u093e\u0930\u094d\u091f\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u0939\u092e\u0924\u0940 \u0930\u0939\u0940 \u0939\u0948. \u0935\u094b \u0915\u0939\u0924\u0940 \u0939\u0948\u0902, \"\u0921\u0947\u092e\u094b\u0915\u094d\u0930\u0947\u091f\u093f\u0915 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0947 \u0938\u093e\u0902\u0938\u0926\u094b\u0902 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0930\u093f\u092a\u092c\u094d\u0932\u093f\u0915\u0928 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0947 \u092c\u0939\u0941\u0938