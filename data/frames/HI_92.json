38\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092a\u0939\u0932\u0947 \u092f\u0939 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u094b\u0924\u0940 \u0924\u094b \u0935\u0939 \u0926\u0942\u0938\u0930\u0947 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u093e \u0925\u093e\u0964 \u0907\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u092e\u0940\u0921\u093f\u092f\u093e \u092e\u0947\u0902 \u092c\u0921\u093c\u0947 \u092a\u0948\u092e\u093e\u0928\u0947 \u092a\u0930 \u0928\u093e\u0917\u0930\u093f\u0915 \u0920\u093f\u0915\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u092e\u0932\u0947 \u0915\u0940 \u0924\u0938\u094d\u0935\u0940\u0930\u094b\u0902 \u0926\u093f\u0916\u093e\u0908 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948\u0902 \u091c\u093f\u0928\u0915\u0940 \u0938\u091a\u094d\u091a\u093e\u0908 \u092a\u0930 \u092a\u0942\u0930\u094d\u0923\u0924: \u0938\u0902\u0926\u0947\u0939 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0930\u0942\u0938 \u0915\u0947 \u0938\u0942\u0924\u094d\u0930\u094b\u0902 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0938\u0939\u093e\u0928\u0941\u092d\u0942\u0924\u093f \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0939\u0948\u0964 \u0915\u094b\u0908 \u092d\u0940 \u0939\u092e\u0932\u093e \u0928\u093e\u0917\u0930\u093f\u0915 \u0920\u093f\u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0932\u0915\u094d\u0937\u094d\u092f \u0915\u0930\u0915\u0947 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964\n\u092f\u0941\u0926\u094d\u0927 \u0915\u0940 \u092d\u092f\u093e\u0935\u0939\u0924\u093e \u092e\u0947\u0902 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0924\u0925\u094d\u092f \u0926\u092c\u0947\n\u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u094b\u0902 \u0915\u09