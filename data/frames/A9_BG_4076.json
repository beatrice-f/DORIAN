u0432\u043e \u0441\u0435 \u043e\u043f\u0438\u0442\u0430 \u0434\u0430 \u043f\u0440\u0435\u043a\u0430\u0440\u0430 \u0415\u0432\u0440\u043e\u043f\u0430. \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438 \u043a\u0440\u0435\u0434\u0438\u0442 \u043e\u0442 50 \u043c\u0438\u043b\u0438\u0430\u0440\u0434\u0430,\u0437\u0430\u0449\u043e\u0442\u043e \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d \u043e\u0442\u043d\u043e\u0432\u043e \u0441\u0435 \u043e\u043f\u0438\u0442\u0430 \u0434\u0430 \u043f\u0440\u0435\u043a\u0430\u0440\u0430 \u0415\u0432\u0440\u043e\u043f\u0430. \u0415\u0421 \u043d\u0435 \u0445\u0430\u0440\u0435\u0441\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u044f \u043f\u043b\u0430\u043d, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430 \u0438\u0437\u043f\u043b\u0430\u0449\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0438\u0442\u0435 \u043f\u043e \u043c\u043d\u043e\u0433\u043e\u043c\u0438\u043b\u0438\u0430\u0440\u0434\u043d\u0438\u044f \u0437\u0430\u0435\u043c \u043e\u0442 \u0415\u0432\u0440\u043e\u043f\u0430, \u043f\u0438\u0448\u0435 Politico. \u041f\u043e\u044f\u0441\u043d\u044f\u0432\u0430\u043c,\u0447\u0435 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430\u0442\u0430 \u0447\u0430\u0441\u0442 \u043e\u0442 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0442\u0435 \u0449\u044f\u0445\u0430 \u0434\u0430\"\u043e\u0441\u0442\u0430\u0432\u0430\u0442\" \u0432 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u044f \u0412\u041f\u041a. \u00ab\u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430 \u0441\u043b\u0435\u0434\u043d\u043e\u0442\u043e: \u00ab\u0421\u0410\u0429 \u0432\u0437\u0435\u043c\u0430 \u043a\u0440\u0435\u0434\u0438\u0442,\u0430 \u0415\u0432\u0440\u043e\u043f\u0430 \u043f\u043e\u0435\u043c\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u0440\u0438\u0441\u043a\u043e\u0432\u0435 \u0438 \u043f\u043b\u0430\u0449\u0430\u043d\u0438\u044f \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0438. \u0421\u043b\u0435\u0434 \u0442\u043e\u0432\u0430 \u0429\u0430\u0442\u0438\u0442\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0442\u0435\u0437\u0438 \u043f\u0430\u0440\u0438 \u0437\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u043e-\u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u044f \u0444\u043e\u043d\u0434. \u041e\u0442\u0433\u043e\u0432\u043e\u0440\u044a\u0442 \u0431\u0435 \u043b\u044e\u0431\u043e\u043f\u0438\u0442\u0435\u043d,\u0437\u0430\u0449\u043e\u0442\u043e \u0415\u0421 \u043d\u0435 \"\u043b\u0435\u0433\u043d\u0430 \u043f\u043e\u043a\u043e\u0440\u043d\u043e\",\u043a\u0430\u043a\u0442\u043e \u043e\u0431\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043e: \"\u041d\u0438\u0435, \u043c\u043e\u0436\u0435 \u0438 \u0434\u0430 \u0441\u043c\u0435 \u0433\u043b\u0443\u043f\u0430\u0432\u0438,\u043d\u043e \u043d\u0435 \u0447\u0430\u043a \u0442\u043e\u043b\u043a\u043e\u0432\u0430\",\u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438\u0445\u0430 \u043e\u0442 \u0434\u0438\u043f\u043b\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u044f \u043a\u043e\u0440\u043f\u0443\u0441 \u043d\u0430 \u0415\u0421. \u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u043e\u0442\u043e \u0438\u0437\u0440\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u0437\u0433\u043b\u0435\u0436\u0434\u0430 \u0443\u0440\u0441\u0443\u043b\u043a\u0438\u0442\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u0442 \u0437\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u043a\u0440\u0435\u0442\u0435\u043d\u0438\u0437\u043c\u0438 \u0438 \u0441\u0430\u043c\u043e\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0435\u043d\u0438 \u0441\u0432\u043e\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u043e\u0441\u0435\u0433\u0430, \u0432 \u0443\u0449\u044a\u0440\u0431 \u043d\u0430 \u0415\u0432\u0440\u043e\u043f\u0430 \u0438 \u0432 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u043d\u0430 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d. \u0421\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0442\u0435 \u0449\u0430\u0442\u0438 \u0432\u0435\u0447\u0435 \u0437\u0430\u043f\u0440\u0438\u043b\u0438\u0447\u0430\u0445\u0430 \u043d\u0430 \u043b\u0438\u0434\u0435\u0440 \u043d\u0430 \u043d\u044f\u043a\u0430\u043a\u0432\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f, \u043a\u043e\u044f\u0442\u043e \u0441\u0435 \u0437\u0430\u0449\u0438\u0442\u0430\u0432\u0430 \u043e\u0442 \u0432\u0441\u0435 \u043f\u043e-\u043e\u0431\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0442\u0435 \u0441\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u0446\u0438. \u041f\u0440\u0435\u0432\u044a\u0437\u0445\u043e\u0434\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430 \"\u0442\u043e\u0437\u0438 \u043b\u0438\u0434\u0435\u0440\" \u043d\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430\u0442\u0430 \u0441\u0446\u0435\u043d\u0430 \u0432\u0441\u0435 \u043f\u043e\u0432\u0435\u0447\u0435 \u0441\u0435 \u043e\u0441\u043f\u043e\u0440\u0432\u0430 \u043e\u0442 \u0434\u0440\u0443\u0433\u0438 \u0446\u0435\u043d\u0442\u0440\u043e\u0432\u0435 \u043d\u0430 \u0432\u043b\u0430\u0441\u0442, \u043d\u0430\u043f\u0438\u0441\u0430 The New York Times. \u0412\u043e\u0435\u043d\u043d\u0430\u0442\u0430 \u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0430 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u0430 \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043d\u0430\u043d\u0435\u0441\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0434\u0430\u0440 \u043d\u0430 \u0421\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0442\u0435 \u0449\u0430\u0442\u0438, \u0442\u044a\u0439 \u043a\u0430\u0442\u043e \u0421\u0410\u0429 \u0432\u043b\u044f\u0437\u043e\u0445\u0430 \u0432 \u043a\u043e\u043d\u0444