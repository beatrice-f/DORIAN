7\u0921", "\u0935\u093e\u0939\u0928\u094b\u0902", "\u0924\u0915", "\u0932\u0917\u092d\u0917", "\u0915\u093f\u0938\u0940", "\u092d\u0940", "\u091a\u0940\u091c\u093c", "\u0915\u094b", "\u091c\u0932\u093e", "\u0938\u0915\u0924\u093e", "\u0939\u0948", ",", "\u0914\u0930", "\u092f\u0939\u093e\u0902", "\u0924\u0915", "\u0915\u093f", "\u092a\u093e\u0928\u0940", "\u0915\u0947", "\u0928\u0940\u091a\u0947", "\u092d\u0940", "\u091c\u0932", "\u0938\u0915\u0924\u093e", "\u0939\u0948", ".", "\u092e\u0928\u0941\u0937\u094d\u092f\u094b\u0902", "\u092a\u0930", ",", "\u092f\u0939", "\u0917\u0902\u092d\u0940\u0930", ",", "\u0938\u0902\u092d\u0935\u0924\u0903", "\u0918\u093e\u0924\u0915", ",", "\u091c\u0932\u0928", "\u0914\u0930", "\u0939\u0921\u094d\u0921\u093f\u092f\u094b\u0902", "\u0915\u094b", "\u0928\u0941\u0915\u0938\u093e\u0928", "\u092a\u0939\u0941\u0902\u091a\u093e\u0924\u093e", "\u0939\u0948", "."], "sentence": "'\u0921\u094d\u0930\u0948\u0917\u0928 \u0921\u094d\u0930\u094b\u0928' \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u0916\u0924\u0930\u0928\u093e\u0915 \u0939\u0925\u093f\u092f\u093e\u0930? \u092a\u0932 \u092d\u0930 \u092e\u0947\u0902 \u0938\u092c\u0915\u0941\u091b \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0916\u093e\u0915, \u0928\u0939\u0940\u0902 \u092c\u0941\u091d\u093e \u0938\u0915\u0924\u093e \u0915\u094b\u0908 \u0907\u0938\u0915\u0940 \u0906\u0917...\n\n\u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940: \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b 2 \u0938\u093e\u0932 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u094b \u0917\u090f \u0939\u0948\u0902. \u0907\u0938 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0928\u0947 \u090f\u0915 \u0926\u0942\u0938\u0930\u0947 \u092a\u0930 \u0915\u0908 \u0939\u092e\u0932\u0947 \u0915\u093f\u090f. \u0932\u0947\u0915\u093f\u0928 \u0930\u0942\u0938 \u0905\u092c \u091c\u093f\u0938 \u0939\u0925\u093f\u092f\u093e\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948 \u0909\u0938\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0905\u092c \u0924\u0915 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948. \u092e\u093e\u0928\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0905\u092c \u0924\u0915 \u0915\u093e \u0938\u092c\u0938\u0947 \u0916\u0924\u0930\u0928\u093e\u0915 \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948. \u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u090f\u0915 \u0928\u092f\u093e \u0918\u093e\u0924\u0915 \u0939\u0925\u093f\u092f\u093e\u0930 \u0905\u092c \u0906\u0938\u092e\u093e\u0928 \u092e\u0947\u0902 \u0909\u0921\u093c \u0930\u0939 \u0939\u0948. \u0926\u094b\u0928\u094b\u0902 \u092a\u0915\u094d\u0937\u094b\u0902 \u0928\u0947 \u0921\u094d\u0930\u094b\u0928 \u0938\u0947 \u0906\u0917 \u092c\u0930\u0938\u093e\u0928\u0947 \u0915\u0947 \u0926\u0943\u0936\u094d\u092f \u092a\u094b\u0938\u094d\u091f \u0915\u093f\u090f \u0939\u0948\u0902. \u0907\u0938 \u0939\u0925\u093f\u092f\u093e\u0930 \u0915\u094b \u201c\u0921\u094d\u0930\u0948\u0917\u0928 \u0921\u094d\u0930\u094b\u0928\u201d \u0915\u093e \u0928\u093e\u092e \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u092f\u0947 \u0921\u094d\u0930\u094b\u0928 \u092a\u093f\u0918\u0932\u0940 \u0939\u0941\u0908 \u0927\u093e\u0924\u0941 \u0909\u0917\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b 2,427 \u0921\u093f\u0917\u094d\u0930\u0940 \u0938\u0947\u0932\u094d\u0938\u093f\u092f\u0938 \u092a\u0930 \u091c\u0932\u0924\u0940 \u0939\u0948. \u0921\u094d\u0930\u0948\u0917\u0928 \u0921\u094d\u0930\u094b\u0928 \u092e\u0942\u0932\u0924\u0903 \u0925\u0930\u094d\u092e\u093e\u0907\u091f \u092