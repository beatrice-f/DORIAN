94b\u0917", "\u092a\u0936\u094d\u091a\u093f\u092e", "\u0915\u094b", "\u092f\u0939", "\u0926\u093f\u0916\u093e\u0928\u0947", "\u0915\u0947", "\u0932\u093f\u090f", "\u0915\u093f\u092f\u093e", "\u091c\u093e", "\u0938\u0915\u0924\u093e", "\u0939\u0948", "\u0915\u093f", "\u092f\u0942\u0915\u094d\u0930\u0947\u0928", "\u092f\u0941\u0926\u094d\u0927", "\u0915\u094b", "\u0932\u0947\u0915\u0930", "\u0930\u0942\u0938", "\u0915\u094b", "\u0905\u0932\u0917", "-", "\u0925\u0932\u0917", "\u0915\u0930\u0928\u0947", "\u0915\u0947", "\u092a\u094d\u0930\u092f\u093e\u0938", "\u0935\u093f\u092b\u0932", "\u0930\u0939\u0947", "\u0939\u0948\u0902", "."], "sentence": "\u092e\u094b\u0926\u0940-\u091c\u093f\u0928\u092a\u093f\u0902\u0917 \u0928\u0939\u0940\u0902... \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u092e\u093f\u0932\u0947\u0917\u093e \u090f\u0915 \u0914\u0930 \u0916\u093e\u0938 \u0936\u0916\u094d\u0938, \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u093e\u0928\u0924\u0940 \u0939\u0948 \u092c\u093e\u0924, \u092b\u093f\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u091b\u093e\u0924\u0940 \u0915\u094d\u092f\u094b\u0902 \u092b\u091f \u0930\u0939\u0940? \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u091c\u0902\u0917 \u0915\u0947 \u092c\u0940\u091a \u0930\u0942\u0938 \u092e\u0947\u0902 \u0905\u092d\u0940 \u092c\u094d\u0930\u093f\u0915\u094d\u0938 \u0938\u092e\u093f\u091f \u0939\u0948. \u092a\u0941\u0924\u093f\u0928 \u0915\u0947 \u092c\u0941\u0932\u093e\u0935\u0947 \u092a\u0930 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0914\u0930 \u091a\u0940\u0928\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0936\u0940 \u091c\u093f\u0928\u092a\u093f\u0902\u0917 \u0938\u092c \u092a\u0939\u0941\u0902\u091a\u0947 \u0939\u0941\u090f \u0939\u0948\u0902. \u092a\u0942\u0930\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0940 \u0928\u091c\u0930 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940, \u091c\u093f\u0928\u092a\u093f\u0902\u0917 \u0914\u0930 \u092a\u0941\u0924\u093f\u0928 \u0915\u0940 \u0924\u093f\u0915\u0921\u093c\u0940 \u092a\u0930 \u091c\u092e\u0940 \u0939\u0948. \u0907\u0938 \u092c\u0940\u091a \u0930\u0942\u0938 \u092e\u0947\u0902 \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u092e\u093f\u0932\u0928\u0947 \u0935\u0939 \u0936\u0916\u094d\u0938 \u0906 \u0930\u0939\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0940 \u092c\u093e\u0924 \u0932\u0917\u092d\u0917 \u092a\u0942\u0930\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u093e\u0928\u0924\u0940 \u0939\u0948. \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u0909\u0938 \u0936\u0916\u094d\u0938 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u094b \u0932\u0947\u0915\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0940 \u091b\u093e\u0924\u0940 \u0905\u092d\u0940 \u0938\u0947 \u092b\u091f\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948. \u0926\u0930\u0905\u0938\u0932, \u0930\u0942\u0938 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u0938\u0947 \u092f\u0942\u0928\u093e\u0907\u091f\u0947\u0921 \u0928\u0947\u0936\u0928 \u0915\u0947 \u091a\u0940\u092b \u090f\u0902\u091f\u094b\u0928\u093f\u092f\u094b \u0917\u0941\u091f\u0930\u0947\u0938 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0930\u0947\u0902\u0917\u0947. \u092f\u0939 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u091c\u093e\u0928 \u092e\u0947\u0902 \u0939\u094b\u0917\u0940. \u0915\u091c\u093e\u0928 \u092e\u0947\u0902 \u0939\u0940 \u0905\u092d\u0940 \u092c\u094d\u0930\u093f\u0915\u094d\u0938 \u0938\u092e\u093f\u091f \u091a\u0932 \u0930\u0939\u093e \u0939\u0948. \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0928\u0947 \u092c\u0941\u0927\u0935\u093e\u0930 \u0915\u094b \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940. \u0915\u094d\u0930\u0947\u092e\u0932\u093f\u0928 \u0915\u0947 \u092e\u0941\u0924\u093e\u