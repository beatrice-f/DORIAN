044a\u0440\u0432\u0430\u0442\u0430 - \u0440\u0443\u0441\u043a\u0430\u0442\u0430 \u0430\u0440\u0442\u0438\u043b\u0435\u0440\u0438\u044f \u043f\u043e\u043d\u0435\u0441\u0435 \u0433\u043e\u043b\u0435\u043c\u0438 \u0437\u0430\u0433\u0443\u0431\u0438 \u0432 \u0445\u043e\u0434\u0430 \u043d\u0430 \u0432\u043e\u0439\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0449\u0443 \u0423\u043a\u0440\u0430\u0439\u043d\u0430. \u041e\u0442 \u043d\u0430\u0447\u0430\u043b\u043e\u0442\u043e \u043d\u0430 \u043f\u044a\u043b\u043d\u043e\u0449\u0430\u0431\u043d\u0430\u0442\u0430 \u0438\u043d\u0432\u0430\u0437\u0438\u044f (24 \u0444\u0435\u0432\u0440\u0443\u0430\u0440\u0438 2022 \u0433.) \u0441\u0438\u043b\u0438\u0442\u0435 \u043d\u0430 \u041c\u043e\u0441\u043a\u0432\u0430 \u0438 \u0442\u0435\u0445\u043d\u0438\u0442\u0435 \u0441\u044a\u044e\u0437\u043d\u0438\u0446\u0438 \u0441\u0435 \u043b\u0438\u0448\u0438\u0445\u0430 \u043e\u0442 14 483 \u0430\u0440\u0442\u0438\u043b\u0435\u0440\u0438\u0439\u0441\u043a\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438\", \u0434\u043e\u0431\u0430\u0432\u0438 \u043c\u0435\u0434\u0438\u044f\u0442\u0430. \"\u0412\u0442\u043e\u0440\u0430\u0442\u0430 \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0435 \u0432 \"\u043f\u043e\u043c\u043e\u0449\u0442\u0430\", \u043a\u043e\u044f\u0442\u043e \u0434\u0438\u043a\u0442\u0430\u0442\u043e\u0440\u044a\u0442 \u043d\u0430 \u041a\u043e\u0440\u0435\u0439\u0441\u043a\u0430\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u0430 \u0440\u0435\u043f\u0443\u0431\u043b\u0438\u043a\u0430 (\u041a\u041d\u0414\u0420) \u041a\u0438\u043c \u0427\u0435\u043d-\u0443\u043d \u043e\u043a\u0430\u0437\u0432\u0430 \u043d\u0430 \u0440\u0443\u0441\u043a\u0438\u044f \u0441\u0438 \u043a\u043e\u043b\u0435\u0433\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d\", \u043e\u0442\u0431\u0435\u043b\u044f\u0437\u0432\u0430 \u201e\u0424\u043e\u043a\u