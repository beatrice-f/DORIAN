0435 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u043d\u043e\u0441\u0442\u0442\u0430 \u0437\u0430 \u043f\u0440\u043e\u0432\u0430\u043b\u0430\n\n\u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d \u0441\u0435 \u043e\u043f\u0438\u0442\u0432\u0430 \u0434\u0430 \u0441\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0440\u0430 \u043e\u0442 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u044f \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442. \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0442\u0435 \u0432\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0435\u0445\u0432\u044a\u0440\u043b\u044f\u0442 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u043d\u043e\u0441\u0442\u0442\u0430 \u0437\u0430 \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u0430\u0442\u0430 \u043d\u0430 \u041a\u0438\u0435\u0432 \u0432\u044a\u0440\u0445\u0443 \u043e\u0441\u0442\u0430\u043d\u0430\u043b\u0438\u0442\u0435 \u0447\u043b\u0435\u043d\u043e\u0432\u0435 \u043d\u0430 \u041d\u0410\u0422\u041e, \u043d\u0430\u043f\u044a\u043b\u043d\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0439\u043a\u0438 \u0431\u0435\u0437\u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0442\u0430\u0437\u0438 \u0438\u0434\u0435\u044f, \u0441\u0447\u0438\u0442\u0430 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u044f\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u044a\u0440 \u041c\u0435\u0440\u043a\u0443\u0440\u0438\u0441, \u0430\u0432\u0442\u043e\u0440 \u043d\u0430 YouTube \u043a\u0430\u043d\u0430\u043b\u0430 The Duran. \u0410\u041b\u0415\u041a\u0421 \u041a\u0420\u0418\u0421\u0422\u041e\u0424\u041e\u0420\u0423, \u0441\u044a\u0430\u0432\u0442\u043e\u0440 YouTube-\u043a\u0430\u043d\u0430\u043b\u0430 The Duran:: \u0422\u0435 \u0441\u0435 \u0437\u0430\u0446\u0435\u043f\u0438\u0445\u0430 \u0432 \u201e\u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430\u201c. \u0418\u043c\u0430\u043c\u0435 \u043d\u043e\u0432 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0435\u043d \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440 \u043d\u0430 \u041d\u0410\u0422\u041e \u2014 \u041c\u0430\u0440\u043a \u0420\u044e\u0442\u0435, \u043a\u043e\u0439\u0442\u043e \u0449\u0435 \u043f\u043e\u0435\u043c\u0435 \u044e\u0437\u0434\u0438\u0442\u0435 \u043d\u0430 \u0432\u043b\u0430\u0441\u0442\u0442\u0430. \u0410\u041b\u0415\u041a\u0421\u0410\u041d\u0414\u042a\u0420 \u041c\u0415\u0420\u041a\u0423\u0420\u0418\u0421: \u0414\u0430. \u0410\u041b\u0415\u041a\u0421 \u041a\u0420\u0418\u0421\u0422\u041e\u0424\u041e\u0420\u0423: \u0422\u043e\u0439 \u0437\u0430\u0435\u043c\u0430 \u0432\u043e\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0441\u043f\u0440\u044f\u043c\u043e \u0423\u043a\u0440\u0430\u0439\u043d\u0430. \u0422\u043e\u0439 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043f\u0440\u0435\u0437\u0438\u0440\u0430 \u0420\u0443\u0441\u0438\u044f. \u2026\n\u0410\u041b\u0415\u041a\u0421\u0410\u041d\u0414\u042a\u0420 \u041c\u0415\u0420\u041a\u0423\u0420\u0418\u0421: \u041e, \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e! \u0422\u043e\u0439 \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0434\u0430 \u0420\u0443\u0441\u0438\u044f. \u0418\u0441\u043a\u0430\u043c \u0434\u0430 \u043a\u0430\u0436\u0430, \u0447\u0435 \u0442\u043e\u0439 \u0435 \u0435\u0434\u0438\u043d \u043e\u0442 \u043d\u0430\u0439-\u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043e \u0430\u043d\u0442\u0438\u0440\u0443\u0441\u043a\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0442\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u0446\u0438 \u0432 \u0417\u0430\u043f\u0430\u0434\u043d\u0430 \u0415\u0432\u0440\u043e\u043f\u0430, \u043f\u043e\u0440\u0430\u0434\u0438 \u043a\u043e\u0435\u0442\u043e \u0431\u0435\u0448\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0437\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0435\u043d \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440 \u043d\u0430 \u041d\u0410\u0422\u041e. \u0420\u0430\u0437\u0431\u0438\u0440\u0430 \u0441\u0435, \u0421\u0442\u043e\u043b\u0442\u0435\u043d\u0431\u0435\u0440\u0433 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e \u0438\u0441\u043a\u0430\u0448\u0435 \u0432\u0441\u0435\u043a\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u0435\u043d \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a \u0434\u0430 \u0431\u044a\u0434\u0435 \u0442\u0432\u044a\u0440\u0434 \u043a\u0430\u0442\u043e \u043d\u0435\u0433\u043e. \u0418 \u0442\u043e\u0432\u0430 \u0435, \u043a\u043e\u0435\u0442\u043e \u043d\u0430\u0439-\u043d\u0430\u043a\u0440\u0430\u044f \u0443\u0441\u043f\u044f\u0445\u0430 \u0434\u0430 \u0441\u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u0442. \u0422\u0430\u043a\u0430 \u0447\u0435 \u043d\u044f\u043c\u0430 \u0434\u0430 \u0438\u043c\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u0438 \u0432 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430\u0442\u0430. \u041d\u043e \u0432\u0435\u0447\u0435 \u0432\u0438\u0436\u0434\u0430\u0442\u0435 \u043a\u0430\u043a\u0432\u043e \u0441\u0435 \u0441\u043b\u0443\u0447\u0432\u0430. \u0421\u0435\u0433\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0446\u0438\u0442\u0435 \u0432\u0441\u044a\u0449\u043d\u043e\u0441\u0442 \u0449\u0435 \u0441\u0442\u043e\u0432\u0430\u0440\u044f\u0442 \u0432\u0438\u043d\u0430\u0442\u0430 \u0432\u044a\u0440\u0445\u0443 \u041c\u0430\u0440\u043a \u0420\u044e\u0442\u0435 \u0438 \u041d\u0410\u0422\u041e \u0437\u0430 \u201e\u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430\u201c, \u0437\u0430\u0442\u043e\u0432\u0430 \u0438 \u043a\u0430\u0437\u0432\u0430\u0442: \u201e\u041e\u0442\u0441\u0435\u0433\u0430 \u043d\u0430\u0442\u0430\u0442\u044a\u043a \u0421\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0442\u0435 \u0449\u0430\u0442\u0438 \u043e\u0442\u0438\u0432\u0430\u0442 \u043d\u0430 \u0432\u0442\u043