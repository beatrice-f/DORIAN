\u0947\u0915 \u0905\u0930\u092c\u092a\u0924\u093f \u090f\u0932\u0928 \u092e\u0938\u094d\u0915 (Elon Musk) \u0928\u0947 \u092e\u0902\u0917\u0932\u0935\u093e\u0930 \u0915\u094b \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0905\u0930\u094d\u0925\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940 \u091c\u0947\u092b\u0930\u0940 \u0921\u0940 \u0938\u0948\u0915\u094d\u0938 \u0915\u093e \u090f\u0915 \u0935\u0940\u0921\u093f\u092f\u094b \u0936\u0947\u092f\u0930 \u0915\u093f\u092f\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0930\u0942\u0938\u0940 \u0906\u0915\u094d\u0930\u093e\u092e\u0915\u0924\u093e \u0915\u0947 \u092c\u091c\u093e\u092f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u0928\u0947\u0924\u0943\u0924\u094d\u0935 \u0935\u093e\u0932\u0947 \u0928\u093e\u091f\u094b (NATO) \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092f\u0941\u0926\u094d\u0927 \u0915\u094b \u092d\u0921\u093c\u0915\u093e\u092f\u093e. X \u092a\u0930 \u0936\u0947\u092f\u0930 \u0915\u093f\u090f \u0917\u090f \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u0940 \u0905\u0930\u094d\u0925\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940 \u0928\u0947 \u0924\u0930\u094d\u0915 \u0926\u093f\u092f\u093e \u0915\u093f \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0928\u093e\u091f\u094b \u0915\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0947 \u0907\u0930\u093e\u0926\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0939\u092e\u0932\u093e \u0915\u093f\u092f\u093e. \u0938\u0948\u0915\u094