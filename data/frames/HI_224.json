2b\u093f\u0930 \u0930\u0942\u0938 \u091c\u093e\u0928\u0947 \u0938\u0947 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0915\u093e\u092b\u0940 \u092c\u0926\u0932\u093e\u0935 \u0939\u094b\u0917\u093e? \u0915\u094d\u092f\u093e \u0905\u092c \u0930\u0942\u0938 \u092f\u0939 \u092f\u0941\u0926\u094d\u0927 \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0932\u0917\u093e \u0939\u0948? \u092f\u0947 \u0915\u0941\u091b \u0910\u0938\u0947 \u0938\u0935\u093e\u0932 \u0939\u0948\u0902 \u091c\u093f\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0924\u094c\u0930 \u092a\u0930 \u0924\u094b \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u0932\u0947\u0915\u093f\u0928, \u092c\u0940\u0924\u0947 \u0915\u0941\u091b \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0930\u0942\u0938 \u0915\u0947 \u0930\u0941\u0916 \u0915\u094b \u0926\u0947\u0916\u0924\u0947 \u0939\u090f \u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0938\u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e. \u0926\u0930\u0905\u0938\u0932, 26 \u092b\u0930\u0935\u0930\u0940 2022 \u0938\u0947 \u091c\u093e\u0930\u0940 \u0907\u0938 \u091c\u0902\u0917 \u092e\u0947\u0902 \u0905\u092c \u0924\u0915 \u092c\u0921\u093c\u0940 \u0924\u092c\u093e\u0939\u0940 \u0926\u0947\u0916\u0940 \u0939\u0948. \u0907\u0938 \u091c\u0902\u0917 \u0915\u093e \u0905\u0938\u0930 \u092a\u0942\u0930\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092a\u0930 \u092a\u0921\u093c\u093e \u0939\u0948. \u092f\u0942\u0930\u094b\u092a \u0938\u0939\u093f\u0924 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 \u0924\u092e\u093e\u092e \u0926\u0947\u0936\u094b\u0902 \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e \u0915\u0940 \u0915\u093f\u0932\u094d\u0932\u0924 \u0926\u0947\u0916\u0940 \u0917\u0908. \u092d\u093e\u0930\u0924 \u092a\u0930 \u092d\u0940 \u0907\u0938 \u091c\u0902\u0917 \u0915\u093e \u0935\u094d\u092f\u093e\u092a\u0915 \u0905\u0938\u0930 \u0939\u0941\u0906 \u0939\u0948. \u0932\u0947\u0915\u093f\u0928, \u092c\u0940\u0924\u0947 \u0915\u0941\u091b \u092e\u0939\u0940\u0928\u094b\u0902 \u0938\u0947 \u092d\u093e\u0930\u0924 \u0916\u093e\u0938\u0915\u0930 \u092a\u0940\u090f\u092e \u0928\u0930\u0947\u0902\u0926\u094d\u0930 \u092e\u094b\u0926\u0940 \u0907\u0938 \u091c\u0902\u0917 \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930\u093e\u0928\u0947 \u0915\u0940 \u0932\u0917\u093e\u0924\u093e\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0935\u0939 \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0930\u0928\u0947 \u0909\u0928\u0915\u0947-\u0909\u0928\u0915\u0947 \u0926\u0947\u0936 \u0917\u090f. \u092b\u093f\u0930 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0947 \u092c\u0924\u094c\u0930 \u0926\u0942\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0905\u091c\u0940\u0924 \u0921\u094b\u092d\u093e\u0932 \u0928\u0947 \u092d\u0940 \u092a\u0941\u0924\u093f\u0928 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940. \u0909\u0927\u0930, \u0935\u093f\u0926\u0947\u0936 \u092e\u0902\u0924\u094d\u0930\u0940 \u090f\u0938 \u091c\u092f\u0936\u0902\u0915\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e, \u092b\u094d