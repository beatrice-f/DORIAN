0\u0947\u0928", "\u0914\u0930", "\u0930\u0942\u0938", "\u091c\u0902\u0917", "\u0932\u0921\u093c", "\u0930\u0939\u0947", "\u0939\u0948\u0902", ".", "\u0907\u0938", "\u0926\u0930\u092e\u094d\u092f\u093e\u0928", "\u0909\u0924\u094d\u0924\u0930", "\u0915\u094b\u0930\u093f\u092f\u093e", "\u0914\u0930", "\u0930\u0942\u0938", "\u0915\u093e", "\u0906\u092a\u0938\u0940", "\u0938\u0939\u092f\u094b\u0917", "\u0915\u093e\u092b\u0940", "\u092e\u091c\u092c\u0942\u0924", "\u0939\u0941\u0906", "\u0939\u0948", ".", "\u091c\u092c\u0915\u093f", "\u0926\u0915\u094d\u0937\u093f\u0923", "\u0915\u094b\u0930\u093f\u092f\u093e", "\u0905\u092e\u0947\u0930\u093f\u0915\u093e", "\u0915\u0947", "\u092a\u0915\u094d\u0937", "\u0930\u0939\u0924\u093e", "\u0939\u0948", ".", "\u092a\u093f\u091b\u0932\u0947", "\u0938\u092a\u094d\u0924\u093e\u0939", "\u0926\u0915\u094d\u0937\u093f\u0923", "\u0915\u094b\u0930\u093f\u092f\u093e", "\u0915\u0940", "\u0916\u0941\u092b\u093f\u092f\u093e", "\u090f\u091c\u0947\u0902\u0938\u0940", "\u0928\u0947", "\u092a\u0941\u0937\u094d\u091f\u093f", "\u0915\u0940", "\u0925\u0940", "\u0915\u093f", "\u0907\u0938", "\u092e\u0939\u0940\u0928\u0947", "\u0909\u0924\u094d\u0924\u0930", "\u0915\u094b\u0930\u093f\u092f\u093e", "\u0928\u0947", "\u0905\u092a\u0928\u0947", "1500", "\u0938\u0948\u0928\u093f\u0915\u094b\u0902", "\u0915\u094b", "\u0930\u0942\u0938", "\u092d\u0947\u091c\u093e", "\u0939\u0948", "."], "sentence": "\u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0939\u093f\u0938\u094d\u0938\u093e \u0928\u0939\u0940\u0902 \u0932\u0947\u0902\u0917\u0947 \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0947 \u0938\u0948\u0928\u093f\u0915, \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0947 \u0926\u093e\u0935\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u092f\u093e \u092c\u0947\u092c\u0941\u0928\u093f\u092f\u093e\u0926\n\n\u0930\u0942\u0938-\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u092c\u0940\u091a \u091c\u0902\u0917 \u091a\u0932 \u0930\u0939\u0940 \u0939\u0948. \u0907\u0938 \u092c\u0940\u091a \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u093e \u092c\u0921\u093c\u093e \u092c\u092f\u093e\u0928 \u0906\u092f\u093e \u0939\u0948. \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0915\u0947 \u0938\u0948\u0928\u093f\u0915 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0939\u093f\u0938\u094d\u0938\u093e \u0928\u0939\u0940\u0902 \u0932\u0947\u0902\u0917\u0947. \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0914\u0930 \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u0928\u0947 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0925\u093e \u0915\u093f \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0947 \u0938\u0948\u0928\u093f\u0915 \u0907\u0938 \u092f\u0941\u0926\u094d\u0927 \u092e\u0947\u0902 \u0939\u093f\u0938\u094d\u0938\u093e \u0932\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902. \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0928\u0947 \u0907\u0938 \u0926\u093e\u0935\u094b\u0902 \u0915\u094b \u092c\u0947\u092c\u0941\u0928\u093f\u092f\u093e\u0926 \u092c\u0924\u093e\u092f\u093e \u0939\u0948. \u0909\u0927\u0930, \u0930\u0942\u0938 \u0915\u0940 \u092e\u0926\u0926 \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0938\u0948\u0928\u093f\u0915 \u092d\u0947\u091c\u0947 \u091c\u093e\u0928\u0947 \u0915\u0940 \u0915\u0940 \u0916\u092c\u0930 \u092a\u0930 \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u090f\u0915\u094d\u0936\u0928 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0939\u0948. \u0909\u0938\u0928\u0947 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0940 \u0915\u093f \u0905\u0917\u0930 \u0910\u0938\u093e \u0939\u0948 \u0924\u094b \u0935\u094b \u092d\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0939\u0925\u093f\u092f\u093e\u0930 \u0938\u092a\u094d\u0932\u093e\u0908 \u0915\u0930\u0947\u0917\u093e. \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0914\u0930 \u0930\u0942\u0938 \u0926\u094b\u0928\u094b\u0902 \u0928\u0947 \u0907\u0928 \u0916\u092c\u0930\u094b\u0902 \u0915\u094b \u0916\u0902\u0921\u0928 \u0915\u093f\u092f\u093e \u0939\u0948. \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u094b \u091a\u093f\u0902\u0924\u093e \u0939\u0948 \u0915\u093f \u0930\u0942\u0938 \u0935\u0947\u092a\u0928 \u091f\u0947\u0915\u094d\u0928\u094b\u0932\u0949\u091c\u0940 \u0915\u0947 \u091c\u0930\u093f\u090f \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u094b \u092b\u093e\u092f\u0926\u093e \u092a\u0939\u0941\u0902\u091a\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u0907\u0938\u0938\u0947 \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u094b \u091f\u093e\u0930\u0917\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u094b \u0924\u093e\u0915\u0924 \u092e\u093f\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948. \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u0930\u093f\u0937\u0926 \u0915\u0940 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u092c\u0948\u0920\u0915 \u092e\u0947\u0902 \u0926\u0915\u094d\u0937\u093f\u0923 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0928\u0947 \u0909\u0924\u094d\u0924\u0930 \u0915\u094b\u0930\u093f\u092f\u093e \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0938\u0948\u0928\u093f\u0915\u094b\u0902 \u0915\u0940 \u0915\u0925\u093f