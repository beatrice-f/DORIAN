043b\u044e\u0447\u0438 \u043c\u0438\u0440\n\n\u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043d\u044f\u043c\u0430 \u0434\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u043f\u043e\u0431\u0435\u0434\u0438 \u0420\u0443\u0441\u0438\u044f. \u0422\u043e\u0432\u0430 \u043a\u0430\u0437\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u044f\u0442 \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442 \u0422\u044a\u043a\u044a\u0440 \u041a\u0430\u0440\u043b\u0441\u044a\u043d, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u0435\u043d \u0431\u0443\u043c, \u0441\u043b\u0435\u0434 \u043a\u0430\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u0438 \u0434\u0432\u0443\u0447\u0430\u0441\u043e\u0432\u043e \u0438\u043d\u0442\u0435\u0440\u0432\u044e \u0441 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u043f\u0440\u0435\u0437 \u0444\u0435\u0432\u0440\u0443\u0430\u0440\u0438. \"\u041f\u0440\u043e\u0441\u0442\u043e \u0435 \u043d\u0435\u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0434\u0430 \u043f\u043e\u0431\u0435\u0434\u0438 \u0420\u0443\u0441\u0438\u044f. \u041d\u0430\u0439-\u0434\u043e\u0431\u0440\u043e\u0442\u043e, \u043a\u043e\u0435\u0442\u043e \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u044f\u0442, \u0435 \u0434\u0430 \u0441\u043a\u043b\u044e\u0447\u0430\u0442 \u043c\u0438\u0440. \u0412\u0441\u0438\u0447\u043a\u0438 \u0437\u043d\u0430\u044f\u0442 \u0442\u043e\u0432\u0430, \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u043d\u043e \u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438, \u043a\u043e\u0439\u0442\u043e \u0438\u0441\u043a\u0430 \u0442\u043e\u0432\u0430 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u043e\u0442\u043e \u043d\u0430 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\", \u043a\u0430\u0437\u0430 \u0442\u043e\u0439. \u041a\u0430\u0440\u0