3a\u0430\u0437\u0430\u0442\u044c", "?", "\u042d\u0442\u043e", "\u0432\u043e\u0439\u043d\u0430", ".", "\u0418", "\u044d\u0442\u043e", "\u043d\u0435", "\u043e\u0442\u0432\u0435\u0442\u043a\u0430", "\u0437\u0430", "\u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434", ",", "\u0413\u043e\u0440\u043b\u043e\u0432\u043a\u0443", "\u0438", "\u0442", "\u043f", ".", "\u041f\u0440\u043e\u0441\u0442\u043e", "\u0432\u043e\u0439\u043d\u0430", "."], "sentence": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0412\u0421 \u0420\u0424 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043c\u043e\u0449\u043d\u044b\u0445 \u043e\u0431\u0441\u0442\u0440\u0435\u043b\u043e\u0432 \u0441\u0442\u043e\u043b\u0438\u0446\u044b \u0423\u043a\u0440\u0430\u0438\u043d\u044b, \u0430 \u0442\u0430\u043a\u0436\u0435 \u041a\u0440\u0438\u0432\u043e\u0433\u043e \u0420\u043e\u0433\u0430\n\n\u041f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u044f \u0432 8 \u0438\u0437 10 \u0440\u0430\u0439\u043e\u043d\u043e\u0432 \u041a\u0438\u0435\u0432\u0430, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u041f\u043e\u0434\u043e\u043b\u044c\u0441\u043a\u043e\u043c, \u0414\u0435\u0441\u043d\u044f\u043d\u0441\u043a\u043e\u043c, \u0421\u0432\u044f\u0442\u043e\u0448\u0438\u043d\u0441\u043a\u043e\u043c, \u0413\u043e\u043b\u043e\u0441\u0435\u0435\u0432\u0441\u043a\u043e\u043c, \u0414\u043d\u0435\u043f\u0440\u043e\u0432\u0441\u043a\u043e\u043c, \u0421\u043e\u043b\u043e\u043c\u0435\u043d\u0441\u043a\u043e\u043c, \u0414\u0430\u0440\u043d\u0438\u0446\u043a\u043e\u043c \u0438 \u0428\u0435\u0432\u0447\u0435\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0430\u0445 \u0433\u043e\u0440\u043e\u0434\u0430. \u0412 \u0428\u0435\u0432\u0447\u0435\u043d\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u0441\u043d\u0435\u0441\u043b\u043e \u0446\u0435\u043b\u044b\u0439 \u043f\u043e\u0434\u044a\u0435\u0437\u0434 \u0436\u0438\u043b\u043e\u0433\u043e \