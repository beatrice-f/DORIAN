\u0433\u043e\u0440\u0435\u0449\u0438\u043d\u0438/\u0441\u0442\u0443\u0434\u043e\u0432\u0435 \u0441\u0435 \u0431\u043e\u0440\u044f\u0442 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0441\u0430\u043c\u043e \u0447\u0440\u0435\u0437 \u0440\u0430\u0437\u0443\u043c\u043d\u043e \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u0437\u043a\u043e\u043f\u0430\u0435\u043c\u0438 \u0433\u043e\u0440\u0438\u0432\u0430 - \u043d\u0435\u0444\u0442, \u0433\u0430\u0437, \u0432\u044a\u0433\u043b\u0438\u0449\u0430. \u0418 \u0441 \u043d\u043e\u0432\u0438 \u044f\u0434\u0440\u0435\u043d\u0438 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438. \u041d\u0435 \u0441 \u0443\u043d\u0438\u0449\u043e\u0436\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u0438\u043c! \u0418\u0434\u0435\u043e\u043b\u043e\u0433\u0438\u044f\u0442\u0430 \u043d\u0435 \u0431\u0438\u0432\u0430 \u0434\u0430 \u0438\u0437\u043c\u0435\u0441\u0442\u0432\u0430 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0442\u0435 \u0437\u0430\u043a\u043e\u043d\u0438. \u0422\u043e\u0432\u0430 \u043f\u0438\u0448\u0435 \u0432 \u0441\u0432\u043e\u044f \u0424\u0435\u0439\u0441\u0431\u0443\u043a \u043f\u0440\u043e\u0444\u0438\u043b \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u044a\u0442 \u041a\u0443\u0437\u043c\u0430\u043d \u0418\u043b\u0438\u0435\u0432. \"\u0421\u0442\u0430\u043d\u0435 \u043b\u0438 \u043d\u0430\u043f\u0435\u0447\u0435\u043d\u043e - \u0432\u043a\u043b\u044e\u0447\u0432\u0430\u043c\u0435 \u0422\u0415\u0426-\u043e\u0432\u0435\u0442\u0435 \u0434\u0430 \u0441\u043f\u0430\u0441\u044f\u0432\u0430\u0442 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e. \u041b\u0438\u0446\u0435\u043c\u0435\u0440\u0438\u0435 \u0432 \u0447\u0438\u0441\u0442 \u0432\u0438\u0434. \u041d\u0430\u0441\u0442\u0430\u043d\u0430\u0442 \u043b\u0438 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u043d\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 - \u0440\u044f\u0437\u043a\u043e \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0432\u0430\u0442 \u0432\u0441\u0438\u0447\u043a\u0438 \u0432\u044a\u0433\u043b\u0438\u0449\u043d\u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u0438, \u0432\u044a\u043f\u0440\u0435\u043a\u0438 \u0431\u0435\u0437\u0443\u043c\u043d\u0438\u0442\u0435 \u0434\u0430\u043d\u044a\u0446\u0438 (\u043a\u0432\u043e\u0442\u0438 \u0437\u0430 \u0442\u044a\u0440\u0433\u043e\u0432\u0438\u044f \u0441 \u0432\u044a\u0433\u043b\u0435\u0440\u043e\u0434\u043d\u0438 \u0435\u043c\u0438\u0441\u0438\u0438), \u0441 \u043a\u043e\u0438\u0442\u043e \u0446\u0435\u043b\u0435\u043d\u0430\u0441\u043e\u0447\u0435\u043d\u043e \u0433\u0438 \u0443\u0431\u0438\u0432\u0430\u0442. \u0412 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0443 \u043d\u0430\u0441 \u0440\u0430\u0431\u043e\u0442\u044f\u0442 9 \u0432\u044a\u0433\u043b\u0438\u0449\u043d\u0438 \u0431\u043b\u043e\u043a\u0430, \u0430\u043a\u043e \u0433\u043e \u043d\u044f\u043c\u0430\u0448\u0435 6 \u0431\u043b\u043e\u043a \u043d\u0430 \u0410\u0415\u0426-\u0430 - \u043f\u043e\u043d\u0435 \u043e\u0449\u0435 4 \u0432\u044a\u0433\u043b\u0438\u0449\u043d\u0438 \u0449\u044f\u0445\u0430 \u0434\u0430 \u0441\u0430 \u201c\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438.\u201d \u041f\u0440\u0438 \u0440\u0435\u043a\u043e\u0440\u0434\u043d\u0438 \u043c\u043e\u043c\u0435\u043d\u0442\u043d\u0438 \u0446\u0435\u043d\u0438 \u043d\u0430 \u0431\u043e\u0440\u0441\u0430\u0442\u0430 \u043e\u0442 1500 \u043b\u0432. \u043d\u0430 \u041c\u0412\u0442\u0447 - \u0442\u043e\u0432\u0430 \u0432\u0435\u0447\u0435 \u0435 \u043e\u043f\u0430\u0441\u043d\u043e \u0437\u0430 \u0446\u044f\u043b\u0430\u0442\u0430 \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u044f, \u0434\u043e\u043c\u0430\u043a\u0438\u043d\u0441\u0442\u0432\u0430 \u0438 \u0435\u043d\u0435\u0440\u0433\u0438\u0439\u043d\u0430\u0442\u0430 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u043d\u0430 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f\", \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u0432\u0430 \u043b\u0438\u0434\u0435\u0440\u044a\u0442 \u043d\u0430 \"\u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f \u043c\u043e\u0436\u0435 \u0441\u0430\u043c\u0430\". \"\u042f\u0441\u043d\u043e \u0435, \u0447\u0435 \u0438\u043c\u0430 \u043d\u0443\u0436\u0434\u0430 \u043e\u0442 \u0431\u0443\u0444\u0435\u0440\u0438, \u043a\u043e\u0438\u0442\u043e \u0434\u0430 \u0441\u043f\u0430\u0441\u044f\u0432\u0430\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0430. \u042f\u0441\u043d\u043e \u0435, \u0447\u0435 \u0431\u0435\u0437 \u0442\u044f\u0445 \u043d\u0438 \u0447\u0430\u043a\u0430\u0442 \u0430\u0432\u0430\u0440\u0438\u0438, \u0440\u0435\u0436\u0438\u043c \u043d\u0430 \u0442\u043e\u043a\u0430, \u043d\u0435\u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0430, \u043a\u0430\u043a\u0442\u043e \u0438 \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0438 \u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u044f \u043f\u0440\u0438 \u0432\u0441\u0435 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430\u0442\u0430 \u043d\u0443\u0436\u0434\u0430 \u043e\u0442 \u043d\u0435\u044f - \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0446\u0438, \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043a\u043e\u043b\u0438, \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u044f, AI\u2026\n\u0410 \u043d\u0443\u0436\u043d\u0438\u0442\u0435 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 \u0432 \u043c\u0440\u0435\u0436\u0430\u0442\u0430, \u0437\u0430 \u0434\u0430 \u043d\u0435 \u0441\u0435 \u0440\u0430\u0437\u043f\u0430\u0434\u043d\u0435 \u043f\u0440\u0438 \u043e\u0442 \u0412\u0415\u0418 \u0438\u0441\u0442\u0435\u0440\u0438\u044f\u0442\u0430, \u0441\u0435 \u043e\u0446\u0435\u04