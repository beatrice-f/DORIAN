\u0939\u093e\u0936\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0938\u094d\u0938\u0915\u0936\u0940 \u0939\u094b \u0930\u0939\u0940 \u0925\u0940. \u092f\u0939 \u0915\u0948\u0926\u093f\u092f\u094b\u0902 \u0915\u0940 \u0905\u0926\u0932\u093e\u092c\u0926\u0932\u0940 \u0915\u0940 \u092a\u094d\u0930\u0915\u093f\u092f\u093e \u0925\u0940. \u0924\u0941\u0930\u094d\u0915\u0940 \u0915\u0940 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0938\u0947 \u0939\u0941\u090f \u0915\u0948\u0926\u0940 \u0905\u0926\u0932\u093e-\u092c\u0926\u0932\u0940 \u0938\u092e\u091d\u094c\u0924\u0947 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093e, \u0928\u0949\u0930\u094d\u0935\u0947, \u091c\u0930\u094d\u092e\u0928\u0940, \u092a\u094b\u0932\u0948\u0902\u0921, \u0930\u0942\u0938, \u092c\u0947\u0932\u093e\u0930\u0942\u0938 \u0914\u0930 \u0938\u094d\u0932\u094b\u0935\u0947\u0928\u093f\u092f\u093e \u0936\u093e\u092e\u093f\u0932 \u0930\u0939\u0947. \u0930\u0942\u0938\u0940 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0917\u0941\u0930\u0941\u0935\u093e\u0930 \u0930\u093e\u0924 \u0935\u093f\u0926\u0947\u0936\u094b\u0902 \u092e\u0947\u0902 \u092c\u0902\u0926\u0940 \u0930\u0939\u0947 \u0930\u0942\u0938\u0940 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093e\u0924 \u0915\u0940. \u092a\u0941\u0924\u093f\u0928 \u0928\u0947 \u0909\u0928\u094d\u0939\u0947\u0902 \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u090f\u0902 \u0926\u0940\u0902 \u0914\u0930 \u0915\u0939\u093e \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0928\u093e\u092e\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e. \u0932\u0947\u0915\u093f\u0928 \u0907\u0928 \u0938\u092c\u092e\u0947\u0902 \u091c\u094b \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0928\u093e\u092e \u091a\u0930\u094d\u091a\u093e \u092e\u0947\u0902 \u0939\u0948. \u0935\u0939 \u0939\u0948 \u0935\u093e\u0926\u093f\u092e \u0915\u094d\u0930\u093e\u0938\u093f\u0915\u094b\u0935 \u0915\u093e, \u091c\u093f\u0938\u0947 \u0930\u0942\u0938 \u0915\u0940 \u091c\u0928\u0924\u093e \u0939\u0940\u0930\u094b \u0915\u0947 \u0924\u094c\u0930 \u092a\u0930 \u0926\u0947\u0916 \u0930\u0939\u0940 \u0939\u0948 \u0914\u0930 \u0905\u092c \u0909\u0938\u0915\u0940 \u0935\u093e\u092a\u0938\u0940 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948. \u0935\u093e\u0926\u093f\u092e \u0915\u094d\u0930\u093e\u0938\u093f\u0915\u094b\u0935 \u0915\u094b \u092d\u0932\u0947 \u0939\u0940 \u0930\u0942\u0938 \u0905\u092a\u0928\u093e \u0939\u0940\u0930\u094b \u092e\u093e\u0928\u0924\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0947 \u0930\u0942\u0938 \u0915\u093e \u0915\u0938\u093e\u0908 \u092d\u0940 \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948. \u0915\u0948\u0926\u093f\u092f\u094b\u0902 \u0915\u0940 \u0905\u0926\u0932\u093e-\u092c\u0926\u0932\u0940 \u092e\u0947\u0902 \u0930\u093f\u0939\u093e \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u092c\u0938\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0930\u0942\u0938\u0940 \u0915\u0948\u0926\u0940 \u0935\u093e\u0926\u093f\u092e \u0915\u094d\u0930\u093e\u0938\u093f\u0915\u094b\u0935 \u0939\u0940 \u0925\u0947, \u091c\u093f\u0928\u094d\u0939\u0947\u0902 2019 \u092e\u0947\u0902 \u092c\u0930\u094d\u0932\u093f\u0928 \u092e\u0947\u0902 \u092a\u0942\u0930\u094d\u0935 \u091a\u0947\u091a\u0928 \u0905\u0932\u0917\u093e\u0935\u0935\u093e\u0926\u0940 \u0928\u0947\u0924\u093e \u091c\u093c\u0947\u0932\u093f\u092e\u0916\u093e\u0928 \u0916\u093e\u0902\u0917\u094b\u0936\u0935\u093f\u0932\u0940 \u0915\u0940 \u0939\u0924\u094d\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u0930\u094d\u092e\u0928\u0940 \u092e\u0947\u0902 \u0906\u091c\u0940\u0935\u0928 \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\