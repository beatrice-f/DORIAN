3b \u043d\u0435\u0443\u0434\u044a\u0440\u0436\u0438\u043c. \u0412\u044a\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u0442\u043e \u043d\u0430 \u043f\u0440\u0435\u0442\u0440\u0443\u043f\u0430\u043d\u0430\u0442\u0430 \u0420\u0443\u0441\u0438\u044f \u0449\u0435 \u0441\u0435 \u0440\u0430\u0437\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438 \u0432 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u0435\u0441\u0435\u0442\u0438\u043b\u0435\u0442\u0438\u044f, \u0434\u043e\u043a\u043e\u0441\u0432\u0430\u0439\u043a\u0438 \u0432\u0441\u044f\u043a\u043e \u043a\u044a\u0442\u0447\u0435 \u043d\u0430 \u0437\u0435\u043c\u044f\u0442\u0430 \u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u044f\u0432\u0430\u0439\u043a\u0438 \u0445\u0430\u043e\u0441 \u043d\u0430 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430\u0442\u0430 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430. \u0422\u043e\u0432\u0430 \u043a\u0430\u0437\u0430 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u044f\u0442 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0442\u043e\u0440 \u041b\u0438\u043b\u0438\u0430\u043d \u0411\u044e\u0438\u043d\u0433\u0441, \u0441\u044a\u043e\u0431\u0449\u0430\u0432\u0430 The Telegraph. \u0421\u043f\u043e\u0440\u0435\u0434 \u043d\u0435\u044f \u0437\u0430\u0432\u0437\u0435\u043c\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u0449\u0435 \u043e\u0431\u043e\u0433\u0430\u0442\u0438 \u043d\u0435\u0438\u043c\u043e\u0432\u0435\u0440\u043d\u043e \u0420\u0443\u0441\u0438\u044f, \u0437\u0430\u0449\u043e\u0442\u043e \"\u0442\u043e\u0437\u0438 \u043d\u043e\u0432, \u043f\u043e-\u0431\u043e\u0433\u0430\u0442 \u0438 \u043f\u043e-\u043c\u043e\u0433\u044a\u0449 \u041a\u0440\u0435\u043c\u044a\u043b \u0449\u0435 \u0431\u044a\u0434\u0435 \u0434\u043e\u0431\u0440\u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0437\u0430 \u0431\u044a\u0434\u0435\u0449\u0430 \u0430\u0433\u0440\u0435\u0441\u0438\u044f \u0438 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e \u0438\u0437\u043d\u0443\u0434\u0432\u0430\u043d\u0435 \u043d\u0430 \u0417\u0430\u043f\u0430\u0434\u0430\u201c. \"\u0413\u0430\u0437\u043e\u0432\u043e\u0442\u043e \u0438\u0437\u043d\u0443\u0434\u0432\u0430\u043d\u0435 \u043d\u0430 \u0420\u0443\u0441\u0438\u044f \u0441\u043b\u0435\u0434 \u043f\u044a\u043b\u043d\u043e\u043c\u0430\u0449\u0430\u0431\u043d\u0430 \u0438\u043d\u0432\u0430\u0437\u0438\u044f \u0435 \u0434\u043e\u0431\u044a\u0440 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430 \u0442\u043e\u0432\u0430 \u043a\u0430\u043a\u0432\u043e \u0449\u0435 \u0441\u0435 \u0441\u043b\u0443\u0447\u0438, \u0430\u043a\u043e \u041f\u0443\u0442\u0438\u043d \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435 \u0441\u0432\u043e\u0435\u0442\u043e. \u0428\u043e\u043a\u043e\u0432\u0438\u0442\u0435 \u0432\u044a\u043b\u043d\u0438 \u043d\u0430 \u043f\u044a\u043b\u043d\u0438\u044f \u0440\u0443\u0441\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b \u043d\u0430\u0434 \u0423\u043a\u0440\u0430\u0439\u043d\u0430 \u043d\u044f\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0443\u0441\u0435\u0442\u044f\u0442 \u0432\u0435\u0434\u043d\u0430\u0433\u0430. \u0422\u0435 \u0449\u0435 \u0441\u0435 \u0440\u0430\u0437\u0432\u0438\u044f\u0442 \u043f\u0440\u0435\u0437 \u0433\u043e\u0434\u0438\u043d\u0438\u0442\u0435 \u0438 \u0434\u0435\u0441\u0435\u0442\u0438\u043b\u0435\u0442\u0438\u044f\u0442\u0430 , \u0434\u043e\u043a\u043e\u0441\u0432\u0430\u0439\u043a\u0438 \u0432\u0441\u044f\u043a\u043e \u043a\u044a\u0442\u0447\u0435 \u043d\u0430 \u0437\u0435\u043c\u044f\u0442\u0430 \u0438 \u0432\u043d\u0430\u0441\u044f\u0439\u043a\u0438 \u0445\u0430\u043e\u0441 \u0432 \u0441\u0432\u0435\u0442\u043e\u0432\u043d\u0430\u0442\u0430 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430\u201c, \u043f\u0438\u0448\u0435 \u0430\u0432\u0442\u043e\u0440\u044a\u0442. \"\u0426\u044f\u043b\u043e\u0442\u043e \u0437\u044a\u0440\u043d\u043e, \u0441\u044a\u0431\u0440\u0430\u043d\u043e \u043e\u0442 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0442\u0435 \u0437\u0435\u043c\u0435\u0434\u0435\u043b\u0446\u0438 \u0438 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0437\u0430 \u0438\u0437\u043f\u0440\u0430\u0449\u0430\u043d\u0435 \u043e\u0442 \u0442\u0435\u0437\u0438 \u043f\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0449\u0430, \u0441\u0435\u0433\u0430 \u0449\u0435\u0448\u0435 \u0434\u0430 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438 \u043d\u0430 \u0420\u0443\u0441\u0438\u044f \u0437\u0430 \u0441\u0435\u0431\u0435 \u0441\u0438 \u0438\u043b\u0438 \u0434\u0430 \u0433\u043e \u0438\u0437\u043f\u0440\u0430\u0442\u0438 \u043d\u0430 \u0441\u0432\u043e\u0438\u0442\u0435 \u0441\u044a\u044e\u0437\u043d\u0438\u0446\u0438 \u0441\u0432\u0435\u0442\u0430\u201c, \u0441\u0435 \u043f\u043e\u0441\u043e\u0447\u0432\u0430 \u043e\u0449\u0435 \u0432 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430. \"\u0412\u0441\u0438\u0447\u043a\u043e \u0442\u043e\u0432\u0430 \u0431\u0438 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u043b\u043e \u043d\u0430 \u0420\u0443\u0441\u0438\u044f \u2013 \u043a\u043e\u044f\u0442\u043e, \u043e\u0442\u043a\u0430\u043a\u0442\u043e \u043f\u0440\u0435\u0432\u0437\u0435 \u0423\u043a\u0440\u0430\u0439\u043d\u0430, \u0441\u0442\u043e\u0438 \u0431\u0443\u043a\u0432\u0430\u043b\u043d\u043e \u043f\u0440\u0435\u0434 \u043f\u043e\u0440\u0442\u0438\u0442\u0435 \u043d\u0430 \u0415\u0421. \u0420\u0443\u0441\u0438\u044f \u0438 \u043d\u0435\u0439\u043d\u0438\u0442\u0435 \u043f\u0440\u0438\u044f\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442 \u043e\u0440\u044a\u0436\u0438\u044f \u0438 \u0447\u0430\u0441\u0442\u0438 \u043e\u0442 \u0442\u044f\u0445 \u043d\u0430 \u043d\u0435\u0447\u0435\u0441\u0442\u043d\u0438 \u0445\u043e\u0440\u0430 \u043f\u043e \u0441\u043