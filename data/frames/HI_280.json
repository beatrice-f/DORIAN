92c \u092c\u0940\u0924\u0947 \u0926\u094b \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0928\u0947 \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0926\u094b\u0928\u094b\u0902 \u0926\u0947\u0936\u094b\u0902 \u0915\u093e \u0926\u094c\u0930\u093e \u0915\u093f\u092f\u093e \u0925\u093e. \u0910\u0938\u0947 \u092e\u0947\u0902 \u0921\u094b\u092d\u093e\u0932 \u0914\u0930 \u092a\u0941\u0924\u093f\u0928 \u0915\u0940 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u092a\u0930 \u0938\u092c\u0915\u0940 \u0928\u091c\u093c\u0930\u0947\u0902 \u0925\u0940\u0902. \u0930\u0942\u0938 \u0915\u0940 \u0928\u094d\u092f\u0942\u091c\u093c \u090f\u091c\u0947\u0902\u0938\u0940 '\u0938\u094d\u092a\u0942\u0924\u0928\u093f\u0915' \u0915\u0947 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u0939\u0948\u0902\u0921\u0932\u094d\u0938 \u0938\u0947 \u0907\u0938 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u0915\u093e \u0935\u0940\u0921\u093f\u092f\u094b \u091c\u093e\u0930\u0940 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0932\u093f\u0916\u093e \u0917\u092f\u093e- \u0921\u094b\u092d\u093e\u0932 \u0928\u0947 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u0915\u0940 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092a\u0941\u0924\u093f\u0928 \u0915\u094b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0940. \u0921\u094b\u092d\u093e\u0932 \u0928\u0947 \u092a\u0941\u0924\u093f\u0928 \u0915\u094b \u092c\u0924\u093e\u092f\u093e \u0915\u094d\u092f\u093e\n\u0921\u094b\u092d\u093e\u0932 \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0915\u0939 \u0930\u0939\u0947 \u0939\u0948\u0902, ''\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u092e\u094b\u0926\u0940 \u0928\u0947 \u091c\u0948\u0938\u093e \u0915\u093f \u0906\u092a\u0915\u094b \u092b\u093c\u094b\u0928 \u092a\u0930 \u0939\u0941\u0908 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u094b \u0906\u092a\u0915\u094b \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u0926\u094c\u0930\u0947 \u0914\u0930 \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0938\u0947 \u092e\u0941\u0932\u093e\u0915\u093c\u093e\u0924 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902. \u092a\u0940\u090f\u092e \u092e\u094b\u0926\u0940 \u091a\u093e\u0939\u0924\u0947 \u0925\u0947 \u0915\u093f \u092e\u0948\u0902 \u0916\u093c\u093e\u0938 \u0924\u094c\u0930 \u092a\u0930 \u092f\u0939\u093e\u0902 \u0906\u090a\u0902 \u0914\u0930 \u0906\u092a\u0915\u094b \u0909\u0938 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092e\u093f\u0932\u0915\u0930 \u092c\u0924\u093e\u090a\u0902.'' \u0921\u094b\u092d\u093e\u0932 \u0928\u0947 \u0915\u0939\u093e, ''\u092c\u093e\u0924\u091a\u0940\u0924 \u092c\u0902\u0926 \u0926\u0930\u0935\u093e\u091c\u093c\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0939\u0941\u0908. \u0938\u093f\u0930\u094d\u092b\u093c \u0926\u094b\u0928\u094b\u0902 \u0928\u0947\u0924\u093e \u0925\u0947. \u0909\u0928\u0915\u0947 \u0938\u093e\u0925 \u0926\u094b \u0932\u094b\u0917 \u0925\u0947. \u092e\u0948\u0902 \u092d\u0940 \u0935\u0939\u093e\u0902 \u092a\u0940\u090f\u092e \u0915\u0947 \u0938\u093e\u0925 \u0925\u093e. \u0909\u0938 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u093e \u0938\u093e\u0915\u094d\u0937\u0940 \u092e\u0948\u0902 \u092d\u0940 \u0930\u0939\u093e.'' \u0906\u0930\u091f\u0940 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915\u093c, \u0935\u094d\u0932\u093e\u0926\u093f\u092e\u0940\u0930 \u092a\u0941\u0924\u093f\u0928 