93e\u0935 \u0921\u093e\u0932\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u094b \u0905\u092a\u0928\u0947 \u0907\u0932\u093e\u0915\u093c\u0947 \u0930\u0942\u0938 \u0915\u094b \u0938\u094c\u0902\u092a \u0926\u0947. \u0928\u094d\u092f\u0942\u092f\u0949\u0930\u094d\u0915 \u092e\u0947\u0902 \u0938\u093f\u0924\u0902\u092c\u0930 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u091f\u094d\u0930\u0902\u092a \u0928\u0947 \u090f\u0915 \u092a\u094d\u0930\u0947\u0938 \u0915\u0949\u0928\u094d\u092b\u094d\u0930\u0947\u0902\u0938 \u092e\u0947\u0902 \u0915\u0939\u093e \u0925\u093e, ''\u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092e\u0948\u0902 \u092a\u0941\u0924\u093f\u0928 \u0914\u0930 \u091c\u093c\u0947\u0932\u0947\u0902\u0938\u094d\u0915\u0940 \u0915\u0947 \u092c\u0940\u091a \u0915\u093e\u092b\u093c\u0940 \u091c\u0932\u094d\u0926\u0940 \u0938\u092e\u091d\u094c\u0924\u093e \u0915\u0930\u093e \u0938\u0915\u0924\u093e \u0939\u0942\u0902.'' \u091f\u094d\u0930\u0902\u092a \u0905\u0915\u094d\u0938\u0930 \u0905\u092a\u0928\u0940 \u0907\u0938 \u092f\u094b\u091c\u0928\u093e \u0915\u093e \u091c\u093c\u093f\u0915\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928 \u0910\u0938\u093e \u0935\u094b \u0915\u0948\u0938\u0947 \u0915\u0930\u093e\u090f\u0902\u0917\u0947 \u092f\u0947 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u0947. \u091f\u094d\u0930\u0902\u092a \u0928\u0947 \u0930\u0942\u0938 \u0914\u0930 \u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092f\u0941\u0926\u094d\u0927 \u0938\u0947 \u092a\u0948\u0926\u093e \u0939\u093e\u0932\u093e\u0924 \u0915\u093e \u091c\u093c\u093f\u0915\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0915\u0939\u093e \u0925\u093e, ''\u092f\u0942\u0915\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u091c\u094b \u0939\u094b \u0930\u0939\u093e \u0939\u0948 \u0935\u094b \u0936\u0930\u094d\u092e \u0915\u0940 \u092c\u093e\u0924 \u0939\u0948. \u0935\u0939\u093e\u0902 \u0907\u0924\u0928\u0940 \u092e\u094c\u0924\u0947\u0902 \u0939\u0941\u0908 \u0939\u0948\u0902. \u0907\u0924\u0928\u093e \u0935\u093f\u0927\u094d\u0935\u0902\u0938 \u0939\u0941\u0906 \u0939\u0948. \u092f\u0939 \u092d\u092f\u093e\u0935\u0939 \u0939\u0948.'' ''\u092f\u0947 \u092c\u0947\u0939\u0926 \u0921\u0930\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u091a\u0940\u091c\u093c \u0939\u0948 \u0914\u0930 \u0906\u092a \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u094b \u092a\u0948\u0938\u0947 \u0917\u0902\u0935\u093e\u0928\u0947 \u092a\u0921\u093c \u0930\u0939\u0947 \u0939\u0948\u0902.'' \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u092a\u0942\u0930\u094d\u0935\u0940 \u092f\u0942\u0930\u094b\u092a\u0940\u092f \u092e\u0942\u0932 \u0915\u0947 \u0938\u092d\u0940 \u092f\u0942\u0915\u094d\u0930\u0947\u0928\u0940 \u0932\u094b\u0917 \u0921\u0947\u092e\u094b\u0915\u094d\u0930\u0947\u091f\u093f\u0915 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902. \u092a\u094b\u0932\u093f\u0936-\u092f\u0942\u0930\u094b\u092a\u093f\u092f\u0928 \u0938\u092e\u0941\u0926\u093e\u092f \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u090f\u0915 \u0938\u092e\u0942\u0939 \u0915\u0947 \u0938\u0926\u0938\u094d\u092f \u091f\u093f\u092e\u094b\u0925\u0940 \u0915\u0941\u091c\u093c\u092e\u093e \u0915\u0939\u0924\u0947 \u0939\u0948\u0902, ''\u0915\u0908 \u092a\u094b\u0932\u093f\u0936 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092a\u0939\u0932\u0947 \u091f\u094d\u0930\u0902\u092a \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0935\u094b \u092d\u0940 \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u